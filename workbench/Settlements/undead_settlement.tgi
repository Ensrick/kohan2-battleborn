
/* 	WALL SETS		*/

[WallSet Template=WallSet]
{
	ids = undead_wallset_01
	name = "#undead_settlement_undead_wallset_01_name"

	wall_segment_ids = undead_wall_01
	wall_corner_ids = undead_tower_01
	gate_ids = undead_gate_01
}

