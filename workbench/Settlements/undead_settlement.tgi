	[View]
	{
		[WhenCreated Template=FXC_CreateVFX]
		vfx_ids = undead_gate_placeholder_vfx
	}
}

/* 	SETTLEMENT		*/

[Thing Template=K2Settlement]
{
	ids = undead_settlement
	name = "#undead_settlement_Thing_name"

	[PropertiesComponent]
	{
		[Property]
		property_IDS = settlement
		
		[Property]
		property_IDS = settlement_undead
		
		[Property]
		property_IDS = settlement_notshadow

		[Property]
		property_IDS = evil
	}

	[SettlementComponent]
	{
		default_layout_ids = company_standard

		[AvailableStructures]
		{
			[Structure]
			structure_ids = undead_quarry
		
			[Structure]
			structure_ids = undead_woodmill
			
			[Structure]
			structure_ids = undead_blacksmith
			
			[Structure]
			structure_ids = undead_market

			[Structure]
			structure_ids = undead_barracks
			
			[Structure]
			structure_ids = undead_shrine
			
			[Structure]
			structure_ids = undead_library
			
			[Structure]
			structure_ids = undead_manafocus
		}

		[Placeholders]
		{
			wall_segment_placeholder_ids = undead_wall_placeholder
			wall_corner_placeholder_ids = undead_corner_placeholder
			gate_placeholder_ids = undead_gate_placeholder
		}

		[Levels]
		{
			[Level]
			max_structures = 7
			settlement_center_ids = undead_center_village
			wallset_ids = undead_wallset_01

			[Level]
			max_structures = 7
			settlement_center_ids = undead_center_town
			wallset_ids = undead_wallset_01
			
			[Level]
			max_structures = 7
			settlement_center_ids = undead_center_city
			wallset_ids = undead_wallset_02

			[Level]
			max_structures = 7
			settlement_center_ids = undead_center_citadel
			wallset_ids = undead_wallset_03
		}

		[Shape]
		wall_diameter = 42
		num_wall_sides = 5
		num_wall_gates = 5

		[StructureLayouts]
		{
			[Layout]
			layout_ids = undead_layout_01
			
			[Layout]
			layout_ids = undead_layout_02
			
			[Layout]
			layout_ids = undead_layout_03
			
			[Layout]
			layout_ids = undead_layout_04
		}
	}
}
