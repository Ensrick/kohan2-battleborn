/* 	WALL PLACEHOLDERS		*/

[Thing Template=VFXProjectedTexture]
{
	ids = undead_wall_placeholder_vfx
	name = "#undead_settlement_undead_wall_placeholder_vfx_name"

	texture = /Effects/Decals/Undead/UndeadWallVillageDecal.dds
	attached_scale = 0
	texture_size = 6

	decal_fade_time = 5, 5
}

[Thing Template=K2WallPlaceholder]
{
	IDS = undead_wall_placeholder
	name = "#undead_settlement_undead_wall_placeholder_name"
	
	[View]
	{
		[WhenCreated Template=FXC_CreateVFX]
		vfx_ids = undead_wall_placeholder_vfx
	}
}

[Thing Template=VFXProjectedTexture]
{
	ids = undead_corner_placeholder_vfx
	name = "#undead_settlement_undead_corner_placeholder_vfx_name"

	texture = /Effects/Decals/Undead/UndeadCornerVillageDecal.dds
	attached_scale = 0
	texture_size = 6

	decal_fade_time = 5, 5
}

[Thing Template=K2WallPlaceholder]
{
	IDS = undead_corner_placeholder
	name = "#undead_settlement_undead_corner_placeholder_name"

	[View]
	{
		[WhenCreated Template=FXC_CreateVFX]
		vfx_ids = undead_corner_placeholder_vfx
	}
}

[Thing Template=VFXProjectedTexture]
{
	ids = undead_gate_placeholder_vfx
	name = "#undead_settlement_undead_gate_placeholder_vfx_name"

	texture = /Effects/Decals/Undead/UndeadGateVillageDecal.dds
	attached_scale = 0
	texture_size = 6

	decal_fade_time = 5, 5
}

[Thing Template=K2WallPlaceholder]
{
	IDS = undead_gate_placeholder
