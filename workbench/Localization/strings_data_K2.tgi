	campaign_k2_name = "Kings of War Campaign"
	campaign_k2_Mission_name = "Chapter 1 : The Hunters"
	campaign_k2_Mission_name_2 = "Mission 1 : The Borderlands"
	campaign_k2_Mission_debriefing_success = "With Jhadan saved, Naava has combined her forces with Ghalen's, giving her the strength she needs to strike back."
	campaign_k2_Mission_name_3 = "Mission 2 : Reprisal"
	campaign_k2_Mission_debriefing_success_2 = "The raider armies are crushed and the Borderlands are safe, for now.  However, all evidence points to Ceyah involvement and where the Ceyah work, nothing ever stays safe for long.  The hunt must continue."
	campaign_k2_Mission_name_4 = "Mission 3 : Complications"
	campaign_k2_Mission_debriefing_success_3 = "The location of the Ceyah leaders has been uncovered.  By winning the support of King Agborus and his Gauri, the hunters can now lay a snare from which the Ceyah will never escape."
	campaign_k2_Mission_name_5 = "Mission 4 : Closing Fist"
	campaign_k2_Mission_debriefing_success_4 = "With stone and iron, the Ceyah forces have been driven back and surrounded.  Now, all that remains is to tighten the noose and end the Ceyah threat once and for all."
	campaign_k2_Mission_name_6 = "Mission 5 : The Hammer Falls"
	campaign_k2_Mission_debriefing_success_5 = "The last Ceyah army is beaten, the last fortress taken.  Nothing remains but capture and cleansing for their leaders."
	campaign_k2_Mission_name_7 = "Chapter 2 : The Hunted"
	campaign_k2_Mission_name_8 = "Mission 6 : Slipping the Noose"
	campaign_k2_Mission_debriefing_success_6 = "Through dark arts and darker cunning, Melchior has led the Ceyah survivors through Naava's forces and into the Waste."
	campaign_k2_Mission_name_9 = "Mission 7 : The Blood of Dragons"
	campaign_k2_Mission_debriefing_success_7 = "The dragon-god Sakaar has been slain, and with its blood, Sebak has begun raising an army of the Undead.  Soon, the Ceyah will once more be a force to be reckoned with."
	campaign_k2_Mission_name_10 = "Mission 8 : Like Crows to a Corpse"
	campaign_k2_Mission_debriefing_success_8 = "The remnants of the Drauga tribes have been purged, and with their corpses, the Undead army has grown enormous in size.  Now nothing can stop the Ceyah from reaching Sebak's vision to the east."
	campaign_k2_Mission_name_11 = "Mission 9 : The Guardians"
	campaign_k2_Mission_debriefing_success_9 = "All that stood before the Ceyah have been slain, and and the powers of the Well of Shadow have fulfilled Sebak's prophecy, transforming him into the monstrous Abaddon.  Now, with the might of the Shadow, he will bring an end to Khaldun."
	campaign_k2_Mission_name_12 = "Mission 10 : Shadow's Gift"
	campaign_k2_Mission_debriefing_success_10 = "The forces of Light have been driven from the field of battle, and their commanders are captured, killed, or put to flight.  The lands of Istira are open for conquest and desolation."
	campaign_k2_Mission_name_13 = "Chapter 3 : The Shadow Rises"
	campaign_k2_Mission_name_14 = "Mission 11 : Let Them Come"
	campaign_k2_Mission_debriefing_success_11 = "With the help of Jonas Teramun, the mortal king, Xander Kharei, has driven back his cousin's forces, and is now ready to press for a final battle for rule of Elagor."
	campaign_k2_Mission_name_15 = "Mission 12 : A Sharp Rejoinder"
	campaign_k2_Mission_debriefing_success_12 = "The Undead are beaten, and Elagor is united at last.  But tidings from beyond have darkened the victory, and warning must be brought to the Council before it is too late."
	campaign_k2_Mission_name_16 = "Mission 13 : Into The Storm"
	campaign_k2_Mission_debriefing_success_13 = "Channak has been saved from the Undead legions of the Fallen, and an alliance unseen for Ages has been forged.  Now the three Kohan must hasten to battle, before another land is lost to the Fallen."
	campaign_k2_Mission_name_17 = "Mission 14 : A Rock and a Hard Place"
	campaign_k2_Mission_debriefing_success_14 = "The Council has ridden to war and won the first great victory over the Fallen."
	campaign_k2_Mission_name_18 = "Chapter 4 : Into the Darkness"
	campaign_k2_Mission_name_19 = "Mission 15 : Homecoming"
	campaign_k2_Mission_debriefing_success_15 = "Though the way forward is clear, the voice of some ancient power has called Naava away, leading her deeper in the lands controlled by the Fallen."
	campaign_k2_Mission_name_20 = "Mission 16 : The Lonely Cry"
	campaign_k2_Mission_debriefing_success_16 = "Durash is slain and another Fallen army has been defeated, but the warnings of the Guardian Ord make the victory almost meaningless.  Now, Naava, Melchior, and Jonas must race to find the Drauga and reach Darius Javidan."
	campaign_k2_Mission_name_21 = "Mission 17 : Embers in the Waste"
	campaign_k2_Mission_debriefing_success_17 = "The Drauga have risen from their defeat and rejoined the alliance of the Light, pledging their support to Naava.  Now, the army must cut its way out of the Waste."
	campaign_k2_Mission_name_22 = "Mission 18 : Rise! Drauga Rise!"
	campaign_k2_Mission_debriefing_success_18 = "Once more, the Undead have been defeated.  The citadel of Dar Barat awaits."
	campaign_k2_Mission_name_23 = "Mission 19 : The Breaking Point"
	campaign_k2_Mission_debriefing_success_19 = "Dar Barat has been razed and the twisted spirit of Sofiya Fairfax has been laid to rest.  Unfortunately, the alliance of heroes has unraveled and Jonas is now lost to his companions."
	campaign_k2_Mission_name_24 = "Mission 20 : The Past Lives Within"
	campaign_k2_Mission_debriefing_success_20 = "Melchior has tracked Jonas to the place of Sijansur's fall, and now must confront his former ally."
	campaign_k2_Mission_name_25 = "Chapter 5 : The Last Light"
	campaign_k2_Mission_name_26 = "Mission 21 : In the Hands of Darkness"
	campaign_k2_Mission_debriefing_success_21 = "With Naava's rescue, the disastrous aftermath of Melchior's revelation has been undone.  At last, the mission has reached its end, and Darius Javidan may be warned of Khaldun's impending doom."
	campaign_k2_Mission_name_27 = "Mission 22 : The Veteran"
	campaign_k2_Mission_debriefing_success_22 = "Abaddon has been beaten and driven back to the Waste.  Now the time has come for the forces of Light to press the offensive.  Jonas, Naava, and Melchior must open a second front to enable Darius and Roxanna to reach to Well of Shadow."
	campaign_k2_Mission_name_28 = "Mission 23 : A Shred of Hope"
	campaign_k2_Mission_debriefing_success_23 = "All the allies won in the course of the war against the Fallen have joined together and defeated the massive Undead horde.  Their course now leads north, to join Darius in Abbadon's destruction."
	campaign_k2_Mission_name_29 = "Mission 24 : Twilight"
	campaign_k2_Mission_debriefing_success_24 = "Cut off from Darius's army, the burden has fallen to Jonas and the Council survivors to close the Well of Shadow and save Khaldun.  The hour of reckoning is at hand."
	campaign_k2_Mission_name_30 = "Mission 25 : The Deepest Shadow"
	campaign_k2_Mission_debriefing_success_25 = "Though the cost was immeasurable, the Well of Shadow is closed.  The sacrifice of the thousands lost in the battle against the Fallen has won peace and safety for all Khaldun."
	tutorial_k2_name = "Kings of War Tutorial"
