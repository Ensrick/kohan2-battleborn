	speech_chapter1_k2_narrator_ch1_name = "Chapter 1 Narration"
	speech_chapter1_k2_Subtitle_Text = "There is no rest for those who cannot die.  Even with the defeat of the Dark Lord Ahriman and the scattering of his servants, the Ceyah, the drums of war still beat, softer now, but growing.  Whispers of war have reached Sofiya Fairfax, Regent of Istira.  An unknown force is attacking the borderlands; sacking towns, burning outposts, and taking her people.  Ever vigilant, the Regent has dispatched her finest Seeker to investigate these attacks.  For if, as the Regent suspects, a resurgent Ceyah is behind these attacks, this could herald the dawn of a new war..."
	speech_chapter1_k2_M1C1L01_Human_name = "M1C1L01_Human"
	speech_chapter1_k2_Subtitle_Text_2 = "Who goes there!"
	speech_chapter1_k2_M1C1L02_Naava_name = "M1C1L02_Naava"
	speech_chapter1_k2_Subtitle_Text_3 = "I am a Seeker dispatched by Sofia Fairfax, Regent of Istira...  What has happened here?"
	speech_chapter1_k2_M1C1L03_Human_name = "M1C1L03_Human"
	speech_chapter1_k2_Subtitle_Text_4 = "Disaster, milady.  Our homes have been razed, our crops burnt, and our livestock slaughtered.  The enemy lays siege to Jhadan even now, and Lord Ghalen is trapped within."
	speech_chapter1_k2_M1C1L04_Naava_name = "M1C1L04_Naava"
	speech_chapter1_k2_Subtitle_Text_5 = "Jhadan besieged?  Ready yourselves, we ride to Jhadan!"
	speech_chapter1_k2_M1C2L01_Ghalen_name = "M1C2L01_Ghalen"
	speech_chapter1_k2_Subtitle_Text_6 = "My thanks, Naava.  Your aid comes when we need it most.  But I fear our troubles have only just begun."
	speech_chapter1_k2_M1C2L02_Naava_name = "M1C2L02_Naava"
	speech_chapter1_k2_Subtitle_Text_7 = "I never expected to find my old comrade avoiding the field of battle."
	speech_chapter1_k2_M1C2L03_Ghalen_name = "M1C2L03_Ghalen"
	speech_chapter1_k2_Subtitle_Text_8 = "Our enemies are no mere bandits Naava, and I dared not risk Jhadan.  The Ceyah hand in this is plain.  Surely that is why the Regent sends her Seeker?"
	speech_chapter1_k2_M1C2L04_Naava_name = "M1C2L04_Naava"
	speech_chapter1_k2_Subtitle_Text_9 = "Such is her worry.  We shall soon know the truth."
	speech_chapter1_k2_M2C1L01_Naava_name = "M2C1L01_Naava"
	speech_chapter1_k2_Subtitle_Text_10 = "My countrymen, our enemies grow bold.  I know that many of your fathers fought in the Great War, and all who lived in those dark days, Kohan and mortal, were called to arms.  Now battle calls us forth once more!  Let us end it here and now!"
	speech_chapter1_k2_M2C2L01_Ghalen_name = "M2C2L01_Ghalen"
	speech_chapter1_k2_Subtitle_Text_11 = "It is done.  The enemy is beaten."
	speech_chapter1_k2_M2C2L02_Naava_name = "M2C2L02_Naava"
	speech_chapter1_k2_Subtitle_Text_12 = "The enemy has only been driven from these lands, not defeated.  In the Regent's name I must see this through."
	speech_chapter1_k2_M2C2L03_Ghalen_name = "M2C2L03_Ghalen"
	speech_chapter1_k2_Subtitle_Text_13 = "My sword and the swords of my men are yours to command, Naava."
	speech_chapter1_k2_M2C2L04_Naava_name = "M2C2L04_Naava"
	speech_chapter1_k2_Subtitle_Text_14 = "Your sword has always been welcome, Ghalen."
	speech_chapter1_k2_M2C2L05_Ghalen_name = "M2C2L05_Ghalen"
	speech_chapter1_k2_Subtitle_Text_15 = "There were rumors of a man with a face of iron who left for the east..."
	speech_chapter1_k2_M2C2L06_Naava_name = "M2C2L06_Naava"
	speech_chapter1_k2_Subtitle_Text_16 = "Melchior.  He escaped me once before, but by the Light he will not do so again.  Tomorrow, we make for the High Reaches."
	speech_chapter1_k2_M3C1L01_Dhavrum_name = "M3C1L01_Dhavrum"
	speech_chapter1_k2_Subtitle_Text_17 = "Who enters our lands armed for war?"
	speech_chapter1_k2_M3C1L02_Naava_name = "M3C1L02_Naava"
	speech_chapter1_k2_Subtitle_Text_18 = "I am Naava Daishan, Seeker of the Regent of Istira."
	speech_chapter1_k2_M3C1L03_Dhavrum_name = "M3C1L03_Dhavrum"
	speech_chapter1_k2_Subtitle_Text_19 = "What business does a Seeker have in the High Reaches?"
	speech_chapter1_k2_M3C1L04_Naava_name = "M3C1L04_Naava"
	speech_chapter1_k2_Subtitle_Text_20 = "I am hunting the Ceyah Melchior.  How is it that King Agborus permits Ceyah vermin in his lands? "
	speech_chapter1_k2_M3C1L05_Dhavrum_name = "M3C1L05_Dhavrum"
	speech_chapter1_k2_Subtitle_Text_21 = "The Dark Ones have poisoned the minds of many Gauri.  There was an uprising in Channak, and many of our people were slain.  The messengers we sent to the Council were slaughtered en route.  King Agborus has no heart for war against his own people, and so I am forbidden to punish the traitors!"
	speech_chapter1_k2_M3C1L06_Naava_name = "M3C1L06_Naava"
	speech_chapter1_k2_Subtitle_Text_22 = "Dhavrum, I believe that we have common cause.  Let us help each other.  We will attack, and you shall defend."
	speech_chapter1_k2_M3C1L07_Ghalen_name = "M3C1L07_Ghalen"
	speech_chapter1_k2_Subtitle_Text_23 = "Naava, I would not fight Gauri in the mountains."
	speech_chapter1_k2_M3C1L08_Naava_name = "M3C1L08_Naava"
	speech_chapter1_k2_Subtitle_Text_24 = "There is no choice.  The Ceyah must be destroyed, no matter who serves them and where they dwell.  May the Creator grant us victory."
	speech_chapter1_k2_M3C2L01_Agborus_name = "M3C2L01_Agborus"
	speech_chapter1_k2_Subtitle_Text_25 = "What brings the armies of Istira to the High Reaches?"
	speech_chapter1_k2_M3C2L02_Naava_name = "M3C2L02_Naava"
	speech_chapter1_k2_Subtitle_Text_26 = "I hunt..."
	speech_chapter1_k2_M3C2L03_Agborus_name = "M3C2L03_Agborus"
	speech_chapter1_k2_Subtitle_Text_27 = "The Ceyah.  I know they are here.  But I have seen these canyons run with the blood of my people already, Seeker.  Why should I let you spill more?"
	speech_chapter1_k2_M3C2L04_Dhavrum_name = "M3C2L04_Dhavrum"
	speech_chapter1_k2_Subtitle_Text_28 = "My liege, Naava and her companions aided us in freeing the towns that had fallen prey to the Dark Ones."
	speech_chapter1_k2_M3C2L05_Naava_name = "M3C2L05_Naava"
	speech_chapter1_k2_Subtitle_Text_29 = "Noble king, we knew nothing of your troubles, and I am sorry for them.  But our aim here is yours: the Ceyah must be purged."
	speech_chapter1_k2_M3C2L06_Agborus_name = "M3C2L06_Agborus"
	speech_chapter1_k2_Subtitle_Text_30 = "In this, you are correct.  Take Dhavrum and his warriors.  We only know that the Ceyah came from some leagues north of here."
	speech_chapter1_k2_M3C2L07_Naava_name = "M3C2L07_Naava"
	speech_chapter1_k2_Subtitle_Text_31 = "My thanks, King Agborus."
	speech_chapter1_k2_M4C1L01_Dhavrum_name = "M4C1L01_Dhavrum"
	speech_chapter1_k2_Subtitle_Text_32 = "You think in terms of stone and canyons, Naava Daishan.  You must have some Gauri blood in you."
	speech_chapter1_k2_M4C1L02_Ghalen_name = "M4C1L02_Ghalen"
	speech_chapter1_k2_Subtitle_Text_33 = "For myself, I would rather this be settled by cold steel."
	speech_chapter1_k2_M4C1L03_Naava_name = "M4C1L03_Naava"
	speech_chapter1_k2_Subtitle_Text_34 = "Patience, Ghalen.  When our fortifications are complete, the Ceyah will have nowhere to go."
	speech_chapter1_k2_M4C1L04_Dhavrum_name = "M4C1L04_Dhavrum"
	speech_chapter1_k2_Subtitle_Text_35 = "A cornered animal fights most fiercely..."
	speech_chapter1_k2_M4C1L05_Naava_name = "M4C1L05_Naava"
	speech_chapter1_k2_Subtitle_Text_36 = "But seldom escapes the hunter."
	speech_chapter1_k2_M4C2L01_Ghalen_name = "M4C2L01_Ghalen"
	speech_chapter1_k2_Subtitle_Text_37 = "The Ceyah are massing to the south.  They must mean to fight their way through."
	speech_chapter1_k2_M4C2L02_Naava_name = "M4C2L02_Naava"
	speech_chapter1_k2_Subtitle_Text_38 = "Let them come... you will have your battle, Ghalen."
	speech_chapter1_k2_M4C3L01_Dhavrum_name = "M4C3L01_Dhavrum"
	speech_chapter1_k2_Subtitle_Text_39 = "With the battle won, our masons were able to complete the other fortresses."
	speech_chapter1_k2_M4C3L02_Naava_name = "M4C3L02_Naava"
	speech_chapter1_k2_Subtitle_Text_40 = "Gauri stonework has ever impressed me."
	speech_chapter1_k2_M4C3L03_Dhavrum_name = "M4C3L03_Dhavrum"
	speech_chapter1_k2_Subtitle_Text_41 = "The stone speaks to us, and we listen.  It is only a matter of patience."
	speech_chapter1_k2_M4C3L04_Naava_name = "M4C3L04_Naava"
	speech_chapter1_k2_Subtitle_Text_42 = "Patience is a luxury we cannot afford.  We must press the attack before they regroup."
	speech_chapter1_k2_M5C1L01_Dhavrum_name = "M5C1L01_Dhavrum"
	speech_chapter1_k2_Subtitle_Text_43 = "The Ceyah have fortified an abandoned citadel north of here."
	speech_chapter1_k2_M5C1L02_Ghalen_name = "M5C1L02_Ghalen"
	speech_chapter1_k2_Subtitle_Text_44 = "At last I will repay these butchers for their work in the borderlands."
	speech_chapter1_k2_M5C1L03_Naava_name = "M5C1L03_Naava"
	speech_chapter1_k2_Subtitle_Text_45 = "The trail of blood that leads to the Ceyah is centuries long. Yours is not the only revenge, Ghalen.  Ages of treachery cry out for justice."
	speech_chapter1_k2_M5CAL01_Naava_name = "M5C1.5L01_Naava"
	speech_chapter1_k2_Subtitle_Text_46 = "There is a Ceyah army dug in to the northeast.  We should destroy it before proceeding.  We cannot afford to be flanked while assaulting the keep."
	speech_chapter1_k2_M5C2L01_Dhavrum_name = "M5C2L01_Dhavrum"
	speech_chapter1_k2_Subtitle_Text_47 = "At last, the mountains are free of the Ceyah!"
	speech_chapter1_k2_M5C2L02_Naava_name = "M5C2L02_Naava"
	speech_chapter1_k2_Subtitle_Text_48 = "Not yet, Dhavrum.  The heart of the evil awaits, cowering nearby.  I can sense their foul presence."
	speech_chapter1_k2_M5C2L03_Ghalen_name = "M5C2L03_Ghalen"
	speech_chapter1_k2_Subtitle_Text_49 = "Then let us put an end to it."
	speech_chapter2_k2_CH2L01_Naava_name = "CH2L01_Naava"
	speech_chapter2_k2_Subtitle_Text = "Where are Melchior and the others?"
	speech_chapter2_k2_CH2L02_Praxus_name = "CH2L02_Praxus"
	speech_chapter2_k2_Subtitle_Text_2 = "Sebak foresaw your coming and led them from here.  The Shadow speaks to him."
	speech_chapter2_k2_CH2L03_Naava_name = "CH2L03_Naava"
	speech_chapter2_k2_Subtitle_Text_3 = "Where have they gone, Praxus?"
	speech_chapter2_k2_CH2L04_Praxus_name = "CH2L04_Praxus"
	speech_chapter2_k2_Subtitle_Text_4 = "Sebak led them into the Waste, with Melchior blazing the trail for them."
	speech_chapter2_k2_CH2L05_Naava_name = "CH2L05_Naava"
	speech_chapter2_k2_Subtitle_Text_5 = "The Waste?  There is nothing but death to be found there."
	speech_chapter2_k2_CH2L06_Ghalen_name = "CH2L06_Ghalen"
	speech_chapter2_k2_Subtitle_Text_6 = "He lies.  Sebak would have to be mad to enter the Waste.  I'll carve the truth out from him."
	speech_chapter2_k2_CH2L07_Ghalen_name = "CH2L07_Ghalen"
	speech_chapter2_k2_Subtitle_Text_7 = "Look out!"
	speech_chapter2_k2_CH2L09_Naava_name = "CH2L09_Naava"
	speech_chapter2_k2_Subtitle_Text_8 = "He spoke the truth, his spirit cannot lie.  Sebak leads them into the Waste.  Dhavrum, Ghalen... I will see this to the end. Whatever the cost, I will not turn aside."
	speech_chapter2_k2_CH2L11_Naava_name = "CH2L11_Naava"
	speech_chapter2_k2_Subtitle_Text_9 = "Dhavrum, your home is safe.  Your work is done..."
	speech_chapter2_k2_CH2L12_Dhavrum_name = "CH2L12_Dhavrum"
	speech_chapter2_k2_Subtitle_Text_10 = "No place is safe while the Outcasts walk free.  My hammer is yours to direct.  We shall follow you to the last."
	speech_chapter2_k2_CH2L13_Naava_name = "CH2L13_Naava"
	speech_chapter2_k2_Subtitle_Text_11 = "Then we must go, before the Ceyah slip away."
	speech_chapter2_k2_M6C1L01_Vulgari_name = "M6C1L01_Vulgari"
	speech_chapter2_k2_Subtitle_Text_12 = "Naava Daishan!  I should have seized her amulet centuries ago when I had the chance.  She has us surrounded, Sebak!  Where are your visions now?"
	speech_chapter2_k2_M6C1L02_Naava_name = "M6C1L02_Naava"
	speech_chapter2_k2_Subtitle_Text_13 = "Perhaps I could sneak into their encampment and slit her throat."
	speech_chapter2_k2_M6C1L03_Human_name = "M6C1L03_Human"
	speech_chapter2_k2_Subtitle_Text_14 = "You may be fast, Divsha, but you will not get past the unsleeping eyes of the Gauri.  Ready yourselves.  If they take us, it will not be oblivion that waits. They will cleanse us."
	speech_chapter2_k2_M6C1L04_Sebak_name = "M6C1L04_Sebak"
	speech_chapter2_k2_Subtitle_Text_15 = "No more talk of defeat.  The Shadow has shown me our victory.  The Well of Shadows beckons.  We will escape.  And then, we will rise again."
	speech_chapter2_k2_M6C1L05_Melchior_name = "M6C1L05_Melchior"
	speech_chapter2_k2_Subtitle_Text_16 = "Perhaps your master can tell us how to escape?"
	speech_chapter2_k2_M6C1L06_Sebak_name = "M6C1L06_Sebak"
	speech_chapter2_k2_Subtitle_Text_17 = "No, Melchior.  You must use your arts to free us.  The Shadow will only help those worthy of its power."
	speech_chapter2_k2_M6C1L07_Melchior_name = "M6C1L07_Melchior"
	speech_chapter2_k2_Subtitle_Text_18 = "Then let me prove my worth.  I will blaze a trail through enemy lines.  Give me time to locate a way into the Waste, and then follow my trail."
	speech_chapter2_k2_M6CAL01_Melchior_name = "M6CAL01_Melchior"
	speech_chapter2_k2_Subtitle_Text_19 = "This plateau will give me a better view of the valley ahead."
	speech_chapter2_k2_M6C2L01_Sebak_name = "M6C2L01_Sebak"
	speech_chapter2_k2_Subtitle_Text_20 = "Well done, Melchior.  The Shadow is pleased."
	speech_chapter2_k2_M6C2L02_Melchior_name = "M6C2L02_Melchior"
	speech_chapter2_k2_Subtitle_Text_21 = "Do not presume to speak for the Shadow, Sebak.  You are not Ahriman."
	speech_chapter2_k2_M6C2L03_Sebak_name = "M6C2L03_Sebak"
	speech_chapter2_k2_Subtitle_Text_22 = "Ahriman is gone, Melchior.  He failed the Shadow and has forsaken us.  Now it is our time, and the Shadow beckons."
	speech_chapter2_k2_M6C2L04_Melchior_name = "M6C2L04_Melchior"
	speech_chapter2_k2_Subtitle_Text_23 = "The Shadow should be our tool, not our master."
	speech_chapter2_k2_M6C2L05_Sebak_name = "M6C2L05_Sebak"
	speech_chapter2_k2_Subtitle_Text_24 = "Can a single leaf call the wind its tool?  Before the Shadow, we are nothing.  Lead us to the Well... there you will see the truth."
	speech_chapter2_k2_M7C1L01_Drauga_name = "M7C1L01_Drauga"
	speech_chapter2_k2_Subtitle_Text_25 = "Look what beaten dogs have crawled into the Waste."
	speech_chapter2_k2_M7C1L02_Drauga2_name = "M7C1L02_Drauga2"
	speech_chapter2_k2_Subtitle_Text_26 = "Ceyah, running as always."
	speech_chapter2_k2_M7C1L03_Melchior_name = "M7C1L03_Melchior"
	speech_chapter2_k2_Subtitle_Text_27 = "And how much better are you Drauga, scratching out an existence in the Waste?"
	speech_chapter2_k2_M7C1L04_Drauga_name = "M7C1L04_Drauga"
	speech_chapter2_k2_Subtitle_Text_28 = "Pathetic Ceyah, we are here to worship Sakarr."
	speech_chapter2_k2_M7C1L05_Drauga2_name = "M7C1L05_Drauga2"
	speech_chapter2_k2_Subtitle_Text_29 = "Sakarr is strong!  How fares Ahriman?"
	speech_chapter2_k2_M7C1L06_Melchior_name = "M7C1L06_Melchior"
	speech_chapter2_k2_Subtitle_Text_30 = "You can ask him yourself."
	speech_chapter2_k2_M7C1L07_Whisper_name = "M7C1L07_Whisper"
	speech_chapter2_k2_Subtitle_Text_31 = "[EVIL WHISPERS]"
	speech_chapter2_k2_M7C1L07_Sebak_name = "M7C1L07_Sebak"
	speech_chapter2_k2_Subtitle_Text_32 = "Yes, yes, that's it!"
	speech_chapter2_k2_M7C1L08_Melchior_name = "M7C1L08_Melchior"
	speech_chapter2_k2_Subtitle_Text_33 = "What new vision do you have, Sebak?"
	speech_chapter2_k2_M7C1L09_Sebak_name = "M7C1L09_Sebak"
	speech_chapter2_k2_Subtitle_Text_34 = "A vision born of dragon blood and Drauga corpses.  For too long have we filled our ranks with mercenaries and slaves.  We will restore the Undead!"
	speech_chapter2_k2_M7C1L10_Melchior_name = "M7C1L10_Melchior"
	speech_chapter2_k2_Subtitle_Text_35 = "And who will perform this necromancy, Sebak?"
	speech_chapter2_k2_M7C1L11_Sebak_name = "M7C1L11_Sebak"
	speech_chapter2_k2_Subtitle_Text_36 = "Leave that to me, Melchior.  All I need from you are the blood and corpses."
	speech_chapter2_k2_M7CAL01_Drauga_name = "M7C1.5L01_Drauga"
	speech_chapter2_k2_Subtitle_Text_37 = "The Ceyah are attacking Sakarr, we must go to his aid!"
	speech_chapter2_k2_M7C2L01_Sebak_name = "M7C2L01_Sebak"
	speech_chapter2_k2_Subtitle_Text_38 = "How does it feel to kill a god, Melchior?"
	speech_chapter2_k2_M7C2L02_Melchior_name = "M7C2L02_Melchior"
	speech_chapter2_k2_Subtitle_Text_39 = "My muscles ache.  Nothing more."
	speech_chapter2_k2_M7C2L03_Sebak_name = "M7C2L03_Sebak"
	speech_chapter2_k2_Subtitle_Text_40 = "There will be more gods to kill when you lead the Shadow's armies."
	speech_chapter2_k2_M7C2L04_Sebak_name = "M7C2L04_Sebak"
	speech_chapter2_k2_Subtitle_Text_41 = "But a general needs infantry does he not?"
	speech_chapter2_k2_M8C1L01_Whispers_name = "M8C1L01_Whispers"
	speech_chapter2_k2_Subtitle_Text_42 = "[EVIL WHISPERS]"
	speech_chapter2_k2_M8C1L02_Sebak_name = "M8C1L02_Sebak"
	speech_chapter2_k2_Subtitle_Text_43 = "Yes?"
	speech_chapter2_k2_M8C1L03_Whispers_name = "M8C1L03_Whispers"
	speech_chapter2_k2_Subtitle_Text_44 = "[EVIL WHISPERS]"
	speech_chapter2_k2_M8C1L04_Sebak_name = "M8C1L04_Sebak"
	speech_chapter2_k2_Subtitle_Text_45 = "Yes!"
	speech_chapter2_k2_M8C1L05_Melchior_name = "M8C1L05_Melchior"
	speech_chapter2_k2_Subtitle_Text_46 = "I heard you cry out.  Another vision?"
	speech_chapter2_k2_M8C1L06_Sebak_name = "M8C1L06_Sebak"
	speech_chapter2_k2_Subtitle_Text_47 = "The Shadow has promised me power beyond imagination, and with this power we will rule all of Khaldun.  Think of it..."
	speech_chapter2_k2_M8C1L07_Melchior_name = "M8C1L07_Melchior"
	speech_chapter2_k2_Subtitle_Text_48 = "What comes shall come.  The Drauga tribes are on the move.  The spoils of victory can be settled after the battle, not before."
	speech_chapter2_k2_M8C2L01_Melchior_name = "M8C2L01_Melchior"
	speech_chapter2_k2_Subtitle_Text_49 = "The Drauga Elder escaped."
	speech_chapter2_k2_M8C2L02_Sebak_name = "M8C2L02_Sebak"
	speech_chapter2_k2_Subtitle_Text_50 = "What does it matter?  Around us lie recruits by the hundred!  No longer must we cower and hide.  My glory is at hand!"
	speech_chapter2_k2_M9C1L01_Sebak_name = "M9C1L01_Sebak"
	speech_chapter2_k2_Subtitle_Text_51 = "We are close, Melchior.  I hear the Well of Shadow calling to me."
	speech_chapter2_k2_M9C1L02_Melchior_name = "M9C1L02_Melchior"
	speech_chapter2_k2_Subtitle_Text_52 = "Wake from your dreams!  The Haroun are marching against us."
	speech_chapter2_k2_M9C1L03_Sebak_name = "M9C1L03_Sebak"
	speech_chapter2_k2_Subtitle_Text_53 = "Have faith in the Shadow, Melchior.  It has not failed us yet."
	speech_chapter2_k2_M9C2L01_Haroun_name = "M9C2L01_Haroun"
	speech_chapter2_k2_Subtitle_Text_54 = "Defilers of Khaldun!  We are lifesworn to keep your evil at bay.  There is naught but an end for you here."
	speech_chapter2_k2_M9C2L02_Sebak_name = "M9C2L02_Sebak"
	speech_chapter2_k2_Subtitle_Text_55 = "Fools!  The Shadow will not be denied!"
	speech_chapter2_k2_M9C3L01_Sebak_name = "M9C3L01_Sebak"
	speech_chapter2_k2_Subtitle_Text_56 = "Nothing can stop us!  My greatness is at hand!"
	speech_chapter2_k2_M9C3L02_Melchior_name = "M9C3L02_Melchior"
	speech_chapter2_k2_Subtitle_Text_57 = "Your greatness, Sebak?"
	speech_chapter2_k2_M9C3L03_Sebak_name = "M9C3L03_Sebak"
	speech_chapter2_k2_Subtitle_Text_58 = "Worry not, Melchior!  You, too, shall reap your reward."
	speech_chapter2_k2_M9C4L01_Whisper_name = "M9C4L01_Whisper"
	speech_chapter2_k2_Subtitle_Text_59 = "EVIL WHISPERS"
	speech_chapter2_k2_M9C4L01_Sebak_name = "M9C4L01_Sebak"
	speech_chapter2_k2_Subtitle_Text_60 = "It calls to me!"
	speech_chapter2_k2_M9C4L02_Abaddon_name = "M9C4L02_Abaddon"
	speech_chapter2_k2_Subtitle_Text_61 = "Behold!  The Shadow lives within me.  Is it not beautiful?"
	speech_chapter2_k2_M9C4L03_Melchior_name = "M9C4L03_Melchior"
	speech_chapter2_k2_Subtitle_Text_62 = "Beautiful?  Your taste is questionable, Sebak."
	speech_chapter2_k2_M9C4L04_Abaddon_name = "M9C4L04_Abaddon"
	speech_chapter2_k2_Subtitle_Text_63 = "How empty your taunts are now, Melchior.  Kneel before Abaddon!  Kneel before your master."
	speech_chapter2_k2_M9C4L05_Melchior_name = "M9C4L05_Melchior"
	speech_chapter2_k2_Subtitle_Text_64 = "I kneel before no one."
	speech_chapter2_k2_M9C4L06_Abaddon_name = "M9C4L06_Abaddon"
	speech_chapter2_k2_Subtitle_Text_65 = "Fool!  Can you not see the power I possess?"
	speech_chapter2_k2_M9C4L07_Vulgari_name = "M9C4L07_Vulgari"
	speech_chapter2_k2_Subtitle_Text_66 = "By Ahriman..."
	speech_chapter2_k2_M9C4L08_Abaddon_name = "M9C4L08_Abaddon"
	speech_chapter2_k2_Subtitle_Text_67 = "Ahriman is no more.  I am the Shadow made flesh!  I...am...Abbadon!  You all serve me now.  Submit or perish."
	speech_chapter2_k2_M9C4L09_Melchior_name = "M9C4L09_Melchior"
	speech_chapter2_k2_Subtitle_Text_68 = "Better an eternity lost in the Great Dream than an eternal nightmare."
	speech_chapter2_k2_M9C4L10_Abaddon_name = "M9C4L10_Abaddon"
	speech_chapter2_k2_Subtitle_Text_69 = "The time of the Ceyah is over.  The time of the Fallen has come!"
	speech_chapter2_k2_M10C1L01_Naava_name = "M10C1L01_Naava"
	speech_chapter2_k2_Subtitle_Text_70 = "Come out from your hiding Ceyah, you have nowhere left to run!"
	speech_chapter2_k2_M10C1L02_Abaddon_name = "M10C1L02_Abaddon"
	speech_chapter2_k2_Subtitle_Text_71 = "Fools, their persistence will be their undoing.  The power of the Shadow is mine!  Go forth my children... I wish the Seeker to kneel before me!"
	speech_chapter2_k2_M10C2L01_Abaddon_name = "M10C2L01_Abaddon"
	speech_chapter2_k2_Subtitle_Text_72 = "Run!  Spread word of my power!  Let the last days of the Kohan be filled with dread of my coming!"
	speech_chapter2_k2_M10C2L02_Abaddon_name = "M10C2L02_Abaddon"
	speech_chapter2_k2_Subtitle_Text_73 = "As for you, I am in need of a general for my armies."
	speech_chapter3_k2_narrator_ch3_name = "Chapter 3 Narration"
	speech_chapter3_k2_Subtitle_Text = "While the dark banners of the rising Shadow unfurl in the Waste, a separate struggle is taking place in the ancient kingdom of Elagor.  Jonas Teramun, a newly awakened Kohan without any memory of his past, has been sent by the Council to win the support of Elagor's king, Xander Kharei.  And as war calls to war, small conflicts are soon caught up in the greater storm."
	speech_chapter3_k2_M11C1L01_Human_name = "M11C1L01_Human"
	speech_chapter3_k2_Subtitle_Text_2 = "Lord Kharei, a warrior approaches."
	speech_chapter3_k2_M11C1L02_Jonas_name = "M11C1L02_Jonas"
	speech_chapter3_k2_Subtitle_Text_3 = "Hail King of Elagor.  I have come to offer you a seat in the Council."
	speech_chapter3_k2_M11C1L03_Xander_name = "M11C1L03_Xander"
	speech_chapter3_k2_Subtitle_Text_4 = "How timely your arrival, Kohan.  You are an Age too late to save us from the Ceyah.  My seat is here, with my people.  I will not leave them to civil war."
	speech_chapter3_k2_M11C1L04_Jonas_name = "M11C1L04_Jonas"
	speech_chapter3_k2_Subtitle_Text_5 = "Lord Kharei, we offer peace and prosperity for all of Elagor."
	speech_chapter3_k2_M11C1L05_Human2_name = "M11C1L05_Human2"
	speech_chapter3_k2_Subtitle_Text_6 = "My liege!  The Baron of Riverward rides with your cousin.  Their bannermen are almost in sight of Calamain."
	speech_chapter3_k2_M11C1L06_Xander_name = "M11C1L06_Xander"
	speech_chapter3_k2_Subtitle_Text_7 = "I doubt that Arrod comes to swear fealty.  Kohan, what is your name?"
	speech_chapter3_k2_M11C1L07_Jonas_name = "M11C1L07_Jonas"
	speech_chapter3_k2_Subtitle_Text_8 = "Jonas Teramun."
	speech_chapter3_k2_M11C1L08_Xander_name = "M11C1L08_Xander"
	speech_chapter3_k2_Subtitle_Text_9 = "If you wish to bring peace to all of Elagor, Jonas Teramun, then help me end this accursed civil war and show me what the allegiance of the Council is worth."
	speech_chapter3_k2_M11CAL01_Xander_name = "M11C1.5L01_Xander"
	speech_chapter3_k2_Subtitle_Text_10 = "The southern mountains are rich in resources, but home to a powerful beast.  If we could defeat the creature, our cause will prosper."
	speech_chapter3_k2_M11C2L01_Xander_name = "M11C2L01_Xander"
	speech_chapter3_k2_Subtitle_Text_11 = "You fight like a seasoned warrior, Jonas!  But then, you must have fought hundreds of battles over the Ages?"
	speech_chapter3_k2_M11C2L02_Jonas_name = "M11C2L02_Jonas"
	speech_chapter3_k2_Subtitle_Text_12 = "Perhaps, but I do not remember."
	speech_chapter3_k2_M11C2L03_Xander_name = "M11C2L03_Xander"
	speech_chapter3_k2_Subtitle_Text_13 = "But a Kohan's memories return...  That is one of the Gifts of the Creator, is it not?"
	speech_chapter3_k2_M11C2L04_Jonas_name = "M11C2L04_Jonas"
	speech_chapter3_k2_Subtitle_Text_14 = "My memories have not returned."
	speech_chapter3_k2_M11C2L05_Xander_name = "M11C2L05_Xander"
	speech_chapter3_k2_Subtitle_Text_15 = "I've heard tales that the fervor of battle speeds the return of a Kohan's memories.  Come... let us see if the tales are true!"
	speech_chapter3_k2_M12C1L01_Xander_name = "M12C1L01_Xander"
	speech_chapter3_k2_Subtitle_Text_16 = "Today we will see my cousin defeated, and Elagor made whole."
	speech_chapter3_k2_M12C1L02_Jonas_name = "M12C1L02_Jonas"
	speech_chapter3_k2_Subtitle_Text_17 = "And then?  When your war is done?"
	speech_chapter3_k2_M12C1L03_Xander_name = "M12C1L03_Xander"
	speech_chapter3_k2_Subtitle_Text_18 = "My home has suffered for too long.  For the sake of my countrymen, Elagor will rejoin the Council."
	speech_chapter3_k2_M12C1L04_Xander_name = "M12C1L04_Xander"
	speech_chapter3_k2_Subtitle_Text_19 = "You asked for old bonds to be reforged.  Let it be done."
	speech_chapter3_k2_M12C1L05_Human_name = "M12C1L05_Human"
	speech_chapter3_k2_Subtitle_Text_20 = "Lord Kharei, another Kohan seeks an audience..."
	speech_chapter3_k2_M12C1L06_Xander_name = "M12C1L06_Xander"
	speech_chapter3_k2_Subtitle_Text_21 = "Bring him."
	speech_chapter3_k2_M12C1L07_Human_name = "M12C1L07_Human"
	speech_chapter3_k2_Subtitle_Text_22 = "Her, my liege."
	speech_chapter3_k2_M12C1L08_Naava_name = "M12C1L08_Naava"
	speech_chapter3_k2_Subtitle_Text_23 = "You?"
	speech_chapter3_k2_M12C1L09_Naava_name = "M12C1L09_Naava"
	speech_chapter3_k2_Subtitle_Text_24 = "Xander Kharei, my name is Naava Daishan.  I serve... served... the Regent of Istira as a Seeker.  But the Regent is fallen, and Istira has been overrun by the Shadow!"
	speech_chapter3_k2_M12C1L10_Xander_name = "M12C1L10_Xander"
	speech_chapter3_k2_Subtitle_Text_25 = "The Shadow?  Did you know of this?"
	speech_chapter3_k2_M12C1L11_Jonas_name = "M12C1L11_Jonas"
	speech_chapter3_k2_Subtitle_Text_26 = "I have heard nothing of this."
	speech_chapter3_k2_M12C1L12_Naava_name = "M12C1L12_Naava"
	speech_chapter3_k2_Subtitle_Text_27 = "Even now, they march upon Rhusk.  Their corruption reaches out, soon it will touch this land.  Forget this battle and face your true enemy."
	speech_chapter3_k2_M12C1L13_Xander_name = "M12C1L13_Xander"
	speech_chapter3_k2_Subtitle_Text_28 = "Today I mean to end a war that has plagued my people for years.  If I must begin another battle, then let it be tomorrow."
	speech_chapter3_k2_M12C1L14_Naava_name = "M12C1L14_Naava"
	speech_chapter3_k2_Subtitle_Text_29 = "If you do not heed my words, there may not be a tomorrow for your people!"
	speech_chapter3_k2_M12C2L01_Jonas_name = "M12C2L01_Jonas"
	speech_chapter3_k2_Subtitle_Text_30 = "These abominations... I remember..."
	speech_chapter3_k2_M12C2L02_Naava_name = "M12C2L02_Naava"
	speech_chapter3_k2_Subtitle_Text_31 = "King Kharei!"
	speech_chapter3_k2_M12C2L03_Xander_name = "M12C2L03_Xander"
	speech_chapter3_k2_Subtitle_Text_32 = "You warned me of this and I did not listen.  I will not let this darkness take my land!"
	speech_chapter3_k2_M12C2L04_Arrod_name = "M12C2L04_Arrod"
	speech_chapter3_k2_Subtitle_Text_33 = "Cousin, let us combine our forces.  Alone, neither can withstand this horror, but together, we may have a chance... my liege."
	speech_chapter3_k2_M12C3L01_Naava_name = "M12C3L01_Naava"
	speech_chapter3_k2_Subtitle_Text_34 = "Will you listen now, King Kharei?  We pursued the Ceyah into the Waste, where they uncovered an ancient source of power.  These Ceyah then marched forth from the Waste, led by a terrible demon named Abaddon. We hunters became the hunted.   We met them at the borderlands, and then in the heart of Istira.  For nothing.  Istira was broken and many of our kindred sent to the Dream, or worse..."
	speech_chapter3_k2_M12C3L02_Jonas_name = "M12C3L02_Jonas"
	speech_chapter3_k2_Subtitle_Text_35 = "We must make for Rhusk!  The Council must be warned."
	speech_chapter3_k2_M12C3L03_Naava_name = "M12C3L03_Naava"
	speech_chapter3_k2_Subtitle_Text_36 = "If they still live.  Regardless, we must go."
	speech_chapter3_k2_M12C3L04_Jonas_name = "M12C3L04_Jonas"
	speech_chapter3_k2_Subtitle_Text_37 = "Will you come?"
	speech_chapter3_k2_M12C3L05_Xander_name = "M12C3L05_Xander"
	speech_chapter3_k2_Subtitle_Text_38 = "When the hour comes, I will be there."
	speech_chapter3_k2_M13C1L01_Jonas_name = "M13C1L01_Jonas"
	speech_chapter3_k2_Subtitle_Text_39 = "Look out!"
	speech_chapter3_k2_M13C1L02_Naava_name = "M13C1L02_Naava"
	speech_chapter3_k2_Subtitle_Text_40 = "Hold, Ceyah!  I do not know what game you play, but it will be your last!"
	speech_chapter3_k2_M13C1L03_Melchior_name = "M13C1L03_Melchior"
	speech_chapter3_k2_Subtitle_Text_41 = "The game is up for all of us."
	speech_chapter3_k2_M13C1L04_Jonas_name = "M13C1L04_Jonas"
	speech_chapter3_k2_Subtitle_Text_42 = "Who are you?"
	speech_chapter3_k2_M13C1L05_Melchior_name = "M13C1L05_Melchior"
	speech_chapter3_k2_Subtitle_Text_43 = "I thought my reputation preceded me.  I am Melchior."
	speech_chapter3_k2_M13C1L06_Jonas_name = "M13C1L06_Jonas"
	speech_chapter3_k2_Subtitle_Text_44 = "Why did you help us?"
	speech_chapter3_k2_M13C1L07_Melchior_name = "M13C1L07_Melchior"
	speech_chapter3_k2_Subtitle_Text_45 = "We have a common foe.  The Fallen have no love for me or any other Ceyah who will not join them.  And I have no desire to serve at the feet of Abaddon."
	speech_chapter3_k2_M13C1L08_Naava_name = "M13C1L08_Naava"
	speech_chapter3_k2_Subtitle_Text_46 = "Liar!  You were there at the Well when we hunted you down!"
	speech_chapter3_k2_M13C1L09_Melchior_name = "M13C1L09_Melchior"
	speech_chapter3_k2_Subtitle_Text_47 = "If I were aligned with the Fallen, do you think I would be leading this sorry lot?"
	speech_chapter3_k2_M13C1L10_Jonas_name = "M13C1L10_Jonas"
	speech_chapter3_k2_Subtitle_Text_48 = "We must warn the Council first."
	speech_chapter3_k2_M13C1L11_Melchior_name = "M13C1L11_Melchior"
	speech_chapter3_k2_Subtitle_Text_49 = "You will not make it to the Council without the Gauri's help.  But, their mountains crawl with the Undead and many canyons have frozen over.  The Gauri citadel at Channak still stands, but barely."
	speech_chapter3_k2_M13C2L01_Agborus_name = "M13C2L01_Agborus"
	speech_chapter3_k2_Subtitle_Text_50 = "Thank the Creator!  I had feared that we were alone against the darkness. The Undead infest the High Reaches and must be driven out.  Once again, we need your aid, Naava."
	speech_chapter3_k2_M13C3L01_Agborus_name = "M13C3L01_Agborus"
	speech_chapter3_k2_Subtitle_Text_51 = "What business does this Ceyah dog have in my mountains?"
	speech_chapter3_k2_M13C3L02_Melchior_name = "M13C3L02_Melchior"
	speech_chapter3_k2_Subtitle_Text_52 = "Your mountains?  It seems they belong to the Fallen now."
	speech_chapter3_k2_M13C3L03_Naava_name = "M13C3L03_Naava"
	speech_chapter3_k2_Subtitle_Text_53 = "Agborus, where is Dhavrum?"
	speech_chapter3_k2_M13C3L04_Agborus_name = "M13C3L04_Agborus"
	speech_chapter3_k2_Subtitle_Text_54 = "Lost, like so many others."
	speech_chapter3_k2_M13C3L05_Naava_name = "M13C3L05_Naava"
	speech_chapter3_k2_Subtitle_Text_55 = "I'm sorry. He was a brave warrior."
	speech_chapter3_k2_M13C3L06_Jonas_name = "M13C3L06_Jonas"
	speech_chapter3_k2_Subtitle_Text_56 = "We must reach Rhusk, King Agborus.  The Council must be warned of the danger!  Chancellor Sakeri told me that your people have secret ways into the city..."
	speech_chapter3_k2_M13C3L07_Agborus_name = "M13C3L07_Agborus"
	speech_chapter3_k2_Subtitle_Text_57 = "We have them no longer.  The Undead have collapsed our tunnels and torn down our citadels.  If you wish to reach Rhusk, it will be through the Fallen, not beneath them."
	speech_chapter3_k2_M13C3L08_Naava_name = "M13C3L08_Naava"
	speech_chapter3_k2_Subtitle_Text_58 = "All the better.  I am ready to face them."
	speech_chapter3_k2_M13C3L09_Agborus_name = "M13C3L09_Agborus"
	speech_chapter3_k2_Subtitle_Text_59 = "Then take my armies, Naava, and exact revenge for my people, for I no longer have the strength for battle."
	speech_chapter3_k2_M14C1L01_Melchior_name = "M14C1L01_Melchior"
	speech_chapter3_k2_Subtitle_Text_60 = "Always eager for the glory of hopeless battle..."
	speech_chapter3_k2_M14C1L02_Naava_name = "M14C1L02_Naava"
	speech_chapter3_k2_Subtitle_Text_61 = "Those who walk in the Light fear no Shadow, Melchior, for the Creator walks with us."
	speech_chapter3_k2_M14C1L03_Melchior_name = "M14C1L03_Melchior"
	speech_chapter3_k2_Subtitle_Text_62 = "And suppose you defeat these creatures.  There is still Mahrdol, the demon driving them..."
	speech_chapter3_k2_M14C1L04_Melchior_name = "M14C1L04_Melchior"
	speech_chapter3_k2_Subtitle_Text_63 = "He went by another name once.  You knew him as Ghalen Mordecai."
	speech_chapter3_k2_M14C1L05_Naava_name = "M14C1L05_Naava"
	speech_chapter3_k2_Subtitle_Text_64 = "No.  No!  It cannot be!"
	speech_chapter3_k2_M14C1L06_Melchior_name = "M14C1L06_Melchior"
	speech_chapter3_k2_Subtitle_Text_65 = "It is.  Sebak turned him."
	speech_chapter3_k2_M14C1L07_Naava_name = "M14C1L07_Naava"
	speech_chapter3_k2_Subtitle_Text_66 = "I cannot believe it."
	speech_chapter3_k2_M14C1L08_Melchior_name = "M14C1L08_Melchior"
	speech_chapter3_k2_Subtitle_Text_67 = "Believe what you will.  And beyond Mahrdol remains the greater darkness spilling from the Waste."
	speech_chapter3_k2_M14C1L09_Jonas_name = "M14C1L09_Jonas"
	speech_chapter3_k2_Subtitle_Text_68 = "They, in their turn, will be dealt with."
	speech_chapter3_k2_M14C1L10_Melchior_name = "M14C1L10_Melchior"
	speech_chapter3_k2_Subtitle_Text_69 = "Well then, let us all be optimists.  Glory calls..."
	speech_chapter3_k2_M14C2L1_Naava_name = "M14C2L1_Naava"
	speech_chapter3_k2_Subtitle_Text_70 = "Ghalen...  By the Light, what have they done to you?"
	speech_chapter3_k2_M14C2L2_Mahrdol_name = "M14C2L2_Mahrdol"
	speech_chapter3_k2_Subtitle_Text_71 = "There is no Light, only the darkness of the Shadow."
	speech_chapter3_k2_M14C3L01_Melchior_name = "M14C3L01_Melchior"
	speech_chapter3_k2_Subtitle_Text_72 = "We must retreat and gather our strength."
	speech_chapter3_k2_M14C3L02_Naava_name = "M14C3L02_Naava"
	speech_chapter3_k2_Subtitle_Text_73 = "No!  I will not give way before them again!"
	speech_chapter3_k2_M14C3L03_Jonas_name = "M14C3L03_Jonas"
	speech_chapter3_k2_Subtitle_Text_74 = "Listen!"
	speech_chapter3_k2_M14C3L04_Ravid_name = "M14C3L04_Ravid"
	speech_chapter3_k2_Subtitle_Text_75 = "Jonas!"
	speech_chapter3_k2_M14C3L05_Jonas_name = "M14C3L05_Jonas"
	speech_chapter3_k2_Subtitle_Text_76 = "Ravid!"
	speech_chapter3_k2_M14C3L06_Ravid_name = "M14C3L06_Ravid"
	speech_chapter3_k2_Subtitle_Text_77 = "By the Creator, I never thought I would see you again."
	speech_chapter3_k2_M14C4L01_Naava_name = "M14C4L01_Naava"
	speech_chapter3_k2_Subtitle_Text_78 = "Even his amulet bears the Shadow's taint."
	speech_chapter3_k2_M14C4L02_Jonas_name = "M14C4L02_Jonas"
	speech_chapter3_k2_Subtitle_Text_79 = "He was your friend?"
	speech_chapter3_k2_M14C4L03_Naava_name = "M14C4L3_Naava"
	speech_chapter3_k2_Subtitle_Text_80 = "For many Ages, we fought beside each other in the name of the Light.  Friendship is too small a word.  Never did I think he would fall to the darkness."
	speech_chapter3_k2_M14C4L04_Jonas_name = "M14C4L4_Jonas"
	speech_chapter3_k2_Subtitle_Text_81 = "Is there anything that can be done?"
	speech_chapter3_k2_M14C4L05_Naava_name = "M14C4L05_Naava"
	speech_chapter3_k2_Subtitle_Text_82 = "Cleansing."
	speech_chapter3_k2_M14C4L06_Melchior_name = "M14C4L6_Melchior"
	speech_chapter3_k2_Subtitle_Text_83 = "You mean soul-burning, Seeker."
	speech_chapter3_k2_M14C4L07_Naava_name = "M14C4L7_Naava"
	speech_chapter3_k2_Subtitle_Text_84 = "The flames of the Saadya heal, Melchior, though the healing is painful."
	speech_chapter3_k2_M14C4L08_Melchior_name = "M14C4L08_Melchior"
	speech_chapter3_k2_Subtitle_Text_85 = "Call it what you will.  He can never be brought back.  What was done to him cannot be reversed. The ritual will leave but a shell of a man that once was."
	speech_chapter3_k2_M14C4L09_Scout_name = "M14C4L09_Scout"
	speech_chapter3_k2_Subtitle_Text_86 = "Chancellor Sakeri bids you to come.  Please, follow me."
	speech_chapter4_k2_narrator_ch4_name = "Chapter 4 Narration"
	speech_chapter4_k2_Subtitle_Text = "With the Council's forces in shambles and Istira in chaos, the forces of Light seem faint and tiny against the rising pall of the Shadow.  Yet, in the far West, there remains one hero, the ancient leader and champion of the old wars, whose castles still stand and armies yet live.  Now, it will be upon the heroes of the East to bring warning of the coming battle, before the Shadow falls upon those few who could defeat it."
	speech_chapter4_k2_CH4L01_Ravid_name = "CH4L01_Ravid"
	speech_chapter4_k2_Subtitle_Text_2 = "I see you have brought friends.  I recognize you both, though I would not have expected either."
	speech_chapter4_k2_CH4L02_Naava_name = "CH4L02_Naava"
	speech_chapter4_k2_Subtitle_Text_3 = "Istira has fallen.  The demon we killed here today, the Undead who served him... they were all Istiran once.  I have nowhere else to go."
	speech_chapter4_k2_CH4L03_Ravid_name = "CH4L03_Ravid"
	speech_chapter4_k2_Subtitle_Text_4 = "And you?"
	speech_chapter4_k2_CH4L04_Melchior_name = "CH4L04_Melchior"
	speech_chapter4_k2_Subtitle_Text_5 = "I am here because the Fallen and I have a philosophical disagreement regarding the existence of free will.  Namely mine."
	speech_chapter4_k2_CH4L05_Jonas_name = "CH4L05_Jonas"
	speech_chapter4_k2_Subtitle_Text_6 = "Elagor's King, Xander Kharei has also pledged his support."
	speech_chapter4_k2_CH4L06_Naava_name = "CH4L06_Naava"
	speech_chapter4_k2_Subtitle_Text_7 = "As have the Gauri of the High Reaches."
	speech_chapter4_k2_CH4L07_Melchior_name = "CH4L07_Melchior"
	speech_chapter4_k2_Subtitle_Text_8 = "A veritable menagerie of lost causes..."
	speech_chapter4_k2_CH4L08_Ravid_name = "CH4L08_Ravid"
	speech_chapter4_k2_Subtitle_Text_9 = "Silence, Ceyah."
	speech_chapter4_k2_CH4L09_Melchior_name = "CH4L09_Melchior"
	speech_chapter4_k2_Subtitle_Text_10 = "I speak the truth.  The Council is in scarcely better shape than the rest.  We may have defeated Mahrdol, but there are more Fallen."
	speech_chapter4_k2_CH4L10_Ravid_name = "CH4L10_Ravid"
	speech_chapter4_k2_Subtitle_Text_11 = "You are right.  We cannot do this alone.  Istira is fallen and the Council is broken.  But there remains one other.  We must hope that Darius Javidan can be reached in time."
	speech_chapter4_k2_M15C1L01_Ravid_name = "M15C1L01_Ravid"
	speech_chapter4_k2_Subtitle_Text_12 = "The coming storm is unavoidable, and our forces are too few to weather it.  Word of our plight must be brought to King Javidan."
	speech_chapter4_k2_M15C1L02_Jonas_name = "M15C1L02_Jonas"
	speech_chapter4_k2_Subtitle_Text_13 = "We will do what you ask of us, Chancellor Sakeri."
	speech_chapter4_k2_M15C1L03_Ravid_name = "M15C1L03_Ravid"
	speech_chapter4_k2_Subtitle_Text_14 = "Go now.  You must travel swiftly and silently."
	speech_chapter4_k2_M15C1L04_Ravid_name = "M15C1L04_Ravid"
	speech_chapter4_k2_Subtitle_Text_15 = "May the Creator watch over you...  Even you, Melchior."
	speech_chapter4_k2_M15C2L01_Melchior_name = "M15C2L01_Melchior"
	speech_chapter4_k2_Subtitle_Text_16 = "Our enemies are destroyed, but more will come."
	speech_chapter4_k2_M15C2L02_Naava_name = "M15C2L02_Naava"
	speech_chapter4_k2_Subtitle_Text_17 = "Quiet!"
	speech_chapter4_k2_M15C2L03_OrdWhisper_name = "M15C2L03_OrdWhisper"
	speech_chapter4_k2_Subtitle_Text_18 = "[STRANGE WHISPERING]"
	speech_chapter4_k2_M15C2L04_Naava_name = "M15C2L04_Naava"
	speech_chapter4_k2_Subtitle_Text_19 = "I hear something calling my name."
	speech_chapter4_k2_M15C2L05_Melchior_name = "M15C2L05_Melchior"
	speech_chapter4_k2_Subtitle_Text_20 = "Sebak claimed the Shadow spoke to him.  Do not let it seduce you..."
	speech_chapter4_k2_M15C2L06_Naava_name = "M15C2L06_Naava"
	speech_chapter4_k2_Subtitle_Text_21 = "Quiet!"
	speech_chapter4_k2_M15C2L07_OrdWhisper_name = "M15C2L07_OrdWhisper"
	speech_chapter4_k2_Subtitle_Text_22 = "[STRANGE WHISPERING]"
	speech_chapter4_k2_M15C2L08_Naava_name = "M15C2L08_Naava"
	speech_chapter4_k2_Subtitle_Text_23 = "Can you hear it?"
	speech_chapter4_k2_M15C2L09_OrdWhisper_name = "M15C2L09_OrdWhisper"
	speech_chapter4_k2_Subtitle_Text_24 = "[STRANGE WHISPERING]"
	speech_chapter4_k2_M15C2L10_Melchior_name = "M15C2L10_Melchior"
	speech_chapter4_k2_Subtitle_Text_25 = "The Shadow has her."
	speech_chapter4_k2_M15C2L11_Naava_name = "M15C2L11_Naava"
	speech_chapter4_k2_Subtitle_Text_26 = "No.  Not the Shadow.  I felt an ageless sorrow, but no hate.  Something powerful is nearby, and it needs our help.  We cannot leave yet."
	speech_chapter4_k2_M15C2L12_Melchior_name = "M15C2L12_Melchior"
	speech_chapter4_k2_Subtitle_Text_27 = "If it's so powerful..."
	speech_chapter4_k2_M15C2L13_Jonas_name = "M15C2L13_Jonas"
	speech_chapter4_k2_Subtitle_Text_28 = "If Naava says we stay, we stay."
	speech_chapter4_k2_M16C1L01_Naava_name = "M16C1L01_Naava"
	speech_chapter4_k2_Subtitle_Text_29 = "Something sickening draws near.  The malevolence is overwhelming."
	speech_chapter4_k2_M16C1L02_Melchior_name = "M16C1L02_Melchior"
	speech_chapter4_k2_Subtitle_Text_30 = "Then we -"
	speech_chapter4_k2_M16C1L03_Durash_name = "M16C1L03_Durash"
	speech_chapter4_k2_Subtitle_Text_31 = "Well, well, well.  The traitor Melchior drags his doomed carcass to our very doorstep."
	speech_chapter4_k2_M16C1L04_Durash_name = "M16C1L04_Durash"
	speech_chapter4_k2_Subtitle_Text_32 = "I see you bring another traitor with you, a fool ignorant of his present betrayal.  Come no further, or it will be your doom."
	speech_chapter4_k2_M16C1L05_Melchior_name = "M16C1L05_Melchior"
	speech_chapter4_k2_Subtitle_Text_33 = "If you try to stop us, Vulgari, you will die."
	speech_chapter4_k2_M16C1L06_Durash_name = "M16C1L06_Durash"
	speech_chapter4_k2_Subtitle_Text_34 = "I am Durash now, Melchior.  And as for death, it is my slave."
	speech_chapter4_k2_M16C1L07_Naava_name = "M16C1L07_Naava"
	speech_chapter4_k2_Subtitle_Text_35 = "The voice is close, but Durash's forces lie in our way."
	speech_chapter4_k2_M16C1L08_Melchior_name = "M16C1L08_Melchior"
	speech_chapter4_k2_Subtitle_Text_36 = "Then we must clear a path."
	speech_chapter4_k2_M16C2L01_Naava_name = "M16C2L01_Naava"
	speech_chapter4_k2_Subtitle_Text_37 = "There!  In the temple!"
	speech_chapter4_k2_M16C2L02_Ord_name = "M16C2L02_Ord"
	speech_chapter4_k2_Subtitle_Text_38 = "Lower your blades, immortal children of the Creator, for I am no foe."
	speech_chapter4_k2_M16C2L03_Naava_name = "M16C2L03_Naava"
	speech_chapter4_k2_Subtitle_Text_39 = "Your voice... it was you who called to me!"
	speech_chapter4_k2_M16C2L04_Ord_name = "M16C2L04_Ord"
	speech_chapter4_k2_Subtitle_Text_40 = "Yes.  I am Ord, of the Trow.  We, along with the other Guardians - the Ifrit, the Jotun, and the Djinn - protect Khaldun from corruption."
	speech_chapter4_k2_M16C2L05_Melchior_name = "M16C2L05_Melchior"
	speech_chapter4_k2_Subtitle_Text_41 = "A fine job you've done of it."
	speech_chapter4_k2_M16C2L06_Ord_name = "M16C2L06_Ord"
	speech_chapter4_k2_Subtitle_Text_42 = "For many Ages, we have resisted Ahriman's tainting of the world.  We wrought the Cataclysms that ended your wars, bringing times of restoration and healing to Khaldun."
	speech_chapter4_k2_M16C2L07_Naava_name = "M16C2L07_Naava"
	speech_chapter4_k2_Subtitle_Text_43 = "You caused the Cataclysms?!"
	speech_chapter4_k2_M16C2L08_Ord_name = "M16C2L08_Ord"
	speech_chapter4_k2_Subtitle_Text_44 = "There was no choice.  And if the Fallen bring the ruin of the Shadow to this world, we will be forced to bring a Cataclysm such as Ages have never known.  Khaldun may not survive, but better that, than it fall to the Shadow."
	speech_chapter4_k2_M16C2L09_Naava_name = "M16C2L09_Naava"
	speech_chapter4_k2_Subtitle_Text_45 = "You would destroy the world?"
	speech_chapter4_k2_M16C2L10_Ord_name = "M16C2L10_Ord"
	speech_chapter4_k2_Subtitle_Text_46 = "We have seen a dark future.  Khaldun falls to the Shadow and is flung like a rotting carcass into the Light, to serve as the staging ground for an endless war between the Creator and the Shadow."
	speech_chapter4_k2_M16C2L11_Jonas_name = "M16C2L11_Jonas"
	speech_chapter4_k2_Subtitle_Text_47 = "Is there no other outcome?"
	speech_chapter4_k2_M16C2L12_Ord_name = "M16C2L12_Ord"
	speech_chapter4_k2_Subtitle_Text_48 = "Yes.  I have foreseen a different fate in which the sacrifice of the Kohan defeats the Shadow, for a time, and brings peace to Khaldun.  But the end draws near.  The Guardians will begin the unworking of the world before the taint of the Shadow becomes irresistible."
	speech_chapter4_k2_M16C2L13_Naava_name = "M16C2L13_Naava"
	speech_chapter4_k2_Subtitle_Text_49 = "What must we do?"
	speech_chapter4_k2_M16C2L14_Ord_name = "M16C2L14_Ord"
	speech_chapter4_k2_Subtitle_Text_50 = "In the end, you will know.  For now, you must seek out the Drauga of the Waste, and with them, fight your way to Darius Javidan.  Go."
	speech_chapter4_k2_M17C1L01_Naava_name = "M17C1L01_Naava"
	speech_chapter4_k2_Subtitle_Text_51 = "When I passed through here, all was deserted.  I saw no Drauga."
	speech_chapter4_k2_M17C1L02_Melchior_name = "M17C1L02_Melchior"
	speech_chapter4_k2_Subtitle_Text_52 = "They must have hidden themselves after we crushed them."
	speech_chapter4_k2_M17C1L03_Jonas_name = "M17C1L03_Jonas"
	speech_chapter4_k2_Subtitle_Text_53 = "Then find them, tracker."
	speech_chapter4_k2_M17C1L04_Melchior_name = "M17C1L04_Melchior"
	speech_chapter4_k2_Subtitle_Text_54 = "They will not take kindly to my return.  Once you have won them over, I will come back."
	speech_chapter4_k2_M17C1L05_Jonas_name = "M17C1L05_Jonas"
	speech_chapter4_k2_Subtitle_Text_55 = "Why not take off the mask, Melchior?  They would never know you."
	speech_chapter4_k2_M17C1L06_Melchior_name = "M17C1L06_Melchior"
	speech_chapter4_k2_Subtitle_Text_56 = "The irony cuts deep; but, of course you remember nothing.  This is my face now, Jonas...  I suggest you make haste."
	speech_chapter4_k2_M17C2L01_Drauga_name = "M17C2L01_Drauga"
	speech_chapter4_k2_Subtitle_Text_57 = "Kohan!  You have come to us at the end?  The Undead have us surrounded and prey on us at every turn.  Our days grow short."
	speech_chapter4_k2_M17C2L02_Naava_name = "M17C2L02_Naava"
	speech_chapter4_k2_Subtitle_Text_58 = "That is why we are here.  Today, the Drauga rise again!"
	speech_chapter4_k2_M17C3L01_Thurak_name = "M17C3L01_Thurak"
	speech_chapter4_k2_Subtitle_Text_59 = "I am Thurak Mordoth. I speak for the tribe."
	speech_chapter4_k2_M17C3L02_Naava_name = "M17C3L02_Naava"
	speech_chapter4_k2_Subtitle_Text_60 = "We ask for your aid, for our battle is great.  Will you join us?"
	speech_chapter4_k2_M17C3L03_Thurak_name = "M17C3L03_Thurak"
	speech_chapter4_k2_Subtitle_Text_61 = "Glorious were the days when Drauga fought beside Kohan. Let it be once more as it was then!"
	speech_chapter4_k2_M18C1L01_Jonas_name = "M18C1L01_Jonas"
	speech_chapter4_k2_Subtitle_Text_62 = "Then we shall -"
	speech_chapter4_k2_M18C1L02_Thurak_name = "M18C1L02_Thurak"
	speech_chapter4_k2_Subtitle_Text_63 = "Kill him!"
	speech_chapter4_k2_M18C1L03_Jonas_name = "M18C1L03_Jonas"
	speech_chapter4_k2_Subtitle_Text_64 = "No!"
	speech_chapter4_k2_M18C1L04_Thurak_name = "M18C1L04_Thurak"
	speech_chapter4_k2_Subtitle_Text_65 = "He is a god-slayer."
	speech_chapter4_k2_M18C1L05_Jonas_name = "M18C1L05_Jonas"
	speech_chapter4_k2_Subtitle_Text_66 = "He is our companion."
	speech_chapter4_k2_M18C1L06_Thurak_name = "M18C1L06_Thurak"
	speech_chapter4_k2_Subtitle_Text_67 = "This one has no companion but treachery."
	speech_chapter4_k2_M18C1L07_Jonas_name = "M18C1L07_Jonas"
	speech_chapter4_k2_Subtitle_Text_68 = "Enough!  Thurak, you swore allegiance.  And Melchior, there is penance owed for what you did to the Drauga."
	speech_chapter4_k2_M18C1L08_Melchior_name = "M18C1L08_Melchior"
	speech_chapter4_k2_Subtitle_Text_69 = "First Naava, and then the barbarian, and now you?  At least their hypocrisy stems from a belief that their acts are just.  Yours springs from pure ignorance."
	speech_chapter4_k2_M18C1L09_Jonas_name = "M18C1L09_Jonas"
	speech_chapter4_k2_Subtitle_Text_70 = "What do you know?"
	speech_chapter4_k2_M18C1L10_Melchior_name = "M18C1L10_Melchior"
	speech_chapter4_k2_Subtitle_Text_71 = "Everything."
	speech_chapter4_k2_M18C1L11_Naava_name = "M18C1L11_Naava"
	speech_chapter4_k2_Subtitle_Text_72 = "No more!"
	speech_chapter4_k2_M18C1L12_Melchior_name = "M18C1L12_Melchior"
	speech_chapter4_k2_Subtitle_Text_73 = "Very well.  Peace, elder."
	speech_chapter4_k2_M18C1L13_Melchior_name = "M18C1L13_Melchior"
	speech_chapter4_k2_Subtitle_Text_74 = "While you fought, I scouted ahead.  To reach Dar Barat, we must cut our way through canyons overflowing with the living dead."
	speech_chapter4_k2_M18C2L01_Melchior_name = "M18C2L01_Melchior"
	speech_chapter4_k2_Subtitle_Text_75 = "We shared the battlefield before, you and I."
	speech_chapter4_k2_M18C2L02_Jonas_name = "M18C2L02_Jonas"
	speech_chapter4_k2_Subtitle_Text_76 = "Tell me what you know!"
	speech_chapter4_k2_M18C2L03_Melchior_name = "M18C2L03_Melchior"
	speech_chapter4_k2_Subtitle_Text_77 = "Why?  Your ignorant morality is your strength.  But I give you this:  On our way to Dar Barat, we will pass the battlegrounds where you died and lost your past."
	speech_chapter4_k2_M18C2L04_Jonas_name = "M18C2L04_Jonas"
	speech_chapter4_k2_Subtitle_Text_78 = "What?"
	speech_chapter4_k2_M18C2L05_Naava_name = "M18C2L05_Naava"
	speech_chapter4_k2_Subtitle_Text_79 = "Melchior, what have you told him?"
	speech_chapter4_k2_M18C2L06_Melchior_name = "M18C2L06_Melchior"
	speech_chapter4_k2_Subtitle_Text_80 = "Nothing."
	speech_chapter4_k2_M18C2L07_Jonas_name = "M18C2L07_Jonas"
	speech_chapter4_k2_Subtitle_Text_81 = "Melchior said that I died near Dar Barat.  Those are your lands, Naava.  What do you know?"
	speech_chapter4_k2_M18C2L08_Naava_name = "M18C2L08_Naava"
	speech_chapter4_k2_Subtitle_Text_82 = "Jonas, the Ceyah have always used falsehood to divide our people.  Do not listen to him.  You are recently Awakened.  Your memories will return."
	speech_chapter4_k2_M18C2L09_Jonas_name = "M18C2L09_Jonas"
	speech_chapter4_k2_Subtitle_Text_83 = "The others remembered in days, months.  It has been a year Naava, and I know nothing!"
	speech_chapter4_k2_M18C2L10_Naava_name = "M18C2L10_Naava"
	speech_chapter4_k2_Subtitle_Text_84 = "Jonas, you are pure.  Remember that.  Whatever lies in your past, you are free of it."
	speech_chapter4_k2_M19C1L01_Melchior_name = "M19C1L01_Melchior"
	speech_chapter4_k2_Subtitle_Text_85 = "Now, Naava, another old friend awaits."
	speech_chapter4_k2_M19C1L02_Naava_name = "M19C1L02_Naava"
	speech_chapter4_k2_Subtitle_Text_86 = "You may think you can play games with Jonas, but you will not with me!"
	speech_chapter4_k2_M19C1L03_Melchior_name = "M19C1L03_Melchior"
	speech_chapter4_k2_Subtitle_Text_87 = "No games.  The Regent rules here still."
	speech_chapter4_k2_M19C1L04_Naava_name = "M19C1L04_Naava"
	speech_chapter4_k2_Subtitle_Text_88 = "What?!"
	speech_chapter4_k2_M19C1L05_Melchior_name = "M19C1L05_Melchior"
	speech_chapter4_k2_Subtitle_Text_89 = "Under the name Golshan now, and under a new banner.  But perhaps she will appreciate your return all the same."
	speech_chapter4_k2_M19C1L06_Naava_name = "M19C1L06_Naava"
	speech_chapter4_k2_Subtitle_Text_90 = "When this is done, Melchior..."
	speech_chapter4_k2_M19C1L07_Melchior_name = "M19C1L07_Melchior"
	speech_chapter4_k2_Subtitle_Text_91 = "Until then, battle awaits."
	speech_chapter4_k2_M19CAL01_Jonas_name = "M19C1.5L01_Jonas"
	speech_chapter4_k2_Subtitle_Text_92 = "Capturing Dar Barat will be easier if we clear away the surrounding Shadow settlements."
	speech_chapter4_k2_M19C2L01_Golshan_name = "M19C2L01_Golshan"
	speech_chapter4_k2_Subtitle_Text_93 = "My loyal seeker!  Join me in Abaddon's dark embrace!"
	speech_chapter4_k2_M19C2L02_Naava_name = "M19C2L02_Naava"
	speech_chapter4_k2_Subtitle_Text_94 = "No.  I will not join you until blade and fire have set you free."
	speech_chapter4_k2_M19C3L01_Jonas_name = "M19C3L01_Jonas"
	speech_chapter4_k2_Subtitle_Text_95 = "Golshan is slain; Dar Barat is in ruins.  No more lies.  I want answers."
	speech_chapter4_k2_M19C3L02_Melchior_name = "M19C3L02_Melchior"
	speech_chapter4_k2_Subtitle_Text_96 = "Why look to me, Jonas?  Ask the Seeker who you are.  You can see in her eyes that she knows."
	speech_chapter4_k2_M19C3L03_Jonas_name = "M19C3L03_Jonas"
	speech_chapter4_k2_Subtitle_Text_97 = "Who am I?"
	speech_chapter4_k2_M19C3L04_Naava_name = "M19C3L04_Naava"
	speech_chapter4_k2_Subtitle_Text_98 = "After the Great War, many... lost ones... were redeemed.  That redemption had a price..."
	speech_chapter4_k2_M19C3L05_Jonas_name = "M19C3L05_Jonas"
	speech_chapter4_k2_Subtitle_Text_99 = "No more mincing words Naava!  The truth!"
	speech_chapter4_k2_M19C3L06_Melchior_name = "M19C3L06_Melchior"
	speech_chapter4_k2_Subtitle_Text_100 = "The truth is, Sijansur, that you were a Ceyah warrior as proud and cruel as any among us."
	speech_chapter4_k2_M19C3L07_Melchior_name = "M19C3L07_Melchior"
	speech_chapter4_k2_Subtitle_Text_101 = "After the Great War, the Seekers caught you in the forests near here.  And they cleansed you, cutting out your very essence.  Then they sent you to work - a mindless slave to kill your own brothers."
	speech_chapter4_k2_M19C3L08_Naava_name = "M19C3L08_Naava"
	speech_chapter4_k2_Subtitle_Text_102 = "You twist everything..."
	speech_chapter4_k2_M19C3L09_Melchior_name = "M19C3L09_Melchior"
	speech_chapter4_k2_Subtitle_Text_103 = "Do I?"
	speech_chapter4_k2_M19C3L10_Jonas_name = "M19C3L10_Jonas"
	speech_chapter4_k2_Subtitle_Text_104 = "Tell me he's lying."
	speech_chapter4_k2_M19C3L11_Naava_name = "M19C3L11_Naava"
	speech_chapter4_k2_Subtitle_Text_105 = "We wanted to bring you back to who you were before the Shadow claimed you."
	speech_chapter4_k2_M19C3L12_Jonas_name = "M19C3L12_Jonas"
	speech_chapter4_k2_Subtitle_Text_106 = "Then it's true?  I'm twice a betrayer... My hands twice soaked in blood of my brethren."
	speech_chapter4_k2_M19C3L13_Naava_name = "M19C3L13_Naava"
	speech_chapter4_k2_Subtitle_Text_107 = "You're worse than the Fallen."
	speech_chapter4_k2_M20C1L01_Naava_name = "M20C1L01_Naava"
	speech_chapter4_k2_Subtitle_Text_108 = "He has yet to return."
	speech_chapter4_k2_M20C1L02_Melchior_name = "M20C1L02_Melchior"
	speech_chapter4_k2_Subtitle_Text_109 = "I will find him."
	speech_chapter4_k2_M20C1L03_Naava_name = "M20C1L03_Naava"
	speech_chapter4_k2_Subtitle_Text_110 = "Even if you were able, why should I trust you to do so?"
	speech_chapter4_k2_M20C1L04_Melchior_name = "M20C1L04_Melchior"
	speech_chapter4_k2_Subtitle_Text_111 = "You know that there is no one who tracks as well as me.  As for trust, you don't have a choice..."
	speech_chapter4_k2_M20C1L05_Naava_name = "M20C1L05_Naava"
	speech_chapter4_k2_Subtitle_Text_112 = "If you fail to bring him back, Melchior, you will learn that cleansing can seem a mercy.  I will wait at the crossing of the river Alsaar."
	speech_chapter4_k2_M20C1L06_Melchior_name = "M20C1L06_Melchior"
	speech_chapter4_k2_Subtitle_Text_113 = "I will be there."
	speech_chapter4_k2_M20C2L01_Melchior_name = "M20C2L01_Melchior"
	speech_chapter4_k2_Subtitle_Text_114 = "He's close.  It's not far from here that he fell."
	speech_chapter4_k2_M20C3L01_Sijansur_name = "M20C3L01_Sijansur"
	speech_chapter4_k2_Subtitle_Text_115 = "Leave me be, Melchior!"
	speech_chapter4_k2_M20C3L02_Melchior_name = "M20C3L02_Melchior"
	speech_chapter4_k2_Subtitle_Text_116 = "Damn the fool and damn me for unleashing him.  He won't get far.  I can only hope he'll listen to reason."
	speech_chapter5_k2_narrator_ch5_name = "Chapter 5 Narration"
	speech_chapter5_k2_Subtitle_Text = "With old hatreds burning and the new flames of the Fallen threatening to consume the world, the ever-growing might of the Shadow seems irresistible.  Yet for Jonas, Naava, and Melchior, each destined to a special doom, surrender and despair are not options to consider.  Instead, they must bear their burdens farther into the West, where Darius Javidan and his Royalists await word of the coming darkness."
	speech_chapter5_k2_CH5L01_Sijansur_name = "CH5L01_Sijansur"
	speech_chapter5_k2_Subtitle_Text_2 = "Melchior!  Look upon your brother's face and tremble!"
	speech_chapter5_k2_CH5L02_Melchior_name = "CH5L02_Melchior"
	speech_chapter5_k2_Subtitle_Text_3 = "Sijansur is no more!  You are Jonas Teramun of the Council!"
	speech_chapter5_k2_CH5L03_Jonas_name = "CH5L03_Jonas"
	speech_chapter5_k2_Subtitle_Text_4 = "I am Sijansur."
	speech_chapter5_k2_CH5L04_Melchior_name = "CH5L04_Melchior"
	speech_chapter5_k2_Subtitle_Text_5 = "Fool!  When we were cast out, we had no choice.  But today you do..."
	speech_chapter5_k2_CH5L05_Sijansur_name = "CH5L05_Sijansur"
	speech_chapter5_k2_Subtitle_Text_6 = "I... There is no choice, Melchior, only fate!"
	speech_chapter5_k2_CH5L06_Melchior_name = "CH5L06_Melchior"
	speech_chapter5_k2_Subtitle_Text_7 = "No!  If we cannot choose then we are slaves!  If our destiny is already woven, then let me cut the cloth of fate!"
	speech_chapter5_k2_CH5L07_Melchior_name = "CH5L07_Melchior"
	speech_chapter5_k2_Subtitle_Text_8 = "Rest, my brother."
	speech_chapter5_k2_M21C1L01_Melchior_name = "M21C1L01_Melchior"
	speech_chapter5_k2_Subtitle_Text_9 = "She said she would be here."
	speech_chapter5_k2_M21C1L02_Jonas_name = "M21C1L02_Jonas"
	speech_chapter5_k2_Subtitle_Text_10 = "If the Shadow has her -"
	speech_chapter5_k2_M21C1L03_Melchior_name = "M21C1L03_Melchior"
	speech_chapter5_k2_Subtitle_Text_11 = "Do not despair.  Naava is not yet lost.  The Shadow has a fortress not far from here.  If they have her, she is there."
	speech_chapter5_k2_M21C2L01_Jonas_name = "M21C2L01_Jonas"
	speech_chapter5_k2_Subtitle_Text_12 = "She's not here!"
	speech_chapter5_k2_M21C2L02_Melchior_name = "M21C2L02_Melchior"
	speech_chapter5_k2_Subtitle_Text_13 = "The better for her.  The dungeons of the Fallen are no place for a Seeker.  She cannot be far, we must scout this area."
	speech_chapter5_k2_M21C3L01_Naava_name = "M21C3L01_Naava"
	speech_chapter5_k2_Subtitle_Text_14 = "Jonas, you - Are... are you all right?"
	speech_chapter5_k2_M21C3L02_Jonas_name = "M21C3L02_Jonas"
	speech_chapter5_k2_Subtitle_Text_15 = "I am.  It seems that fortune smiles upon us both.  What happened?"
	speech_chapter5_k2_M21C3L03_Naava_name = "M21C3L03_Naava"
	speech_chapter5_k2_Subtitle_Text_16 = "The Shadow's forces fell upon us at the rivers, but we were able to cross and escape.  Since then, they have been hounding us relentlessly.  What of you?"
	speech_chapter5_k2_M21C3L04_Jonas_name = "M21C3L04_Jonas"
	speech_chapter5_k2_Subtitle_Text_17 = "My past is mine again.  But I am still Jonas."
	speech_chapter5_k2_M21C3L05_Naava_name = "M21C3L05_Naava"
	speech_chapter5_k2_Subtitle_Text_18 = "I am sorry.  For not telling you..."
	speech_chapter5_k2_M21C3L06_Jonas_name = "M21C3L06_Jonas"
	speech_chapter5_k2_Subtitle_Text_19 = "There is no time or need for apologies."
	speech_chapter5_k2_M21C3L07_Melchior_name = "M21C3L07_Melchior"
	speech_chapter5_k2_Subtitle_Text_20 = "Come.  The hero of the Great War awaits."
	speech_chapter5_k2_M22C1L01_Human_name = "M22C1L01_Human"
	speech_chapter5_k2_Subtitle_Text_21 = "King Darius, emissaries from the Regent and the Council, Naava Daishan and Jonas Teramun."
	speech_chapter5_k2_M22C1L02_Naava_name = "M22C1L02_Naava"
	speech_chapter5_k2_Subtitle_Text_22 = "Judging by these armies, it seems you already know our message - The Fallen have overrun our lands and destroyed our forces."
	speech_chapter5_k2_M22C1L03_Jonas_name = "M22C1L03_Jonas"
	speech_chapter5_k2_Subtitle_Text_23 = "And now they move against you."
	speech_chapter5_k2_M22C1L04_Darius_name = "M22C1L04_Darius"
	speech_chapter5_k2_Subtitle_Text_24 = "Yes.  Roxanna foresaw the coming darkness.  We are ready to meet it."
	speech_chapter5_k2_M22C1L05_Melchior_name = "M22C1L05_Melchior"
	speech_chapter5_k2_Subtitle_Text_25 = "Then you know that the Guardians mean to destroy Khaldun?"
	speech_chapter5_k2_M22C1L06_Naava_name = "M22C1L06_Naava"
	speech_chapter5_k2_Subtitle_Text_26 = "If we do not swiftly defeat the Shadow, they will unleash a new Cataclysm."
	speech_chapter5_k2_M22C1L07_Darius_name = "M22C1L07_Darius"
	speech_chapter5_k2_Subtitle_Text_27 = "Then we must bring the battle to the Shadow."
	speech_chapter5_k2_M22C1L08_Naava_name = "M22C1L08_Naava"
	speech_chapter5_k2_Subtitle_Text_28 = "What would you have of us?"
	speech_chapter5_k2_M22C1L09_Darius_name = "M22C1L09_Darius"
	speech_chapter5_k2_Subtitle_Text_29 = "We must close the Rifts that have been supplying Abaddon's army. Naava, your particular gifts are well suited to this task.  Now come.  There are Haroun who have traveled from the Waste itself to join this battle.  You will need their speed to attack the Rifts and avoid the main army."
	speech_chapter5_k2_M22C1.5L01_Melchior_name = "M22C1.5L01_Melchior"
	speech_chapter5_k2_Subtitle_Text_30 = "Attacking the Shadow cities was not wise, now we must prepare for a counterattack."
	speech_chapter5_k2_M22C2L01_Darius_name = "M22C2L01_Darius"
	speech_chapter5_k2_Subtitle_Text_31 = "Come and meet your destruction, Shadowspawn."
	speech_chapter5_k2_M22C2L02_Abaddon_name = "M22C2L02_Abaddon"
	speech_chapter5_k2_Subtitle_Text_32 = "If you want me, come to the Waste!"
	speech_chapter5_k2_M22C3L01_Naava_name = "M22C3L01_Naava"
	speech_chapter5_k2_Subtitle_Text_33 = "It seems victory is ours."
	speech_chapter5_k2_M22C3L02_Melchior_name = "M22C3L02_Melchior"
	speech_chapter5_k2_Subtitle_Text_34 = "Save that Abaddon escaped and almost certainly summons forth more demons to fill his ranks."
	speech_chapter5_k2_M22C3L03_Darius_name = "M22C3L03_Darius"
	speech_chapter5_k2_Subtitle_Text_35 = "Thank you for your aid today."
	speech_chapter5_k2_M22C3L04_Naava_name = "M22C3L04_Naava"
	speech_chapter5_k2_Subtitle_Text_36 = "No thanks are necessary.  We fight for all Khaldun."
	speech_chapter5_k2_M22C3L05_Darius_name = "M22C3L05_Darius"
	speech_chapter5_k2_Subtitle_Text_37 = "Then I ask you to fight once more.  Return to the Council lands and open a second front.  Divert the Shadow's army."
	speech_chapter5_k2_M22C3L06_Melchior_name = "M22C3L06_Melchior"
	speech_chapter5_k2_Subtitle_Text_38 = "While you do what?"
	speech_chapter5_k2_M22C3L07_Darius_name = "M22C3L07_Darius"
	speech_chapter5_k2_Subtitle_Text_39 = "Roxanna and I will fight our way into the Waste... to the Well."
	speech_chapter5_k2_M22C3L08_Melchior_name = "M22C3L08_Melchior"
	speech_chapter5_k2_Subtitle_Text_40 = "Then what?  Beside the Well, Abaddon will be at his strongest.  You go to your doom."
	speech_chapter5_k2_M22C3L09_Roxanna_name = "M22C3L09_Roxanna"
	speech_chapter5_k2_Subtitle_Text_41 = "We have no choice.   As long as the Well remains, the Shadow will be able to seep into Khaldun.  I must go and destroy it."
	speech_chapter5_k2_M22C3L10_Naava_name = "M22C3L10_Naava"
	speech_chapter5_k2_Subtitle_Text_42 = "Destroy it?  Is that possible?"
	speech_chapter5_k2_M22C3L11_Roxanna_name = "M22C3L11_Roxanna"
	speech_chapter5_k2_Subtitle_Text_43 = "During my time as Ahriman's thrall, I learned many of the Shadow's secrets.  I will be able to destroy the Well."
	speech_chapter5_k2_M22C3L12_Darius_name = "M22C3L12_Darius"
	speech_chapter5_k2_Subtitle_Text_44 = "But for us to have any hope of defeating Abaddon, you must draw as much of his army away from the Waste as is possible.  Can you do this?"
	speech_chapter5_k2_M22C3L13_Jonas_name = "M22C3L13_Jonas"
	speech_chapter5_k2_Subtitle_Text_45 = "Of course."
	speech_chapter5_k2_M22C3L14_Darius_name = "M22C3L14_Darius"
	speech_chapter5_k2_Subtitle_Text_46 = "Then may the Light of the Creator be with you."
	speech_chapter5_k2_M23C1L01_Jonas_name = "M23C1L01_Jonas"
	speech_chapter5_k2_Subtitle_Text_47 = "Rhusk was the jewel of the south.  There were thousands of people here!"
	speech_chapter5_k2_M23C1L02_Melchior_name = "M23C1L02_Melchior"
	speech_chapter5_k2_Subtitle_Text_48 = "Which means the ranks of the Undead are now swollen thick."
	speech_chapter5_k2_M23C1L03_Naava_name = "M23C1L03_Naava"
	speech_chapter5_k2_Subtitle_Text_49 = "Do we assume that the Council is utterly defeated, then?"
	speech_chapter5_k2_M23C1L04_Jonas_name = "M23C1L04_Jonas"
	speech_chapter5_k2_Subtitle_Text_50 = "Chancellor Sakeri would never have allowed Rhusk to fall if he were still alive."
	speech_chapter5_k2_M23C1L05_Melchior_name = "M23C1L05_Melchior"
	speech_chapter5_k2_Subtitle_Text_51 = "Ravid has always been a cagey leader.  He may yet live."
	speech_chapter5_k2_M23C1L06_Ravid_name = "M23C1L06_Ravid"
	speech_chapter5_k2_Subtitle_Text_52 = "I live... though not by any cleverness.  In my folly, I attacked the Shadow, even while its armies flanked and burned the city."
	speech_chapter5_k2_M23C1L07_Ravid_name = "M23C1L07_Ravid"
	speech_chapter5_k2_Subtitle_Text_53 = "We fought them in the mountains, then in the valleys, always being pushed back. We withdrew to Rhusk and found the city in ruins.  We made for the hills... but for what?"
	speech_chapter5_k2_M23C1L08_Jonas_name = "M23C1L08_Jonas"
	speech_chapter5_k2_Subtitle_Text_54 = "You live and so do we.  And as long as that is so, the Shadow has not won."
	speech_chapter5_k2_M23C1L09_Ravid_name = "M23C1L09_Ravid"
	speech_chapter5_k2_Subtitle_Text_55 = "Yes, but even now the Shadow bears down upon us."
	speech_chapter5_k2_M23C1L10_Naava_name = "M23C1L10_Naava"
	speech_chapter5_k2_Subtitle_Text_56 = "Jonas, we must fall back."
	speech_chapter5_k2_M23C1L11_Jonas_name = "M23C1L11_Jonas"
	speech_chapter5_k2_Subtitle_Text_57 = "We will not retreat."
	speech_chapter5_k2_M23C1L12_Melchior_name = "M23C1L12_Melchior"
	speech_chapter5_k2_Subtitle_Text_58 = "This is madness, Jonas, not courage."
	speech_chapter5_k2_M23C1L13_Jonas_name = "M23C1L13_Jonas"
	speech_chapter5_k2_Subtitle_Text_59 = "It is neither.  Any army that attacks here cannot attack Darius.  If Khaldun is to survive, it will be because our deaths turned the Shadow's attention away from the Waste, toward Rhusk."
	speech_chapter5_k2_M23C1L14_Jonas_name = "M23C1L14_Jonas"
	speech_chapter5_k2_Subtitle_Text_60 = "Do whatever you can to repair the walls.  Melchior, we will need reconnaissance.  There is no time to waste."
	speech_chapter5_k2_M23CAL01_Melchior_name = "M23C1.5L01_Melchior"
	speech_chapter5_k2_Subtitle_Text_61 = "Ready yourselves!  A massive army of the Fallen is approaching."
	speech_chapter5_k2_M23C2L01_Xander_name = "M23C2L01_Xander"
	speech_chapter5_k2_Subtitle_Text_62 = "Jonas!  I promised we would come when needed.  The might of Elagor fights for the Kohan once more!"
	speech_chapter5_k2_M23C3L01_Agborus_name = "M23C3L01_Agborus"
	speech_chapter5_k2_Subtitle_Text_63 = "We have come, with axe and hammer, for our allegiance is as unbreakable as stone!"
	speech_chapter5_k2_M23C4L01_Thurak_name = "M23C4L01_Thurak"
	speech_chapter5_k2_Subtitle_Text_64 = "Our hunt leads us here!  The great brotherhood of the Drauga and Kohan is reborn.  May the battle be glorious!"
	speech_chapter5_k2_M23C5L01_Ravid_name = "M23C5L01_Ravid"
	speech_chapter5_k2_Subtitle_Text_65 = "Victory is ours."
	speech_chapter5_k2_M23C5L02_Naava_name = "M23C5L02_Naava"
	speech_chapter5_k2_Subtitle_Text_66 = "Thank the Creator."
	speech_chapter5_k2_M23C5L03_Melchior_name = "M23C5L03_Melchior"
	speech_chapter5_k2_Subtitle_Text_67 = "Long years have passed since I could echo that sentiment.  But thank him indeed, if his hand was here today."
	speech_chapter5_k2_M23C5L04_Jonas_name = "M23C5L04_Jonas"
	speech_chapter5_k2_Subtitle_Text_68 = "There is no time for rest or celebration.  We must make our way to the Waste, where Darius and Abaddon await."
	speech_chapter5_k2_M24C1L01_EvilWhisper_name = "M24C1L01_EvilWhisper"
	speech_chapter5_k2_Subtitle_Text_69 = "[EVIL WHISPERING]"
	speech_chapter5_k2_M24C1L02_Melchior_name = "M24C1L02_Melchior"
	speech_chapter5_k2_Subtitle_Text_70 = "You.  Tired of Sebak's whining are you?"
	speech_chapter5_k2_M24C1L03_EvilWhisper_name = "M24C1L03_EvilWhisper"
	speech_chapter5_k2_Subtitle_Text_71 = "[EVIL WHISPERING]"
	speech_chapter5_k2_M24C1L04_Melchior_name = "M24C1L04_Melchior"
	speech_chapter5_k2_Subtitle_Text_72 = "Kill them?  To rule over a dying world, with nothing but vile beasts to lick my boots?"
	speech_chapter5_k2_M24C1L05_EvilWhisper_name = "M24C1L05_EvilWhisper"
	speech_chapter5_k2_Subtitle_Text_73 = "[EVIL WHISPERING]"
	speech_chapter5_k2_M24C1L06_Melchior_name = "M24C1L06_Melchior"
	speech_chapter5_k2_Subtitle_Text_74 = "You know much, including the secrets of my dark past.  But you do not know me!"
	speech_chapter5_k2_M24C1L07_Melchior_name = "M24C1L07_Melchior"
	speech_chapter5_k2_Subtitle_Text_75 = "Ages ago you took my honor, my name, my friends... my face.  I will give you no more.  Tomorrow, I will cut your captains down and end your dreams of befouling this world."
	speech_chapter5_k2_M24C1L08_EvilWhisper_name = "M24C1L08_EvilWhisper"
	speech_chapter5_k2_Subtitle_Text_76 = "[EVIL WHISPERING]"
	speech_chapter5_k2_M24C1L09_Jonas_name = "M24C1L09_Jonas"
	speech_chapter5_k2_Subtitle_Text_77 = "Who were you talking to, Melchior?"
	speech_chapter5_k2_M24C1L10_Melchior_name = "M24C1L10_Melchior"
	speech_chapter5_k2_Subtitle_Text_78 = "No one.  Go to sleep.  We'll need our strength tomorrow."
	speech_chapter5_k2_M24C1L11_Jonas_name = "M24C1L11_Jonas"
	speech_chapter5_k2_Subtitle_Text_79 = "Today we fight to reach the side of Darius Javidan.  You who do not know him, know his name.  He is the champion of the Great War, the bane of the Shadow.  By his side, we will drive the Fallen into the Abyss and seal it behind them.  Each of you has but a single life, yet you risk it in this distant land.  It is bravery in the face of death that will drive the Shadow back to its pit, for those who live in the dark cannot imagine the courage that burns in your hearts.  Now... let us show them their folly!"
	speech_chapter5_k2_M24C2L01_Melchior_name = "M24C2L01_Melchior"
	speech_chapter5_k2_Subtitle_Text_80 = "Riders approach."
	speech_chapter5_k2_M24C2L02_Jamsheed_name = "M24C2L02_Jamsheed"
	speech_chapter5_k2_Subtitle_Text_81 = "I bring dire news."
	speech_chapter5_k2_M24C2L03_Jonas_name = "M24C2L03_Jonas"
	speech_chapter5_k2_Subtitle_Text_82 = "What is it?"
	speech_chapter5_k2_M24C2L04_Jamsheed_name = "M24C2L04_Jamsheed"
	speech_chapter5_k2_Subtitle_Text_83 = "Two days ago, a huge Shadow army fell upon us.  Abaddon split our armies in two.  We were cut off from Darius and forced to watch the battle from afar.  There is no chance that Darius will defeat this army today, or tomorrow, or any day soon.  It will be a long, bloody battle before he is through."
	speech_chapter5_k2_M24C2L05_Naava_name = "M24C2L05_Naava"
	speech_chapter5_k2_Subtitle_Text_84 = "But if the Shadow is not defeated soon..."
	speech_chapter5_k2_M24C2L06_Melchior_name = "M24C2L06_Melchior"
	speech_chapter5_k2_Subtitle_Text_85 = "...then the Guardians will destroy Khaldun."
	speech_chapter5_k2_M24C2L07_Jonas_name = "M24C2L07_Jonas"
	speech_chapter5_k2_Subtitle_Text_86 = "What of the Well itself?  How can we destroy it?"
	speech_chapter5_k2_M24C2L08_Naava_name = "M24C2L08_Naava"
	speech_chapter5_k2_Subtitle_Text_87 = "I may be able to destroy it, if I had enough power to draw upon."
	speech_chapter5_k2_M24C2L09_Melchior_name = "M24C2L09_Melchior"
	speech_chapter5_k2_Subtitle_Text_88 = "May be able to?"
	speech_chapter5_k2_M24C2L10_Naava_name = "M24C2L10_Naava"
	speech_chapter5_k2_Subtitle_Text_89 = "Few have ever wielded as much power as I fear I will need."
	speech_chapter5_k2_M24C2L11_Jonas_name = "M24C2L11_Jonas"
	speech_chapter5_k2_Subtitle_Text_90 = "We have no choice."
	speech_chapter5_k2_M24C2L12_Melchior_name = "M24C2L12_Melchior"
	speech_chapter5_k2_Subtitle_Text_91 = "Or, what choice we had, we already made."
	speech_chapter5_k2_M25C1L01_Melchior_name = "M25C1L01_Melchior"
	speech_chapter5_k2_Subtitle_Text_92 = "Something is coming!  Arm yourselves!"
	speech_chapter5_k2_M25C1L02_Abaddon_name = "M25C1L02_Abaddon"
	speech_chapter5_k2_Subtitle_Text_93 = "This is the best you could bring?"
	speech_chapter5_k2_M25C1L03_Abaddon_name = "M25C1L03_Abaddon"
	speech_chapter5_k2_Subtitle_Text_94 = "Bow down before me!"
	speech_chapter5_k2_M25C2L01_Melchior_name = "M25C2L01_Melchior"
	speech_chapter5_k2_Subtitle_Text_95 = "He moves back to the Well."
	speech_chapter5_k2_M25C2L02_Human_name = "M25C2L02_Human"
	speech_chapter5_k2_Subtitle_Text_96 = "How can we face that?  To fight that means certain death, we should flee the field and regroup..."
	speech_chapter5_k2_M25C2L03_Melchior_name = "M25C2L03_Melchior"
	speech_chapter5_k2_Subtitle_Text_97 = "Do you think he will show you mercy when he comes for you in your homes?  That he will spare your children if you turn and run?"
	speech_chapter5_k2_M25C2L04_Gauri_name = "M25C2L04_Gauri"
	speech_chapter5_k2_Subtitle_Text_98 = "You need not fear death, Immortal.  One ritual and back you spring."
	speech_chapter5_k2_M25C2L05_Melchior_name = "M25C2L05_Melchior"
	speech_chapter5_k2_Subtitle_Text_99 = "True.  So unlike you, we will have no escape from the conquering Shadow.  Instead, we will have an eternity of suffering, as Khaldun rots and crumbles, as all the works of mortal and Kohan alike are torn down, and the Light of the world is extinguished."
	speech_chapter5_k2_M25C2L06_Melchior_name = "M25C2L06_Melchior"
	speech_chapter5_k2_Subtitle_Text_100 = "All while you rest in peace."
	speech_chapter5_k2_M25C2L07_Jonas_name = "M25C2L07_Jonas"
	speech_chapter5_k2_Subtitle_Text_101 = "Enough!"
	speech_chapter5_k2_M25C2L08_Jonas_name = "M25C2L08_Jonas"
	speech_chapter5_k2_Subtitle_Text_102 = "Soldiers of Khaldun, warriors of the Light: You are Human, Gauri, Drauga, and Haroun; soldiers of all factions, even Ceyah. None can stand aside today."
	speech_chapter5_k2_M25C2L09_Naava_name = "M25C2L09_Naava"
	speech_chapter5_k2_Subtitle_Text_103 = "We have all fought to reach here, fought to the brink of doom.  And now, with the Shadow rising before us, you must fight once more.  Many of you, perhaps all, will die.  And we may fall beside you."
	speech_chapter5_k2_M25C2L10_Jonas_name = "M25C2L10_Jonas"
	speech_chapter5_k2_Subtitle_Text_104 = "But there is a spark of a chance.  Faint is this spark, but it is there all the same.  With all the courage and sacrifice of mortal lives and all the ancient honor of the Kohan, we will kindle that spark until its flames burn the Shadow from the field of battle!"
	speech_chapter5_k2_M25C2L11_Naava_name = "M25C2L11_Naava"
	speech_chapter5_k2_Subtitle_Text_105 = "For the Light of the Creator!"
	speech_chapter5_k2_M25C2L12_Cheers_name = "M25C2L12_Cheers"
	speech_chapter5_k2_Subtitle_Text_106 = "For the Light!"
	speech_chapter5_k2_M25C3L01_Naava_name = "M25C3L01_Naava"
	speech_chapter5_k2_Subtitle_Text_107 = "For me to have the power to close the Well, we must take control of the three Mana Fonts near here."
	speech_chapter5_k2_M25C4L01_Melchior_name = "M25C4L01_Melchior"
	speech_chapter5_k2_Subtitle_Text_108 = "The first Font is ours!  We must reach the other two!"
	speech_chapter5_k2_M25C5L01_Jonas_name = "M25C5L01_Jonas"
	speech_chapter5_k2_Subtitle_Text_109 = "Only one more!  Onward, soldiers of Khaldun!"
	speech_chapter5_k2_M25C6L01_Naava_name = "M25C6L01_Naava"
	speech_chapter5_k2_Subtitle_Text_110 = "The Fonts have been opened to me.  My body surges with power.  Jonas, we must take the Well now, and destroy it - I cannot hold on much longer."
	speech_chapter5_k2_M25C7L01_Abaddon_name = "M25C7L01_Abaddon"
	speech_chapter5_k2_Subtitle_Text_111 = "Do you truly think that you have a chance against me?"
	speech_chapter5_k2_M25C7L02_Melchior_name = "M25C7L02_Melchior"
	speech_chapter5_k2_Subtitle_Text_112 = "Even now, Sebak, your dreams outstrip reality."
	speech_chapter5_k2_M25C8L01_Abaddon_name = "M25C8L01_Abaddon"
	speech_chapter5_k2_Subtitle_Text_113 = "Your victory is fleeting, Kohan.  The Shadow will never leave this world."
	speech_chapter5_k2_M25C9L01_Naava_name = "M25C9L01_Naava"
	speech_chapter5_k2_Subtitle_Text_114 = "I must act now.  I can barely hold onto the power..."
	speech_chapter5_k2_M25C9L02_Naava_name = "M25C9L02_Naava"
	speech_chapter5_k2_Subtitle_Text_115 = "Farewell Jonas, Melchior."
	speech_chapter5_k2_M25C9L03_Jonas_name = "M25C9L03_Jonas"
	speech_chapter5_k2_Subtitle_Text_116 = "Farewell?"
	speech_chapter5_k2_M25C9L04_Naava_name = "M25C9L04_Naava"
	speech_chapter5_k2_Subtitle_Text_117 = "The Flows are too strong for me to control.  Whatever secret Roxanna knows, I do not.  I will not survive."
	speech_chapter5_k2_M25C9L05_Jonas_name = "M25C9L05_Jonas"
	speech_chapter5_k2_Subtitle_Text_118 = "Your amulet will preserve you."
	speech_chapter5_k2_M25C9L06_Naava_name = "M25C9L06_Naava"
	speech_chapter5_k2_Subtitle_Text_119 = "The power needed to close the Well is immense.  Enough to destroy even my amulet."
	speech_chapter5_k2_M25C9L07_Jonas_name = "M25C9L07_Jonas"
	speech_chapter5_k2_Subtitle_Text_120 = "You cannot! We must wait!  There is still time!"
	speech_chapter5_k2_M25C9L08_Naava_name = "M25C9L08_Naava"
	speech_chapter5_k2_Subtitle_Text_121 = "No, Jonas... there is not.  The Guardians are speaking to each other through the Flows.  Even now, they gather to unmake our world."
	speech_chapter5_k2_M25C9L09_Jonas_name = "M25C9L09_Jonas"
	speech_chapter5_k2_Subtitle_Text_122 = "We can find them... stop them!"
	speech_chapter5_k2_M25C9L10_Naava_name = "M25C9L10_Naava"
	speech_chapter5_k2_Subtitle_Text_123 = "No.  I am ready.  My whole life was spent in service of the Light.  This is the last step on that road..."
	speech_chapter5_k2_M25C9L11_Jonas_name = "M25C9L11_Jonas"
	speech_chapter5_k2_Subtitle_Text_124 = "No."
	speech_chapter5_k2_M25C9L12_Naava_name = "M25C9L12_Naava"
	speech_chapter5_k2_Subtitle_Text_125 = "Yes."
	speech_chapter5_k2_M25C9L13_Jonas_name = "M25C9L13_Jonas"
	speech_chapter5_k2_Subtitle_Text_126 = "She's gone."
	speech_chapter5_k2_M25C9L14_Melchior_name = "M25C9L14_Melchior"
	speech_chapter5_k2_Subtitle_Text_127 = "Now, I too, must go."
	speech_chapter5_k2_M25C9L15_Jonas_name = "M25C9L15_Jonas"
	speech_chapter5_k2_Subtitle_Text_128 = "And leave me the glory?"
	speech_chapter5_k2_M25C9L16_Melchior_name = "M25C9L16_Melchior"
	speech_chapter5_k2_Subtitle_Text_129 = "You deserve it more than I."
	speech_chapter5_k2_M25C9L17_Jonas_name = "M25C9L17_Jonas"
	speech_chapter5_k2_Subtitle_Text_130 = "She deserves it most.  Stay and honor her."
	speech_chapter5_k2_M25C9L18_Melchior_name = "M25C9L18_Melchior"
	speech_chapter5_k2_Subtitle_Text_131 = "You know that there is no place for a Ceyah here, and I will not accept their salvation.  I must go, but we will meet again... old friend."
	speech_tutorial1_k2_T1L01_Tutor_name = "T1L01_Tutor"
	speech_tutorial1_k2_Subtitle_Text = "The immortal Kohan have known peace for only a short time.  The Great War ended when a band of Kohan warriors defeated the Dark Lord Ahriman and his tainted followers, the Ceyah.  Now, the Kohan must rebuild their ruined castles and return order to their war torn kingdoms."
	speech_tutorial1_k2_T1L02_Tutor_name = "T1L02_Tutor"
	speech_tutorial1_k2_Subtitle_Text_2 = "Before you is the young Kohan hero Jonas Teramun.  Recently awakened after falling in the Great War, he has not yet regained his memories.  Ravid Sakeri, leader of the Council faction, has taken it upon himself to retrain Jonas and hopefully return his lost memories."
	speech_tutorial1_k2_T1L03_Ravid_name = "T1L03_Ravid"
	speech_tutorial1_k2_Subtitle_Text_3 = "Jonas, the Council needs you to help rebuild homes lost in the Great War.  Take these pioneers and find a place to settle.  I will return when you have finished your task."
	speech_tutorial1_k2_T1L04_Tutor_name = "T1L04_Tutor"
	speech_tutorial1_k2_Subtitle_Text_4 = "The easiest way to expand your kingdom is to explore the surrounding area looking for settlement spots, such as the one visible to your East.  Be aware though, that settlement spots are occupied by monster camps.  You must first clear these camps before building a new settlement.  Ravid is clearing the first monster camp for you, leaving you a perfect spot to construct your first settlement."
	speech_tutorial1_k2_T1L05_Tutor_name = "T1L05_Tutor"
	speech_tutorial1_k2_Subtitle_Text_5 = "Every race has its own settler unit that is capable of constructing new villages.  Before you is a company of settlers led by Jonas Teramun.  To select this company, left-click its banner or any one of its units."
	speech_tutorial1_k2_T1L06_Tutor_name = "T1L06_Tutor"
	speech_tutorial1_k2_Subtitle_Text_6 = "Good, the settler company is now selected.  Let's move the settlers to the cleared settlement spot.  Moving is accomplished by clicking the Move button in the lower right interface, then left-clicking at the desired destination."
	speech_tutorial1_k2_T1L07_Tutor_name = "T1L07_Tutor"
	speech_tutorial1_k2_Subtitle_Text_7 = "To build your new village, make sure the settlers are selected and right-click on the settlement spot."
	speech_tutorial1_k2_T1L08_Tutor_name = "T1L08_Tutor"
	speech_tutorial1_k2_Subtitle_Text_8 = "You should now see the settlers begin construction on the new village center.  The ground around the settlement spot has changed to show you the area that the new settlement will occupy.  When the settlers are finished building the village center, the entire company will enter the new settlement to become its workforce."
	speech_tutorial1_k2_T1L09_Ravid_name = "T1L09_Ravid"
	speech_tutorial1_k2_Subtitle_Text_9 = "Good work Jonas!  With your help, the Council lands will rebuild to their former strength in short order.  We are in need of stone resources, so constructing a quarry is your first priority.  I will be scouting the area in search of additional resources and potential enemies."
	speech_tutorial1_k2_T1L10_Tutor_name = "T1L10_Tutor"
	speech_tutorial1_k2_Subtitle_Text_10 = "As you can see, your new village looks pretty bare.  Ravid asked Jonas to build a quarry, one of the many structures a settlement can contain.  Structures are special buildings that can only be built inside settlements.  They provide the kingdom with income, resources, and the ability to recruit new units.  Go ahead and select the village center."
	speech_tutorial1_k2_T1L11_Tutor_name = "T1L11_Tutor"
	speech_tutorial1_k2_Subtitle_Text_11 = "Now that the settlement is selected, you should see that the object display in the bottom center of your screen has changed.  So have your available action buttons.  A village can hold only one structure.  This is shown by the number of structure slots appearing in the object display.  To build a new structure, simply click on an empty slot or on the Build button."
	speech_tutorial1_k2_T1L12_Tutor_name = "T1L12_Tutor"
	speech_tutorial1_k2_Subtitle_Text_12 = "The structures available to build should now be visible in the lower right display.  Click on the quarry button to place a new quarry in the village."
	speech_tutorial1_k2_T1L13_Tutor_name = "T1L13_Tutor"
	speech_tutorial1_k2_Subtitle_Text_13 = "The quarry will now be placed for construction within the village boundries."
	speech_tutorial1_k2_T1L14_Tutor_name = "T1L14_Tutor"
	speech_tutorial1_k2_Subtitle_Text_14 = "Good.  The village center should have sent out workers to build the quarry for you.  Workers exist inside the settlement center and are responsible for all the construction and repairs associated with the settlement.  Workers will automatically repair any damaged building for you."
	speech_tutorial1_k2_T1L15_Tutor_name = "T1L15_Tutor"
	speech_tutorial1_k2_Subtitle_Text_15 = "The quarry is now complete.  Quarries produce stone resources for your kingdom's economy.  You should see a positive stone income in the economy bar at the top of the screen.  This means that your kingdom can now support the displayed amount of stone in upkeep."
	speech_tutorial1_k2_T1L16_Tutor_name = "T1L16_Tutor"
	speech_tutorial1_k2_Subtitle_Text_16 = "Upkeep is the basis of a kingdom's economy.  Most units and some buildings will require resources to stay in service.  In order to use them, your kingdom will need to produce enough resources to compensate for those used to upkeep units and buildings.  Resources primarily come from structures like the quarry and from mines found near your kingdom."
	speech_tutorial1_k2_T1L17_Tutor_name = "T1L17_Tutor"
	speech_tutorial1_k2_Subtitle_Text_17 = "The most important resource to pay attention to is your kingdom's gold production.  Gold is the only resource that stockpiles and is used to pay for all unit recruitment and building construction."
	speech_tutorial1_k2_T1L18_Tutor_name = "T1L18_Tutor"
	speech_tutorial1_k2_Subtitle_Text_18 = "It would be good for Jonas's new village to produce more gold.  But as you can see, there are no more structure slots available.  In order to gain more, the village must be upgraded into a town.  To do this, you must first select the town center."
	speech_tutorial1_k2_T1L19_Tutor_name = "T1L19_Tutor"
	speech_tutorial1_k2_Subtitle_Text_19 = "Okay, the settlement is selected.  Look at the action buttons.  The upgrade button should be visible now.  A settlement can only be upgraded when all its structure slots are filled.  Go ahead and click on the upgrade button.  Remember you must also have enough gold in your stockpile to afford the upgrade."
	speech_tutorial1_k2_T1L20_Tutor_name = "T1L20_Tutor"
	speech_tutorial1_k2_Subtitle_Text_20 = "The workers should now be out upgrading the village center into a town.  When they are finished, the new town will provide Jonas's kingdom with additional gold and more places to build structures."
	speech_tutorial1_k2_T1L21_Ravid_name = "T1L21_Ravid"
	speech_tutorial1_k2_Subtitle_Text_21 = "Jonas, I see that you have things well in hand here.  My scouting has also been profitable.  An iron ore resource was found just East of this very settlement.  I have sent a company of engineers to take advantage of this boon.  I will continue my reconnaissance of the area and return later."
	speech_tutorial1_k2_T1L22_Tutor_name = "T1L22_Tutor"
	speech_tutorial1_k2_Subtitle_Text_22 = "Here are the engineers.  Engineers are the only units capable of building outside of the settlement, that includes building mines on resources found in the wilderness.  Mines are another way to produce additional resources for your kingdom. Go ahead and select the engineers."
	speech_tutorial1_k2_T1L23_Tutor_name = "T1L23_Tutor"
	speech_tutorial1_k2_Subtitle_Text_23 = "Okay, now just South of the engineers is an iron ore resource.  To build a mine on this resource, click on the Build button in the lower right display."
	speech_tutorial1_k2_T1L24_Tutor_name = "T1L24_Tutor"
	speech_tutorial1_k2_Subtitle_Text_24 = "The available buttons have now changed to show what type of buildings the engineers can construct.  Click on the Build Iron Mine button.  Place it on the iron ore and left-click."
	speech_tutorial1_k2_T1L25_Tutor_name = "T1L25_Tutor"
	speech_tutorial1_k2_Subtitle_Text_25 = "The mine is now complete.  By looking at the Economy Bar you can see that your iron output has increased.  Every resource that you build a mine on will contribute to your kingdom's economy."
	speech_tutorial1_k2_T1L26_Ravid_name = "T1L26_Ravid"
	speech_tutorial1_k2_Subtitle_Text_26 = "It's a good thing the engineers are done here.  We need their help to the East.  A group of brigands have been marauding through the area and recently attacked one of our outposts.  We need the engineers to repair the damage and build a new outpost.  You must handle this task while my scouts search for the brigands' camp."
	speech_tutorial1_k2_T1L27_Tutor_name = "T1L27_Tutor"
	speech_tutorial1_k2_Subtitle_Text_27 = "The damaged outpost should be visible now.  The smoke and fire indicates that the outpost has taken damage.  Luckily, there are engineers close by.  Aside from building mines, engineers are also capable of repairing damaged buildings.  Select the engineers and click on the repair button.  Then left-click the damaged outpost."
	speech_tutorial1_k2_T1L28_Tutor_name = "T1L28_Tutor"
	speech_tutorial1_k2_Subtitle_Text_28 = "The engineers have finished repairing the outpost.  It is at full health now.  A clearing to the South should now be visible.  That should be a good place to build a new outpost.  Make sure the engineers are selected and access the build menu again.  Click on the Build Outpost button and place the new outpost in the middle of the clearing.  The engineers should move to the location and begin construction."
	speech_tutorial1_k2_T1L29_Tutor_name = "T1L29_Tutor"
	speech_tutorial1_k2_Subtitle_Text_29 = "The outpost has been completed.  As you can see, the outpost has made more of the map visible.  The outpost will automatically defend the area, sending out militia to fight any enemies that come near."
	speech_tutorial1_k2_T1L30_Ravid_name = "T1L30_Ravid"
	speech_tutorial1_k2_Subtitle_Text_30 = "Jonas!  We located the brigand camp, but were ambushed as we approached.  The fight was long and I lost some of my best scouts.  We fought hard though and the camp has been greatly weakened.  You must send the engineers against the camp and finish them off before they can regain their strength."
	speech_tutorial1_k2_T1L31_Tutor_name = "T1L31_Tutor"
	speech_tutorial1_k2_Subtitle_Text_31 = "You should see the brigand camp now, not too far from the engineer company.  Brigand camps are a type of monster lair.  Lairs contain dangerous enemies that will attack if you come near.  Some also send out units to rampage around the land, attacking at random."
	speech_tutorial1_k2_T1L32_Tutor_name = "T1L32_Tutor"
	speech_tutorial1_k2_Subtitle_Text_32 = "To attack the brigand camp, select the engineers and click on the Attack button.  Left-click on the brigand camp to issue an attack order against it.  The engineers will move to and attack the camp.  Once the militia are defeated, the engineers will automatically destroy the camp."
	speech_tutorial1_k2_T1L33_Tutor_name = "T1L33_Tutor"
	speech_tutorial1_k2_Subtitle_Text_33 = "The engineers were victorious, successfully defeating the brigands and demolishing the lair.  As a reward, some gold was found in the broken lair.  Most lairs will contain some form of reward that is gained when the lair is destroyed."
	speech_tutorial1_k2_T1L34_Tutor_name = "T1L34_Tutor"
	speech_tutorial1_k2_Subtitle_Text_34 = "Congratulations, you have completed the first tutorial in Kings of War."
	speech_tutorial2_k2_T2L01_Tutor_name = "T2L01_Tutor"
	speech_tutorial2_k2_Subtitle_Text = "Now that the hero Jonas has helped secure a new land for the Council, he has been summoned by Ravid to the city of Harad to train in military command and maneuvers."
	speech_tutorial2_k2_T2L02_Ravid_name = "T2L02_Ravid"
	speech_tutorial2_k2_Subtitle_Text_2 = "A clan of Drauga has moved into this land and is claiming it as its own.  Though we are not allies, we have been amiable neighbors for many years.  This act of hostility has deeply concerned the Council leaders.  We have been sent here to resolve the situation.  I will attempt a diplomatic solution and you will make preparations in case my mission fails.  I want you to recruit a company of Bowmen to shore up the city's defenses."
	speech_tutorial2_k2_T2L03_Tutor_name = "T2L03_Tutor"
	speech_tutorial2_k2_Subtitle_Text_3 = "Units can only be recruited from settlements.  To recruit any new units, you must first select a settlement you own and access its Recruit menu.  First select the city of Harad, then click on the Recruit button."
	speech_tutorial2_k2_T2L04_Tutor_name = "T2L04_Tutor"
	speech_tutorial2_k2_Subtitle_Text_4 = "The interface should have changed, updating the lower displays.  What you see in the lower display is the Favorites menu.  Each icon represents a company of units that can be recruited.  Hovering your cursor over an icon will bring up a tooltip describing the layout of the company."
	speech_tutorial2_k2_T2L05_Tutor_name = "T2L05_Tutor"
	speech_tutorial2_k2_Subtitle_Text_5 = "Now it's time to recruit the Bowmen that Ravid wanted.  To recruit a preset company of Bowmen, click the Bowman icon in the Favorites menu."
	speech_tutorial2_k2_T2L06_Tutor_name = "T2L06_Tutor"
	speech_tutorial2_k2_Subtitle_Text_6 = "Good work.  The captain for the Bowmen company has appeared inside the city walls and the Bowmen are starting to supply in.  It won't be long before the company is ready for battle."
	speech_tutorial2_k2_T2L07_Ravid_name = "T2L07_Ravid"
	speech_tutorial2_k2_Subtitle_Text_7 = "I see that you have kept busy.  We may need more than Bowmen now.  The talks have been going poorly.  The Drauga have been unwilling to listen to my offers of peace.  I do not understand the game they are playing.  You must ready more troops, conflict appears to be inevitable."
	speech_tutorial2_k2_T2L08_Tutor_name = "T2L08_Tutor"
	speech_tutorial2_k2_Subtitle_Text_8 = "Okay, as you have no doubt realized, when you recruit units they are automatically grouped into companies.  You cannot recruit individual units, though some special companies can have only one unit in them.  Take a look at the archer company.  It consists of a front line of archers and a captain to lead them.  This is the basic format of all companies.  Every company has a front line and a leader."
	speech_tutorial2_k2_T2L09_Tutor_name = "T2L09_Tutor"
	speech_tutorial2_k2_Subtitle_Text_9 = "Companies are commanded as a single entity and you have no control over the actions of individual units within the company.  Each company follows a set of rules and each unit within acts on its own to the best of its abilities.  You only need to concern yourself with ordering and positioning the companies, they will do the rest."
	speech_tutorial2_k2_T2L10_Tutor_name = "T2L10_Tutor"
	speech_tutorial2_k2_Subtitle_Text_10 = "Another way to recruit new companies is by using the custom company editor.  This editor allows you to create a wider variety of companies than the presets allow.  To access the custom company editor, make sure your settlement is selected and click on the Recruit button."
	speech_tutorial2_k2_T2L11_Tutor_name = "T2L11_Tutor"
	speech_tutorial2_k2_Subtitle_Text_11 = "As you can see, all the units that are available for recruitment appear on the left side of the editor.  Units you can currently recruit are in full color.  Units that are missing build requirements are grayed out.  You can tooltip any unit to see its stats or requirements in the tooltip area on the right side of the editor."
	speech_tutorial2_k2_T2L12_Tutor_name = "T2L12_Tutor"
	speech_tutorial2_k2_Subtitle_Text_12 = "The units are arranged by the position they occupy in a company.  The layout is a vertical representation of the company information you would see in the Object Display when a company is selected.  Let's start by choosing our front line.  Click on a Swordsman in the front line section."
	speech_tutorial2_k2_T2L13_Tutor_name = "T2L13_Tutor"
	speech_tutorial2_k2_Subtitle_Text_13 = "Now you should have a basic Swordsman company.  You can increase the strength of this company by adding Flank and Support units to its other positions.  Go ahead and click a Halberdier for the flank position and a Warmage for the support.  You will notice that the flank position is locked as pairs, similar to the front line being locked as groups of four."
	speech_tutorial2_k2_T2L14_Tutor_name = "T2L14_Tutor"
	speech_tutorial2_k2_Subtitle_Text_14 = "You can also edit what captain the company will be recruited with.  If you have any available heroes, they will appear in the captain section.  Go ahead and add Jonas Teramun to the lead position of this new company.  New companies can be added to your favorites by hitting the Save Favorite button.  For now, just click on Recruit."
	speech_tutorial2_k2_T2L15_Tutor_name = "T2L15_Tutor"
	speech_tutorial2_k2_Subtitle_Text_15 = "You now have Jonas in command of a custom company.  Being a larger company, they will take longer to supply in.  Let's take this time to learn more about supply."
	speech_tutorial2_k2_T2L16_Tutor_name = "T2L16_Tutor"
	speech_tutorial2_k2_Subtitle_Text_16 = "Supply is how units are added to companies when recruited.  Click on the Supply toggle button to turn on the supply line indicator."
	speech_tutorial2_k2_T2L17_Tutor_name = "T2L17_Tutor"
	speech_tutorial2_k2_Subtitle_Text_17 = "The area within the green supply line is the area that your kingdom considers to be in supply.  Settlements and outposts both provide areas of supply to your kingdom."
	speech_tutorial2_k2_T2L18_Tutor_name = "T2L18_Tutor"
	speech_tutorial2_k2_Subtitle_Text_18 = "Supply also serves to heal units that have become damaged.  Even units lost in combat will be replaced with fresh troops.  So long as a single unit in a company survives, the entire company can be returned to full health."
	speech_tutorial2_k2_T2L19_Tutor_name = "T2L19_Tutor"
	speech_tutorial2_k2_Subtitle_Text_19 = "The Kohan heroes can be killed in combat but their souls will be preserved in a magic amulet until they are reawakened.  Dying causes them to lose all of their experience though, returning them to their lowest level of power."
	speech_tutorial2_k2_T2L20_Tutor_name = "T2L20_Tutor"
	speech_tutorial2_k2_Subtitle_Text_20 = "To help you keep track of your heroes, a small menu can be accessed at the top left corner of the screen."
	speech_tutorial2_k2_T2L21_Tutor_name = "T2L21_Tutor"
	speech_tutorial2_k2_Subtitle_Text_21 = "You can attach a hero to any company in supply by selecting that company, clicking the Attach button, and then selecting the desired hero in the hero menu.  The selected hero will become the new leader of that company.  Heroes can be detached as well, using the Detach button."
	speech_tutorial2_k2_T2L22_Tutor_name = "T2L22_Tutor"
	speech_tutorial2_k2_Subtitle_Text_22 = "Now that recruitment is out of the way, it's time to cover combat.  Before you are two companies.  One is under your control, the other is an enemy company.  Select your company and press the Attack button.  Then click on or near the enemy company.  Your company will move near the enemy and automatically engage them in combat.  Each unit will fight on their own, according to their abilities."
	speech_tutorial2_k2_T2L23_Tutor_name = "T2L23_Tutor"
	speech_tutorial2_k2_Subtitle_Text_23 = "Here are two more companies.  This time, your company is not strong enough to beat the enemy.  To prevent it from being destroyed you must click on the Run button and choose a safe place for it to retreat to.  Somewhere in the supply zone of your town should be appropriate."
	speech_tutorial2_k2_T2L24_Tutor_name = "T2L24_Tutor"
	speech_tutorial2_k2_Subtitle_Text_24 = "You did not retreat in time and your company ended up routing.  Companies will rout to escape losing combats, but choose their destination at random."
	speech_tutorial2_k2_T2L25_Tutor_name = "T2L25_Tutor"
	speech_tutorial2_k2_Subtitle_Text_25 = "Combatants will chase each other for a short distance before giving up the attack.  If your retreat is not far enough, the enemy will re-engage your company and the fight will continue."
	speech_tutorial2_k2_T2L26_Tutor_name = "T2L26_Tutor"
	speech_tutorial2_k2_Subtitle_Text_26 = "Now that you know how to start a fight and retreat from one, your first task of conquest sits before you.  This is a tech lair.  Once tech lairs are captured, and as long as they remain under your control, they provide a technology to your kingdom.  Go ahead and capture this tech lair by attacking with your companies."
	speech_tutorial2_k2_T2L27_Tutor_name = "T2L27_Tutor"
	speech_tutorial2_k2_Subtitle_Text_27 = "Good work, the lair is now yours.  You can click on the technology panel button to see a list of the technologies you have gained in this manner. "
	speech_tutorial2_k2_T2L28_Tutor_name = "T2L28_Tutor"
	speech_tutorial2_k2_Subtitle_Text_28 = "Some technologies can only be researched within your settlements.  Please select the Foundry structure inside your settlement"
	speech_tutorial2_k2_T2L29_Tutor_name = "T2L29_Tutor"
	speech_tutorial2_k2_Subtitle_Text_29 = "The Foundry is an upgraded Blacksmith and there are no further upgrade options available to it.  Instead, there is now a Research button.  Click on this button to access the available technologies."
	speech_tutorial2_k2_T2L30_Tutor_name = "T2L30_Tutor"
	speech_tutorial2_k2_Subtitle_Text_30 = "The Research button will be replaced with a pair of technology buttons.  One is Magic Weapons and the other is Khaldunite Armor.  You can tooltip the buttons to see what benefits each technology gives units recruited from this settlement.  Now, click on Magic Weapons to start researching that technology."
	speech_tutorial2_k2_T2L31_Tutor_name = "T2L31_Tutor"
	speech_tutorial2_k2_Subtitle_Text_31 = "Once the technology is done researching, future units that you recruit will now carry magic weapons.  Only the units recruited from this settlement will have the technology, each settlement requires its own research to be done.  Also, if you sell or otherwise lose the structure, no more units will recruit with the technology until you research it again."
	speech_tutorial2_k2_T2L32_Ravid_name = "T2L32_Ravid"
	speech_tutorial2_k2_Subtitle_Text_32 = "Jonas, the Drauga clan has refused the peace treaty and demanded that we leave this land.  They only appear to respect a show of force, so we will give them one.  I want you to lay siege to the Drauga town and take control of it."
	speech_tutorial2_k2_T2L33_Tutor_name = "T2L33_Tutor"
	speech_tutorial2_k2_Subtitle_Text_33 = "The Drauga clan that has been warring with Council is based in a town just North of the Council city.  You must capture the town to bring this conflict to an end.  Use the companies in front of you to try and capture the town."
	speech_tutorial2_k2_T2L34_Tutor_name = "T2L34_Tutor"
	speech_tutorial2_k2_Subtitle_Text_34 = "As you can see, two of your companies look very different from the other one.  They only have a single large unit in them.  These are your siege companies; in this case, catapults.  Siege companies do extra damage against walls and buildings, but tend to be weak against enemy companies.  Select the companies and have them attack the town center."
	speech_tutorial2_k2_T2L35_Tutor_name = "T2L35_Tutor"
	speech_tutorial2_k2_Subtitle_Text_35 = "The companies should now be attacking the town.  Companies will automatically try to destroy a part of the wall to gain access to the settlement center.  Once the wall is down, they will proceed to attack the center and take it over.  During the attack, pay attention to the town defenders.  Archer militia will engage the attackers first, and only when the wall is breached will the melee militia appear to defend the inner settlement."
	speech_tutorial2_k2_T2L36_Tutor_name = "T2L36_Tutor"
	speech_tutorial2_k2_Subtitle_Text_36 = "If you feel like you need more companies to capture the town, recruit more from your city."
	speech_tutorial2_k2_T2L37_Tutor_name = "T2L37_Tutor"
	speech_tutorial2_k2_Subtitle_Text_37 = "Good work.  The Drauga town has fallen to your army, and their clan has bowed before your strength.  There will be no more raids into the Council lands."
	speech_tutorial2_k2_T2L38_Ravid_name = "T2L38_Ravid"
	speech_tutorial2_k2_Subtitle_Text_38 = "This siege has been most enlightening.  There is evidence that the Drauga Elders were manipulated in some fashion, poisoning their minds with thoughts of conquest.  There is more to this than is readily apparent."
	speech_tutorial2_k2_T2L39_Tutor_name = "T2L39_Tutor"
	speech_tutorial2_k2_Subtitle_Text_39 = "You have done well; the second tutorial is now complete."
