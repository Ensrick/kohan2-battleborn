	speech_chapter1_k2_bannertext_ch1_name = "Chapter 1 Banner"
	speech_chapter1_k2_Subtitle_Text_50 = "Many years ago..."
	speech_chapter1_k2_Subtitle_Text_51 = "I am a Seeker dispatched by Sofiya Fairfax, Regent of Istira...  What has happened here?"
	speech_chapter2_k2_Subtitle_Text_75 = "Ahriman is no more.  I am the Shadow made flesh!  I...am...Abaddon!  You all serve me now.  Submit or perish."
	speech_chapter2_k2_Subtitle_Text_76 = "With the Shadow at my command and the Undead of Khaldun in my thrall, all will soon fall before me.  Go forth my children and sow chaos across the land!"
	speech_chapter5_k2_Subtitle_Text_132 = "No one.  Go to sleep.  We will need our strength for tomorrow."
