
;; Blackguard - Ceyah melee front/flank (design tier 4, Stonewalker model, black armor)
;; TEXTURE DEBT: black-armor stonewalker skin + own icon (GIMP source started:
;; __GIMP FILES - Units/SKIN - Haroun - Stonewalker Model.xcf)

[Unit template=K2CeyahUnit]
{
	IDS = bb_front_ceyah_stonewalker
	name = "#bb_front_ceyah_stonewalker_name"

	[View]
	resource_prefix = /Units/Haroun/Stonewalker/Stonewalker

	[BodyComponent]
	health = 300 ;; stonewalker 220
	defense = 4 ;; stonewalker 3

	[CharacterComponent]
	{
		[Animation Template=MoveAnimation]
		IDS = walk
		walk_distance = 1.5

		[Animation Template=MoveAnimation]
		IDS = jog
		walk_distance = 2.5

		[Animation Template=IdleAnimation]
		IDS = idle

		[Animation Template=MeleeIdleAnimation]
		IDS = idlemelee

		[Animation Template=FidgetAnimation]
		IDS = fidget1

		[Animation Template=FidgetAnimation]
		IDS = fidget2

		[Animation Template=DieAnimation]
		{
			IDS = die1

			[WhenStart template=FXC_PlaySFX]
			audio_ids = stonewalker_death
		}

		[Animation Template=DieAnimation]
		{
			IDS = die2

			[WhenStart template=FXC_PlaySFX]
			audio_ids = stonewalker_death
		}

		[Animation Template=MeleeAttackAnimation]
		IDS = melee1
		key_ratio = 0.6

		[Animation Template=MeleeAttackAnimation]
		IDS = melee2
		key_ratio = 0.6

		[Animation Template=MeleeAttackAnimation]
		IDS = melee3
		key_ratio = 0.6
	}

	[EconomyComponent]
	{
		[Cost]
		gold = 18

		[Upkeep]
		iron = 0.5
	}

	[ElementComponent]
	morale_value = 11 ;; stonewalker 10
	required_structures = base_blacksmith
	required_properties = faction_ceyah, evil
	denizen_type = denizen_type_melee

	[MoverComponent]
	{
		speed_max = 3.5

		[TrackInfo Template=K2TracksBipedRight]

		[TrackInfo Template=K2TracksBipedLeft]
	}

	[PerformerComponent]
	{
		[Ability Template=K2MeleeLocal]
		{
			animation1 = melee1
			animation2 = melee2

			[AbilityDefinition Template=K2MeleeAttack]
			{
				name = "#stonewalker_AbilityDefinition_name"

				[Effect Template=MainDamageEffect]
				damage_type_IDS = melee
				amount = 26 ;; stonewalker 20

				[WhenDo template=FXC_PlaySFX]
				audio_ids = metal_swing3
			}
		}
	}

	[PropertiesComponent]
	{
		[Property]
		property_IDS = race_undead

		[Property]
		property_IDS = armored

		[Property]
		property_IDS = front

		[Property]
		property_IDS = flank

		[Property]
		property_IDS = melee

		[Property]
		property_IDS = role_infantry
	}
}
