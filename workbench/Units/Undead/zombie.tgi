[Unit template = K2UndeadUnit]
{
	IDS = zombie
	name = "#zombie_name"
	
	[View]
	{
		resource_prefix = Zombie/Zombie

		[WhenCreated template=FXC_CreateVFX]
		vfx_ids = ghoul_mist
		location = HEAD
	}
		
	[BodyComponent]
	health = 140
	defense = 1
	
	[CharacterComponent]
	{
		[Animation Template=MoveAnimation]
		IDS = walk
		walk_distance = 2
				
		[Animation Template=IdleAnimation]
		IDS = idle
		
		[Animation Template=MeleeIdleAnimation]
		IDS = idlemelee
		
		[Animation Template=FidgetAnimation]
		IDS = fidget1

		[Animation Template=FidgetAnimation]
		IDS = fidget2
				
		[Animation Template=DieAnimation]
		{
			IDS = die1
			
			[WhenStart template=FXC_PlaySFX]
			audio_ids = zombie_death
		}
						
		[Animation Template=MeleeAttackAnimation]
		IDS = melee1
		key_ratio = 0.5
						
		[Animation Template=MeleeAttackAnimation]
		IDS = melee2
		key_ratio = 0.65

		[Animation Template=SummonAnimation]
		IDS = summon
	}

	[EconomyComponent]
	{
		[Cost]
		gold = 5
	}
	
	[ElementComponent]
	{
		morale_value = 10
		required_structures = undead_center_village
		denizen_type = denizen_type_melee
		group_priority = 2

		[SupportProperty]
		property_IDS = rapid_entrench
	}
	
	[MoverComponent]
	{
		speed_max = 2
	
		[TrackInfo Template=K2TracksBipedRight]
		
		[TrackInfo Template=K2TracksBipedLeft]
	}
	
	[PerformerComponent]
	{
		[Ability Template=K2MeleeLocal]
		{
			animation1 = melee1
			animation2 = melee2
			
			[AbilityDefinition Template=K2SiegeAttack2]
			{
				name = "#zombie_AbilityDefinition_name"
							
				[Effect Template=MainDamageEffect]
				damage_type_IDS = melee
				amount = 12
				
				[Effect Template=AddDamageEffect]
				damage_type_IDS = siege
				targets = buildings
				amount = 5
				
				[Effect template=EnchantmentEffect]
				{
					[EnchantmentProperty Template=EnchantmentProperty]
					{
						ids = zombie_plague
						name = "#zombie_AbilityDefinition_Effect_EnchantmentProperty_name"
						duration = 15
						enchantment_type = disease
						icon = /Properties/PropertyIcons/IconPropertyMovement.png
			
						[Modifier Template=AddModifier]
						attribute = AV
						amount = -1

						[Modifier Template=MultiplyModifier]
						attribute = SPEED_MAX
						amount = -0.25

						[WhenAdded Template=FXC_CreateVFX]
						vfx_ids = tint_disease
					}
  				}

				[WhenDo template=FXC_PlaySFX]
				audio_ids = zombie_bash
			}
		}
	}
	
	[PropertiesComponent]
	{
		[Property]
		property_IDS = front

		[Property]
		property_IDS = flank
		
		[Property]
		property_IDS = melee
		
		[Property]
		property_IDS = role_infantry	
	}
}

[Thing template = K2UndeadCompany]
{
	IDS = company_zombie
	name = "#zombie_company_zombie_name"
	
	[View]
	{
		resource_prefix = Zombie/Zombie
		banner_icon = /Organizations/BannerIcons/InfantryIcon.tga
 
		[WhenSelected Template=FXC_PlaySFX]
		audio_ids = zombie_select

		[WhenCommanded Template=FXC_PlaySFX]
		audio_ids = zombie_move

		[WhenCommandedAggressive Template=FXC_PlaySFX]
		audio_ids = zombie_attack
	}

	[PropertiesComponent]
	{
		[Property]
		property_IDS = company_melee
	}
	
	[OrganizationComponent]
	{
		layout_IDS = company_standard
		entrenchment_time = 60
		
		[Slot]	;; front
		element_IDS = zombie
		
		[Slot]	;; flank
		element_IDS = null
		
		[Slot]	;; support
		element_IDS = null
		
		[Slot]	;; support
		element_IDS = null
		
		[Slot]	;; captain
		element_IDS = reaper
	}	
}

[Thing template=K2MonsterCompany]
{
	IDS = company_zombie_summoned
	name = "#zombie_company_zombie_summoned_name"
	recruitable = no
	
	[View]
	resource_prefix = Zombie/Zombie
	banner_icon = /Organizations/BannerIcons/MonsterIcon.tga
	
	[OrganizationComponent]
	{
		layout_IDS = company_summoned_two
		entrenchment_time = 300
		
		[Slot]	;; front
		element_IDS = zombie
	}	
}

[Thing Template=K2UndeadMilitia]
{
	IDS = militia_zombie
	name = "#zombie_militia_zombie_name"

	[View]
	resource_prefix = Zombie/Zombie
	banner_icon = /Organizations/BannerIcons/MonsterIcon.tga
	
	[OrganizationComponent]
	{
		layout_IDS = company_militia
		entrenchment_time = 300
		
		[Slot]	;; front
		element_IDS = zombie
		
		[Slot]	;; support
		element_IDS = null
	}	
}