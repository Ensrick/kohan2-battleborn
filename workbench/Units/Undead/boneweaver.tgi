
[Unit template=K2UndeadUnit]
{
	IDS = boneweaver
	name = "#boneweaver_name"
	description = "#boneweaver_description"
 	
	[View]
	resource_prefix = Boneweaver/Boneweaver
			
	[BodyComponent]
	health = 120
	defense = 1
	
	[BuilderComponent template=BuilderComponent]
	{
		[BuildActor]
		actor_ids = undead_center_village
		
		[BuildActor]
		actor_ids = undead_outpost
	
		[BuildActor]
		actor_ids = undead_mine_gold
		
		[BuildActor]
		actor_ids = undead_mine_stone
		
		[BuildActor]
		actor_ids = undead_mine_wood
		
		[BuildActor]
		actor_ids = undead_mine_iron
		
		[BuildActor]
		actor_ids = undead_mine_mana	
	}

	[CharacterComponent]
	{
		[Animation Template=MoveAnimation]
		IDS = walk
		walk_distance = 0.68
				
		[Animation Template=IdleAnimation]
		IDS = idle
		
		[Animation Template=MeleeIdleAnimation]
		IDS = idlemelee
		
		[Animation Template=FidgetAnimation]
		IDS = fidget1

		[Animation Template=FidgetAnimation]
		IDS = fidget2
				
		[Animation Template=DieAnimation]
		{
			IDS = die1
		
			[WhenStart template=FXC_PlaySFX]
			audio_ids = boneweaver_death
		}
				
		[Animation Template=MeleeAttackAnimation]
		IDS = melee1
		key_ratio = 0.4
						
		[Animation Template=BuildAnimation]
		IDS = build1
		key_ratio = 0.5

		[Animation Template=BuildAnimation]
		IDS = build2
		key_ratio = 0.5
	}

	[EconomyComponent]
	{
		[Cost]
		gold = 6
		
		[Upkeep]
		stone = 1
	}
	
	[ElementComponent]
	{
		morale_value = 10
		required_structures = undead_center_village
		denizen_type = denizen_type_worker
		group_priority = 1
		
		[SupportProperty]
		property_IDS = rapid_entrench
	}

	[MoverComponent]
	{
		speed_max = 3.5
		turn_radius = 0.75
	
		[TrackInfo Template=K2TracksQuadInsectFootFrontRight]
		
		[TrackInfo Template=K2TracksQuadInsectFootBackLeft]
		
		[TrackInfo Template=K2TracksQuadInsectFootBackRight]
		
		[TrackInfo Template=K2TracksQuadInsectFootFrontLeft]
	}
	
	[PerformerComponent]
	{		
		[Ability Template=K2MeleeLocal]
		{
			animation1 = melee1
				
			[AbilityDefinition Template=K2MeleeAttack]
			{
				name = "#boneweaver_AbilityDefinition_name"
							
				[Effect Template=MainDamageEffect]
				damage_type_IDS = melee
				amount = 10
				
				[Effect Template=AddDamageEffect]
				damage_type_IDS = siege
				targets = buildings
				amount = 4
				
				[WhenDo template=FXC_PlaySFX]
				audio_ids = claw_small
			}
		}
		
		[Ability Template=K2RepairAllLocal]
		{
			animation1 = build1
			animation2 = build2
			
			[AbilityDefinition Template=K2RepairAllAction]
			{
				[Effect Template=HealEffect]
				amount = 10
				
				[Effect Template=HealEffect]
				targets = walls
				amount = 50				

				[WhenDo template=FXC_PlaySFX]
				audio_ids = worker_build_undead
			}
		}

		[Ability Template=K2RepairLocal]
		{			
			animation1 = build1
			animation2 = build2
			
			[AbilityDefinition Template=K2RepairAction]
			{
				[Effect Template=HealEffect]
				amount = 10

				[WhenDo template=FXC_PlaySFX]
				audio_ids = worker_build_undead
			}
		}
		
		[Ability Template=K2ConstructLocalSettlement]
		{
			animation1 = build1
			animation2 = build2
			
			[AbilityDefinition Template=K2ConstructActionSettlement]
			{
				[Effect Template=HealEffect]
				amount = 5

				[WhenDo template=FXC_PlaySFX]
				audio_ids = worker_build_undead
			}
		}
		
		[Ability Template=K2ConstructLocal]
		{
			animation1 = build1
			animation2 = build2
			required_properties = role_engineer

			[AbilityDefinition Template=K2ConstructAction]
			{
				[Effect Template=HealEffect]
				amount = 5
				
				[WhenDo template=FXC_PlaySFX]
				audio_ids = worker_build_undead
			}
		}
	}

	[PropertiesComponent]
	{
		[Property]
		property_IDS = front

		[Property]
		property_IDS = settler_support
		
		[Property]
		property_IDS = bb_settler_flank

		[Property]
		property_IDS = skeletal

		[Property]
		property_IDS = role_settler
		
		[Property]
		property_IDS = role_engineer

		[Property]
		property_IDS = rapid_entrench
	}
}

[Thing Template=K2UndeadCompany]
{
	IDS = company_boneweaver
	name = "#boneweaver_company_boneweaver_name"
	
	[View]
	{
		resource_prefix = Boneweaver/Boneweaver
		banner_icon = /Organizations/BannerIcons/SettlerIcon.tga
 
		[WhenSelected Template=FXC_PlaySFX]
		audio_ids = boneweaver_select

		[WhenCommanded Template=FXC_PlaySFX]
		audio_ids = boneweaver_move

		[WhenCommandedAggressive Template=FXC_PlaySFX]
		audio_ids = boneweaver_attack
	}

	[PropertiesComponent]
	{
		[Property]
		property_IDS = role_settler
		
		[Property]
		property_IDS = role_engineer
	}

	[OrganizationComponent]
	{
		layout_IDS = company_settler
		entrenchment_time = 60
		
		[Slot]	;; front
		element_IDS = boneweaver

		[Slot]	;; bb_settler_flank
		element_IDS = boneweaver
		
		[Slot]	;; support
		element_IDS = boneweaver
		
		[Slot]	;; captain
		element_IDS = reaper
	}	
}

[Thing Template=K2UndeadWorkers]
{
	IDS = workers_undead
	name = "#boneweaver_workers_undead_name"
	
	[View]
	resource_prefix = Boneweaver/Boneweaver
	banner_icon = /Organizations/BannerIcons/SettlerIcon.tga
	
	[OrganizationComponent]
	{
		layout_IDS = company_worker
		entrenchment_time = 300
		
		[Slot]	;; front
		element_IDS = boneweaver
	}	
}
