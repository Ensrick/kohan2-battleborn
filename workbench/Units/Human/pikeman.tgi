
[Unit template=K2HumanUnit]
{
	IDS = pikeman
	name = "#pikeman_name"
	
	[View]
	{
		resource_prefix = Pikeman/Pikeman

		[AspectNormal]
		skin = %sbase.dds
	}

		
	[BodyComponent]
	health = 180
	defense = 3
	
	[CharacterComponent]
	{
		[Animation Template=MoveAnimation]
		IDS = walk
		walk_distance = 1.5
				
		[Animation Template=MoveAnimation]
		IDS = jog
		walk_distance = 2.5
		
		[Animation Template=IdleAnimation]
		IDS = idle
		
		[Animation Template=MeleeIdleAnimation]
		IDS = idlemelee
		
		[Animation Template=FidgetAnimation]
		IDS = fidget1

		[Animation Template=FidgetAnimation]
		IDS = fidget2
				
		[Animation Template=DieAnimation]
		{
			IDS = die1

			[WhenStart template=FXC_PlaySFX]
			audio_ids = pikeman_death
		}
				
		[Animation Template=MeleeAttackAnimation]
		IDS = melee1
		key_ratio = 0.5
						
		[Animation Template=MeleeAttackAnimation]
		IDS = melee2
		key_ratio = 0.5
	}

	[EconomyComponent]
	{
		[Cost]
		gold = 2 ;; 8
		
		[Upkeep]
		iron = 0.125 ;; 0.5
	}
	
	[ElementComponent]
	{
		morale_value = 9
		required_structures = human_center_village
		denizen_type = denizen_type_melee
		group_priority = 2
	
		[SupportProperty]
		property_IDS = cavalry_foe
	}

	[MoverComponent]
	{
		speed_max = 3
		
		[TrackInfo Template=K2TracksBipedRight]
		
		[TrackInfo Template=K2TracksBipedLeft]
	}
	
	[PerformerComponent]
	{
		[Ability Template=K2MeleeLocal]
		{
			animation1 = melee1
			animation2 = melee2
						
			[AbilityDefinition Template=K2MeleeAttack]
			{
				name = "#pikeman_AbilityDefinition_name"
							
				[Effect Template=MainDamageEffect]
				damage_type_IDS = melee
				amount = 14
				
				[Effect Template=AddDamageEffect]
				damage_type_IDS = siege
				targets = buildings
				amount = 5
				
				[WhenDo template=FXC_PlaySFX]
				audio_ids = metal_stab3
			}
		}
	}
	
	[PropertiesComponent]
	{
		[Property]
		property_IDS = race_human

		[Property]
		property_IDS = agile

		[Property]
		property_IDS = front

		[Property]
		property_IDS = flank
		
		[Property]
		property_IDS = melee
		
		[Property]
		property_IDS = role_infantry
	}
}

[Thing template=K2HumanCompany]
{
	IDS = company_pikeman
	name = "#pikeman_company_pikeman_name"

	[View]
	{
		resource_prefix = Pikeman/Pikeman	
		banner_icon = /Organizations/BannerIcons/InfantryIcon.tga
 
		[WhenSelected Template=FXC_PlaySFX]
		audio_ids = pikeman_select

		[WhenCommanded Template=FXC_PlaySFX]
		audio_ids = pikeman_move

		[WhenCommandedAggressive Template=FXC_PlaySFX]
		audio_ids = pikeman_attack
	}

	[PropertiesComponent]
	{
		[Property]
		property_IDS = company_melee
	}

	[OrganizationComponent]
	{
		layout_IDS = company_standard
		entrenchment_time = 60
		
		[Slot]	;; front
		element_IDS = pikeman
		
		[Slot]	;; flank
		element_IDS = pikeman
		
		[Slot]	;; support
		element_IDS = bb_praetorian
		
		[Slot]	;; support
		element_IDS = bb_praetorian
		
		[Slot]	;; captain
		element_IDS = bb_captain_pikeman
	}	
}

[Thing template=K2HumanMilitia]
{
	IDS = militia_pikeman
	name = "#pikeman_militia_pikeman_name"
	
	[View]
	resource_prefix = Pikeman/Pikeman
	banner_icon = /Organizations/BannerIcons/InfantryIcon.tga
	
	[OrganizationComponent]
	{
		layout_IDS = company_militia
		entrenchment_time = 300
		
		[Slot]	;; front
		element_IDS = pikeman
		
		[Slot]	;; support
		element_IDS = null
	}	
}
