
/******************************************  CAPTAIN TALKING PORTRAIT  **********************************/

[Thing template=Portrait]
{
	ids = captain_talk
	name = "#captain_talk_name"

	[View]
	{
		resource_prefix = Captain/CaptainTalk

		[AspectNormal]
		{
			[Animation Template=ObjectAnimationIdle]
			ids = 1
		}
	}
}

/******************************************  CAPTAIN PORTRAIT  **********************************/

[Thing template=Portrait]
{
	ids = captain_portrait
	name = "#captain_portrait_name"

	[View]
	{
		resource_prefix = Captain/CaptainPortrait

		[AspectNormal]
		{
			[Animation Template=ObjectAnimationIdle]
			ids = idle

			[Animation Template=ObjectAnimationFidget]
			ids = fidget1
			
			[Animation Template=ObjectAnimationFidget]
			ids = fidget2

			[Animation Template=ObjectAnimationFidget]
			ids = fidget3
		}
	}
}

/******************************************  CAPTAIN UNIT  **********************************/

[Unit template=K2HumanUnit]
{
	IDS = captain
	name = "#captain_cavalry_name"
	
	[Size]
	{
		blocking_radius = 0.75
		soft_shape = RECT
		rect_width = 1.5
		rect_height = 3.0
	}
	
	[View]
	resource_prefix = Captain/Captain
	portrait_ids = captain_portrait
		
	[BodyComponent]
	health = 360
	defense = 5
	
	[CharacterComponent]
	{
		[Animation Template=MoveAnimation]
		IDS = walk
		walk_distance = 1.75
				
		[Animation Template=MoveAnimation]
		IDS = jog
		walk_distance = 3
		
		[Animation Template=IdleAnimation]
		IDS = idle
		
		[Animation Template=MeleeIdleAnimation]
		IDS = idlemelee
		
		[Animation Template=FidgetAnimation]
		IDS = fidget1

		[Animation Template=FidgetAnimation]
		IDS = fidget2
				
		[Animation Template=DieAnimation]
		{
			IDS = die1
			length = 1.5
			
			[WhenStart template=FXC_PlaySFX]
			audio_ids = captain_death
		}
						
		[Animation Template=MeleeAttackAnimation]
		IDS = melee1
		key_ratio = 0.6
						
		[Animation Template=MeleeAttackAnimation]
		IDS = melee2
		key_ratio = 0.6
	}

	[ElementComponent]
	morale_value = 10
	required_structures = human_center_village
	primary_minimum_health = .3

	[MoverComponent]
	{
		speed_max = 4.5
		turn_radius = 2.5

		[TrackInfo Template=K2TracksQuadFrontRight]
		
		[TrackInfo Template=K2TracksQuadBackLeft]
		
		[TrackInfo Template=K2TracksQuadBackRight]
		
		[TrackInfo Template=K2TracksQuadFrontLeft]
	}
	
	[PerformerComponent]
	{
		[Ability Template=K2MeleeLocal]
		{
			animation1 = melee1
			animation2 = melee2
			
			[AbilityDefinition Template=K2meleeAttack]
			{
				name = "#captain_AbilityDefinition_name"
							
				[Effect Template=MainDamageEffect]
				damage_type_IDS = melee
				amount = 38
				
				[WhenDo template=FXC_PlaySFX]
				audio_ids = metal_swing2
			}
		}
	}
	
	[PropertiesComponent]
	{
		[Property]
		property_IDS = race_human

		[Property]
		property_IDS = armored

		[Property]
		property_IDS = captain
		
		[Property]
		property_IDS = melee

		[Property]
		property_IDS = agile
	}
}
