
[Unit Template=K2HumanUnit]
{
	IDS = bb_captain_lancer
	name = "#bb_captain_lancer_name"
	
	[Size]
	{
		blocking_radius = 0.75
		soft_shape = RECT
		rect_width = 1.5
		rect_height = 3.0
	}
	
	[View]
	resource_prefix = Lancer/Lancer
		
	[BodyComponent]
	health = 200
	defense = 2
	
	[CharacterComponent]
	{
		[Animation Template=MoveAnimation]
		IDS = walk
		walk_distance = 1.75
				
		[Animation Template=MoveAnimation]
		IDS = jog
		walk_distance = 3
		
		[Animation Template=IdleAnimation]
		IDS = idle
		
		[Animation Template=MeleeIdleAnimation]
		{
			IDS = idlemelee

			[WhenStart Template=FXC_Equipment]
			action = FLIP
			location = rhand
			equipment_type_ids = pike

			[WhenEnd Template=FXC_Equipment]
			action = FLIP
			location = rhand
			equipment_type_ids = pike
		}

		[Animation Template=FidgetAnimation]
		IDS = fidget1

		[Animation Template=FidgetAnimation]
		IDS = fidget2

		[Animation Template=FidgetAnimation]
		IDS = fidget3
		
		[Animation Template=DieAnimation]
		{
			IDS = die1
			length = 2

			[WhenStart template=FXC_PlaySFX]
			audio_ids = lancer_death
		}		
		
		[Animation Template=MeleeAttackAnimation]
		{	
			IDS = melee1
			key_ratio = 0.6	
			
			[WhenStart Template=FXC_Equipment]
			action = FLIP
			location = rhand
			equipment_type_ids = pike

			[WhenEnd Template=FXC_Equipment]
			action = FLIP
			location = rhand
			equipment_type_ids = pike
		}	

		[Animation Template=MeleeAttackAnimation]
		{	
			IDS = melee2
			key_ratio = 0.6	
			
			[WhenStart Template=FXC_Equipment]
			action = FLIP
			location = rhand
			equipment_type_ids = pike

			[WhenEnd Template=FXC_Equipment]
			action = FLIP
			location = rhand
			equipment_type_ids = pike
		}			
	}

	[EconomyComponent]
	{
		[Cost]
		gold = 1 ;; 6
		
		[Upkeep]
		wood = 0.25 ;; 1
	}
	
	[ElementComponent]
	{
		morale_value = 10
		required_structures = human_center_village
		group_priority = 1
		
		[SupportProperty]
		property_IDS = recon
		
		[SupportProperty]
		property_IDS = archer_foe
	}
	
	[MoverComponent]
	{
		speed_max = 4.5

		[TrackInfo Template=K2TracksQuadFrontRight]
		
		[TrackInfo Template=K2TracksQuadBackLeft]
		
		[TrackInfo Template=K2TracksQuadBackRight]
		
		[TrackInfo Template=K2TracksQuadFrontLeft]
	}
	
	[PerformerComponent]
	{
		[Ability Template=K2MeleeLocal]
		{
			animation1 = melee1

			[AbilityDefinition Template=K2MeleeAttack]
			{
				name = "#lancer_AbilityDefinition_name"
							
				[Effect Template=MainDamageEffect]
				damage_type_IDS = melee
				amount = 16
				
				[WhenDo template=FXC_PlaySFX]
				audio_ids = metal_stab2
			}
		}
	}
	
	[PropertiesComponent]
	{
		[Property]
		property_IDS = race_human

		[Property]
		property_IDS = swift

		[Property]
		property_IDS = front

		[Property]
		property_IDS = flank
		
		[Property]
		property_IDS = melee
				
		[Property]
		property_IDS = role_cavalry
	}
}

[Thing Template=K2HumanCompany]
{
	IDS = company_lancer
	name = "#lancer_company_lancer_name"
	
	[View]
	{
		resource_prefix = Lancer/Lancer
		banner_icon = /Organizations/BannerIcons/CavalryIcon.tga

		[WhenSelected Template=FXC_PlaySFX]
		audio_ids = lancer_select

		[WhenCommanded Template=FXC_PlaySFX]
		audio_ids = lancer_move

		[WhenCommandedAggressive Template=FXC_PlaySFX]
		audio_ids = lancer_attack
 	}
	
	[PropertiesComponent]
	{
		[Property]
		property_IDS = company_melee
	}
	
	[OrganizationComponent]
	{
		layout_IDS = company_mounted
		entrenchment_time = 300
		
		[Slot]	;; front
		element_IDS = lancer
		
		[Slot]	;; flank
		element_IDS = null
		
		[Slot]	;; support
		element_IDS = null
		
		[Slot]	;; support
		element_IDS = null
		
		[Slot]	;; captain
		element_IDS = captain
	}	
}

[Thing template=K2HumanMilitia]
{
	IDS = militia_lancer
	name = "#lancer_militia_name"
	
	[View]
	{
		resource_prefix = Lancer/Lancer
		banner_icon = /Organizations/BannerIcons/CavalryIcon.tga

		[WhenSelected Template=FXC_PlaySFX]
		audio_ids = lancer_select
 	}
	
	[OrganizationComponent]
	{
		layout_IDS = company_militia
		entrenchment_time = 300
		
		[Slot]	;; front
		element_IDS = lancer
		
		[Slot]	;; support
		element_IDS = null
	}	
}