
/******************************************  HILLSTRIDER PORTRAIT  **********************************/

[Thing Template=Portrait]
{
	ids = hillstrider_portrait
	name = "#hillstrider_portrait_name"

	[View]
	{
		resource_prefix = Hillstrider/HillstriderPortrait

		[AspectNormal]
		{
			[Animation Template=ObjectAnimationIdle]
			IDS = idle

			[Animation Template=ObjectAnimationFidget]
			IDS = fidget1
			
			[Animation Template=ObjectAnimationFidget]
			IDS = fidget2

			[Animation Template=ObjectAnimationFidget]
			IDS = fidget3
		}
	}
}

/******************************************  HILLSTRIDER UNIT  **********************************/

[Unit template=K2HarounUnit]
{
	IDS = hillstrider
	name = "#hillstrider_name"
	
	[Size]
	{
		blocking_radius = 0.75
		soft_shape = RECT
		rect_width = 2.2
		rect_height = 1.5
	}
	
	[View]
	resource_prefix = Hillstrider/Hillstrider
	portrait_ids = hillstrider_portrait
		
	[BodyComponent]
	health = 700
	defense = 4
	
	[EconomyComponent]
	{
		[Cost]
		gold = 40
		
		[Upkeep]
		wood = 4
		mana = 2
	}
	
	[ElementComponent]
	{
		morale_value = 55
		required_structures = haroun_barracks, haroun_library
		denizen_type = denizen_type_melee
		group_priority = 3
		resupply_rate = 0.04
	}
		
	[MoverComponent]
	{
		speed_max = 3.5
	
		[TrackInfo Template=K2TracksBipedLargeHoofRight]
		
		[TrackInfo Template=K2TracksBipedLargeHoofLeft]
	}
	
	[PerformerComponent]
	{
		[Ability Template=K2MeleeLocal]
		{
			animation1 = melee1
			animation2 = melee2
			
			[AbilityDefinition Template=K2SiegeAttack]
			{
				name = "#hillstrider_AbilityDefinition_name"

				area = 2.0
				attenuation_range_min = .5
				attenuation_factor_max = 0.5
				impact_impulse = 1000
				impulse_area = 1
				max_targets = 8
							
				[Effect Template=MainDamageEffect]
				damage_type_IDS = siege
				amount = 36
				
				[Effect Template=AddDamageEffect]
				damage_type_IDS = siege
				targets = buildings
				amount = 60

				[WhenDo template=FXC_PlaySFX]
				audio_ids = nonmetal_swing2
			}
		}
	}
	
	[PropertiesComponent]
	{
		[Property]
		property_IDS = front

		[Property]
		property_IDS = siege

		[Property]
		property_IDS = living_wood

		[Property]
		property_IDS = haroun_autoheal

		[Property]
		property_IDS = unstoppable
		
		[Property]
		property_IDS = role_siege
	}
	
	[CharacterComponent]
	{
		[Animation Template=MoveAnimation]
		IDS = walk
		walk_distance = 3
		
		[Animation Template=IdleAnimation]
		IDS = idle
		
		[Animation Template=MeleeIdleAnimation]
		IDS = idlemelee
		
		[Animation Template=FidgetAnimation]
		IDS = fidget1

		[Animation Template=FidgetAnimation]
		IDS = fidget2		
				
		[Animation Template=DieAnimation]
		{
			IDS = die1
			length = 1.5

			[WhenStart template=FXC_PlaySFX]
			audio_ids = hillstrider_death
		}

		[Animation Template=DieAnimation]
		{
			IDS = die2
			length = 2

			[WhenStart template=FXC_PlaySFX]
			audio_ids = hillstrider_death
		}
				
		[Animation Template=MeleeAttackAnimation]
		IDS = melee1
		key_ratio = 0.4
						
		[Animation Template=MeleeAttackAnimation]
		IDS = melee2
		key_ratio = 0.4
	}
}

[Thing Template=K2HarounCompany]
{
	IDS = company_hillstrider
	name = "#hillstrider_company_hillstrider_name"

	[View]
	{
		resource_prefix = Hillstrider/Hillstrider
		banner_icon = /Organizations/BannerIcons/SiegeIcon.tga
 
		[WhenSelected Template=FXC_PlaySFX]
		audio_ids = hillstrider_select

		[WhenCommanded Template=FXC_PlaySFX]
		audio_ids = hillstrider_move

		[WhenCommandedAggressive Template=FXC_PlaySFX]
		audio_ids = hillstrider_attack
	}

	[PropertiesComponent]
	{
		[Property]
		property_IDS = company_siege
	}
	
	[OrganizationComponent]
	{
		layout_IDS = company_siege
		entrenchment_time = 300
		
		[Slot]	;; Siege Unit
		element_IDS = hillstrider

		[Slot]	;; Flank Units
		element_IDS = null
	}	
}

[Thing template=K2HarounMilitia]
{
	IDS = militia_hillstrider
	name = "#hillstrider_militia_name"
	
	[View]
	{
		resource_prefix = Hillstrider/Hillstrider
		banner_icon = /Organizations/BannerIcons/SiegeIcon.tga
 
		[WhenSelected Template=FXC_PlaySFX]
		audio_ids = hillstrider_select
	}
	
	[OrganizationComponent]
	{
		layout_IDS = company_siege_militia
		entrenchment_time = 300
		
		[Slot]	;; siege
		element_IDS = hillstrider
	}	
}