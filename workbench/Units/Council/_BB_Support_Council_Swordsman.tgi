
/******************************************  SPELLSWORD VFX  **********************************/

[VFX template=VFXExtrusion]
{
	ids = bb_spellsword_blur_melee0 ;; custom effect
	name = "#bb_spellsword_blur_slash0_name"

	duration = 0.2
	
	[Extrusion]
	{
		ids = blur_melee0
		start_delay = 0.35
		segment_lifetime = 0
		segment_fadetime = 0.1
		
		[ExtrusionPoint]
		extrusion_root = ep0
		node_color = 0.70, 0.70, 0.70
		node_alpha = 100%

		[ExtrusionPoint]
		extrusion_root = ep1
		node_color = 0.78, 0.78, 0.78
		node_alpha = 80%

		[ExtrusionPoint]
		extrusion_root = ep2
		node_color = 0.78, 0.78, 0.78
		node_alpha = 0%
	
		[Connectivity]
		point_a = ep0
		point_b = ep1	

		[Connectivity]
		point_a = ep1
		point_b = ep2	
	}
}

[VFX template=VFXExtrusion]
{
	ids = bb_spellsword_blur_melee1 ;; custom effect
	name = "#bb_spellsword_blur_slash1_name"

	duration = 0.2
	
	[Extrusion]
	{
		ids = blur_melee1
		start_delay = 0.45
		segment_lifetime = 0
		segment_fadetime = 0.1
		
		[ExtrusionPoint]
		extrusion_root = ep0
		node_color = 0.70, 0.70, 0.70
		node_alpha = 100%

		[ExtrusionPoint]
		extrusion_root = ep1
		node_color = 0.78, 0.78, 0.78
		node_alpha = 80%

		[ExtrusionPoint]
		extrusion_root = ep2
		node_color = 0.78, 0.78, 0.78
		node_alpha = 0%
	
		[Connectivity]
		point_a = ep0
		point_b = ep1

		[Connectivity]
		point_a = ep1
		point_b = ep2
	}
}

/******************************************  SPELLSWORD UNIT  **********************************/

[Unit template=K2CouncilUnit]
{
	IDS = bb_spellsword
	name = "#bb_support_council_swordsman_name"
	
	[View]
	{
		resource_prefix = /Units/Nationalist/GhalenMordecai/GhalenMordecai ;; Uses Ghalen Mordecai as the base model
		icon = /Units/Council/BB_Spellsword/BB_Spellsword_Icon.tga

		[AspectNormal]
		skin = /Units/Council/BB_Spellsword/BB_Spellsword.dds
	}
			
	[BodyComponent]
	health = 390
	defense = 5
	
	[CharacterComponent]
	{
		[Animation Template=MoveAnimation]
		IDS = walk
		walk_distance = 1.7
				
		[Animation Template=MoveAnimation]
		IDS = jog
		walk_distance = 2.5
		
		[Animation Template=IdleAnimation]
		IDS = idle
		
		[Animation Template=MeleeIdleAnimation]
		IDS = idlemelee
		
		[Animation Template=FidgetAnimation]
		IDS = fidget1

		[Animation Template=FidgetAnimation]
		IDS = fidget2
				
		[Animation Template=DieAnimation]
		{
			IDS = die1
			
			[WhenStart template=FXC_PlaySFX]
			audio_ids = swordsman_death
		}
						
		[Animation Template=MeleeAttackAnimation]
		IDS = melee1
		key_ratio = 0.4
						
		[Animation Template=MeleeAttackAnimation]
		IDS = melee2
		key_ratio = 0.55
	}

	[EconomyComponent]
	{
		[Cost]
		gold = 24
		
		[Upkeep]
		iron = 1
		mana = 1
	}
	
	[ElementComponent]
	morale_value = 11
	required_structures = bb_base_center_city,base_blacksmith,base_library
	required_properties = faction_council, good
	denizen_type = denizen_type_melee
	
	[MoverComponent]
	{
		speed_max = 3.5

		[TrackInfo Template=K2TracksBipedRight]
		
		[TrackInfo Template=K2TracksBipedLeft]
	}
	
	[PerformerComponent]
	{
		
		[Ability Template=K2MeleeLocal]
		{
			animation1 = melee1
			animation2 = melee2
			
			[AbilityDefinition Template=K2MeleeAttack]
			{
				name = "#bb_spellsword_AbilityDefinition_name"
							
				[Effect Template=MainDamageEffect]
				damage_type_IDS = khaldunite
				amount = 30
				
				[WhenDo template=FXC_PlaySFX]
				audio_ids = metal_swing3				
			}
		}

		[Ability template=K2SpellEnchantmentLocal]
		ability_IDS = storm_shield
		required_experience_min = 0
		required_experience_max = 2

		[Ability template=K2SpellEnchantmentLocal]
		ability_IDS = storm_shield2
		required_experience_min = 3
		required_experience_max = 3
	}
	
	[PropertiesComponent]
	{
		[Property]
		property_IDS = race_human

		[Property]
		property_IDS = armored

		[Property]
		property_IDS = shields

		[Property]
		property_IDS = support
		
		[Property]
		property_IDS = melee
		
		[Property]
		property_IDS = role_infantry
	}
}
