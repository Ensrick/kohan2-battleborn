
;; Arcane Archer - Council ranged support (design tier 5, Ranger model, white skin planned)
;; TEXTURE DEBT: white ranger skin + own icon (ships with default Ranger art)
;; Reuses the ranger_* VFX defined in Units/Human/ranger.tgi

[Unit template=K2CouncilUnit]
{
	IDS = bb_support_council_ranger
	name = "#bb_support_council_ranger_name"

	[View]
	{
		resource_prefix = /Units/Human/Ranger/Ranger

		[WhenCreated Template=FXC_Equipment]
		action = UNHIDE
		location = LHAND
		equipment_type_ids = bow

		[WhenCreated Template=FXC_Equipment]
		action = HIDE
		location = RHAND
		equipment_type_ids = arrow
	}

	[BodyComponent]
	health = 280 ;; ranger 240
	defense = 2 ;; ranger 1

	[CharacterComponent]
	{
		[Animation Template=MoveAnimation]
		IDS = walk
		walk_distance = 1.5

		[Animation Template=MoveAnimation]
		IDS = jog
		walk_distance = 2.5

		[Animation Template=IdleAnimation]
		IDS = idle

		[Animation Template=MeleeIdleAnimation]
		IDS = idlemelee

		[Animation Template=RangedIdleAnimation]
		IDS = idlerange

		[Animation Template=FidgetAnimation]
		IDS = fidget1

		[Animation Template=FidgetAnimation]
		IDS = fidget2

		[Animation Template=DieAnimation]
		{
			IDS = die1

			[WhenStart template=FXC_PlaySFX]
			audio_ids = ranger_death
		}

		[Animation Template=MeleeAttackAnimation]
		{
			IDS = melee1
			key_ratio = 0.5

			[WhenStart template=FXC_CreateVFX]
			VFX_IDS = ranger_sword_effect
			location = bow_ae
		}

		[Animation Template=RangedAttackAnimation]
		{
			IDS = range
			key_ratio = 0.65

			[WhenStart Template=FXC_Equipment]
			action = UNHIDE
			location = RHAND
			equipment_type_ids = arrow

			[WhenDo Template=FXC_Equipment]
			action = HIDE
			location = RHAND
			equipment_type_ids = Arrow

			[WhenStart template=FXC_CreateVFX]
			VFX_IDS = ranger_bow_effect
			location = bow_ae

			[WhenStart template=FXC_CreateVFX]
			VFX_IDS = ranger_arrow_effect
			location = RHAND

			[WhenEnd Template=FXC_Equipment]
			action = HIDE
			location = RHAND
			equipment_type_ids = Arrow
		}

		[Animation Template=CastAnimation]
		IDS = cast
		key_ratio = 0.6

		[Animation Template=IdleAnimation]
		IDS = idlecast
	}

	[EconomyComponent]
	{
		[Cost]
		gold = 26

		[Upkeep]
		wood = 1
		mana = 1
	}

	[ElementComponent]
	{
		morale_value = 11
		required_structures = base_library
		required_properties = faction_council, good
	}

	[MoverComponent]
	{
		speed_max = 4.5

		[TrackInfo Template=K2TracksBipedRight]

		[TrackInfo Template=K2TracksBipedLeft]
	}

	[PerformerComponent]
	{
		cv_bias = 2

		[Ability Template=K2MeleeLocal]
		{
			[AbilityDefinition Template=K2MeleeAttack]
			{
				name = "#ranger_AbilityDefinition_name"
				icon = /properties/AbilityIcons/AbilityMagicIcon.png

				[Effect Template=MainDamageEffect]
				damage_type_IDS = magic
				amount = 26

				[WhenDo template=FXC_PlaySFX]
				audio_ids = ranger_slash
			}
		}

		[Ability Template=K2RangedLocal]
		{
			spawn_position = -0.3, 0.05, 1.45

			[AbilityDefinition Template=K2RangedAttack]
			{
				projectile_IDS = ranger_arrow
				name = "#ranger_AbilityDefinition_name_2"
				icon = /properties/AbilityIcons/AbilityMagicIcon.png

				[Effect Template=MainDamageEffect]
				damage_type_IDS = magic
				amount = 40 ;; ranger 38

				[WhenDo template=FXC_PlaySFX]
				audio_ids = ranger_bow
			}
		}
	}

	[PropertiesComponent]
	{
		[Property]
		property_IDS = race_human

		[Property]
		property_IDS = support

		[Property]
		property_IDS = ranged

		[Property]
		property_IDS = role_archer

		[Property]
		property_IDS = swift
	}
}
