
[Thing Template=K2ShadowBuilding]
{
	IDS = bb_shadow_woodmill_outpost
	name = "#shadow_woodmill_name"
	name_list_ids = namelist_shadow_outpost

	[View]
	{
		resource_prefix = /Structures/Shadow/ShadowWoodmill/shadowwoodmill
		icon = /UI/Game/StructureButtons/WoodmillIcon.png
	}

	[BodyComponent]
	health = 400
	captureable = true

	[ConstructionComponent]
	{
		[Upgrade]
		ids = bb_shadow_sawmill_outpost

		[Upgrade]
		ids = bb_shadow_woodmarket_outpost

		can_raze = true
	}

	[DenizenComponent]
	{
		guard_range = 24

		[Organization]
		organization_ids = workers_shadow
		behavior = WORKER

		[Organization]
		organization_ids = militia_fury
		behavior = MILITIA_OFFENSIVE

		[Inventory]
		actor_ids = nightbringer
		count = 4

		[Inventory]
		actor_ids = fury
		count = 8
	}

	[DetectionComponent]
	detection_range = 26

	[EconomyComponent]
	{
		[Cost]
		gold = 180 ;; from 3 * 60

		[Production]
		wood = 4 ;; from 2/3 * 6
	}

	[SupplyComponent]
	supply_range = 13
}
