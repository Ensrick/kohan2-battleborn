		count = 4

		[Inventory]
		actor_ids = fury
		count = 12 ;; 6
		
		[Inventory]
		actor_ids = reaver
		count = 18 ;; 6
	}
		
	[DetectionComponent]	
	detection_range = 40

	[EconomyComponent]
	{
		[Cost]
		gold = 400 ;; 80
		
