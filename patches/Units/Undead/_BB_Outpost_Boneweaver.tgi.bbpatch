@@ 1 -0 +258 @@
+;; Boneweaver, out-of-town builder (0.2.13-dev, user 2026-10-29: "copy these companies and make them
+;; semi-combat versions of themselves, so they have some function besides making just these structures").
+;; Builds only the out-of-town wood mill; stats halfway to the race's basic infantry (Skeleton: 220 hp, def 3, melee 20, speed 3.5, gold 12).
+;; PLACEHOLDER NAME: the user names unit types.
+
+
+[Unit template=K2UndeadUnit]
+{
+	IDS = bb_undead_outpost_boneweaver
+	name = "#bb_undead_outpost_boneweaver_name"
+	description = "#bb_undead_outpost_boneweaver_description"
+ 	
+	[View]
+	resource_prefix = /Units/Undead/Boneweaver/Boneweaver
+			
+	[BodyComponent]
+	health = 170 ;; Boneweaver 120
+	defense = 2 ;; Boneweaver 1
+	
+	[BuilderComponent template=BuilderComponent]
+	{
+		[BuildActor]
+		actor_ids = bb_undead_woodmill_outpost
+	}
+
= Units/Undead/boneweaver.tgi 39-80
+		gold = 9 ;; Boneweaver 6
+		
= Units/Undead/boneweaver.tgi 83-123
+				amount = 15 ;; Boneweaver 10
+				
= Units/Undead/boneweaver.tgi 126-143
+				amount = 2.5 ;; 10, build time x4
+				
+				[Effect Template=HealEffect]
+				targets = walls
+				amount = 12.5 ;; 50, build time x4
+
= Units/Undead/boneweaver.tgi 150-177
+				amount = 1.25 ;; 5, build time x4
+
= Units/Undead/boneweaver.tgi 180-193
+				amount = 1.25 ;; 5, build time x4
+				
= Units/Undead/boneweaver.tgi 196-208
+		
= Units/Undead/boneweaver.tgi 210-210
+		property_IDS = bb_settler_flank
+
= Units/Undead/bone_golem.tgi 200-203
= Units/Haroun/caretaker.tgi 183-189
+;; Battleborn: the company this builder leads (the company editor's front slot is locked to the company type)
+[Thing template=K2UndeadCompany]
+{
+	IDS = company_bb_undead_outpost_boneweaver
+	name = "#company_bb_undead_outpost_boneweaver_name"
+
+	[View]
+	{
+		resource_prefix = /Units/Undead/Boneweaver/Boneweaver
= Units/Undead/boneweaver.tgi 232-232
+
= Units/Undead/boneweaver.tgi 234-246
+		property_IDS = role_engineer
+	}
+
= Units/Undead/ghoul.tgi 231-234
+
= Units/Undead/ghoul.tgi 236-236
+		element_IDS = bb_undead_outpost_boneweaver
+
= Units/Undead/skeleton.tgi 167-168
+
= Units/Undead/skeleton.tgi 170-171
+
= Units/Undead/skeleton.tgi 173-174
+
= Units/Undead/skeleton.tgi 176-176
+		element_IDS = reaper
+	}
= Units/Undead/skeleton.tgi 179-179
