+;; Ranger Sergeant - budget ranged captain (design: Aethyn Farhyd model, gold armor)
+;; TEXTURE DEBT: gold-armor recolor of AethanFarhydBase.dds + own icon
+;; Own portrait entry: Units/Nationalist loads after Units/Human, so aethan_farhyd_portrait
+;; does not exist yet when this file loads.
+
+/******************************************  AETHAN PORTRAIT  ******************************/
+
+[Thing Template=Portrait]
+{
+	ids = bb_captain_bowman_portrait
+	name = "#aethan_farhyd_portrait_name"
+
+	[View]
+	{
+		resource_prefix = /Units/Nationalist/AethanFarhyd/AethanFarhydPortrait
+
= Units/Fallen/daevai.tgi 13-19
+
= Units/Fallen/daevai.tgi 21-29
