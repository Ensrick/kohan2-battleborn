
[Unit template = K2DraugaUnit]
{
	IDS = settler
	name = "#settler_name"
	description = "#settler_description"
 	
	[View]
	{
		resource_prefix = Settler/Settler

		[WhenCreated Template=FXC_Equipment]
		action = UNHIDE
		location = RHAND
		equipment_type_ids = staff

		[WhenCreated Template=FXC_Equipment]
		action = HIDE
		location = rhand
		equipment_type_ids = pickaxe

		[WhenCreated Template=FXC_Equipment]
		action = HIDE
		location = lhand
		equipment_type_ids = hammer
	}
	
	[BodyComponent]
	health = 180
	defense = 0
	
	[CharacterComponent]
	{
		[Animation Template=MoveAnimation]
		IDS = walk
		walk_distance = 2
				
		[Animation Template=MoveAnimation]
		IDS = jog
		walk_distance = 3
		
		[Animation Template=IdleAnimation]
		IDS = idle
		
		[Animation Template=MeleeIdleAnimation]
		IDS = idlemelee
		
		[Animation Template=FidgetAnimation]
		IDS = fidget1

		[Animation Template=FidgetAnimation]
		IDS = fidget2
				
		[Animation Template=DieAnimation]
		{
			IDS = die1
			
			[WhenStart template=FXC_PlaySFX]
			audio_ids = settler_death
		}
						
		[Animation Template=MeleeAttackAnimation]
		IDS = melee1
		key_ratio = 0.6
		
		[Animation Template=BuildAnimation]
		{
			IDS = build1
			key_ratio = 0.5

			[WhenStart Template=FXC_Equipment]
			action = UNHIDE
			location = lhand
			equipment_type_ids = hammer

			[WhenStart Template=FXC_Equipment]
			action = HIDE
			location = rhand
			equipment_type_ids = staff

			[WhenEnd Template=FXC_Equipment]
			action = UNHIDE
			location = rhand
			equipment_type_ids = staff

			[WhenEnd Template=FXC_Equipment]
			action = HIDE
			location = lhand
			equipment_type_ids = hammer
		}
		
		[Animation Template=BuildAnimation]
		{
			IDS = build2
			key_ratio = 0.5

			[WhenStart Template=FXC_Equipment]
			action = UNHIDE
			location = rhand
			equipment_type_ids = pickaxe

			[WhenStart Template=FXC_Equipment]
			action = HIDE
			location = rhand
			equipment_type_ids = staff

			[WhenEnd Template=FXC_Equipment]
			action = UNHIDE
			location = rhand
			equipment_type_ids = staff

			[WhenEnd Template=FXC_Equipment]
			action = HIDE
			location = rhand
			equipment_type_ids = pickaxe
		}
	}

	[BuilderComponent]
	{
		[BuildActor]
		actor_ids = drauga_center_village
	}

	[EconomyComponent]
	{
		[Cost]
		gold = 2 ;; 5
		
		[Upkeep]
		stone = 0.5 ;; 1
	}
	
	[ElementComponent]
	morale_value = 8
	required_structures = drauga_center_village
	
	[MoverComponent]
	{
		speed_max = 3
		
		[TrackInfo Template=K2TracksBipedRight]
		
		[TrackInfo Template=K2TracksBipedLeft]
	}
	
	[PerformerComponent]
	{	
		[Ability Template=K2MeleeLocal]
		{
			[AbilityDefinition Template=K2MeleeAttack]
			{
				name = "#settler_AbilityDefinition_name"
							
				[Effect Template=MainDamageEffect]
				damage_type_IDS = melee
				amount = 12
				
				[WhenDo template=FXC_PlaySFX]
				audio_ids = metal_swing1
			}
		}
		
		[Ability Template=K2ConstructLocalSettlement]
		{
			animation1 = build1
			animation2 = build2

			[AbilityDefinition Template=K2ConstructActionSettlement]
			{
				[Effect Template=HealEffect]
				amount = 20
				
				[WhenDo template=FXC_PlaySFX]
				audio_ids = worker_build
			}
		}
	}
	
	[PropertiesComponent]
	{
		[Property]
		property_IDS = race_drauga

		[Property]
		property_IDS = front

		[Property]
		property_IDS = bb_settler_flank

		[Property]
		property_IDS = role_settler
	}
}

[Thing template = K2DraugaCompany]
{
	IDS = company_settler
	name = "#settler_company_settler_name"
	
	[View]
	{
		resource_prefix = Settler/Settler
		banner_icon = /Organizations/BannerIcons/SettlerIcon.tga
 
		[WhenSelected Template=FXC_PlaySFX]
		audio_ids = settler_select

		[WhenCommanded Template=FXC_PlaySFX]
		audio_ids = settler_move

		[WhenCommandedAggressive Template=FXC_PlaySFX]
		audio_ids = settler_attack
	}

	[PropertiesComponent]
	{
		[Property]
		property_IDS = role_settler
	}

	[OrganizationComponent]
	{
		layout_IDS = company_settler
		entrenchment_time = 60
		
		[Slot]	;; front
		element_IDS = settler
		
		[Slot]	;; bb_settler_flank
		element_IDS = settler

		[Slot]	;; support
		element_IDS = pack_beast
		
		[Slot]	;; captain
		element_IDS = warlord
	}	
}
