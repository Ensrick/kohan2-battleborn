
;; Knight - Royalist front/flank cavalry (design tier 4, from Paladin)
;; TEXTURE DEBT: silver-only paladin skin + own icon (currently default paladin art)

[Unit template = K2RoyalistUnit]
{
	IDS = bb_front_paladin
	name = "#bb_front_paladin_name"

	[Size]
	{
		blocking_radius = 0.75
		soft_shape = RECT
		rect_width = 1.5
		rect_height = 3.0
	}

	[View]
	resource_prefix = Paladin/Paladin

	[BodyComponent]
	health = 400 ;; paladin 460
	defense = 4 ;; paladin 5

	[CharacterComponent]
	{
		[Animation Template=MoveAnimation]
		IDS = walk
		walk_distance = 1.5

		[Animation Template=MoveAnimation]
		IDS = jog
		walk_distance = 2.5

		[Animation Template=IdleAnimation]
		IDS = idle

		[Animation Template=MeleeIdleAnimation]
		IDS = idlemelee

		[Animation Template=FidgetAnimation]
		IDS = fidget1

		[Animation Template=FidgetAnimation]
		IDS = fidget2

		[Animation Template=DieAnimation]
		{
			IDS = die1

			[WhenStart template=FXC_PlaySFX]
			audio_ids = paladin_death
		}

		[Animation Template=DieAnimation]
		{
			IDS = die2

			[WhenStart template=FXC_PlaySFX]
			audio_ids = paladin_death
		}

		[Animation Template=MeleeAttackAnimation]
		IDS = melee1
		key_ratio = 0.6

		[Animation Template=MeleeAttackAnimation]
		IDS = melee2
		key_ratio = 0.6
	}

	[EconomyComponent]
	{
		[Cost]
		gold = 20 ;; paladin 28

		[Upkeep]
		iron = 1
	}

	[ElementComponent]
	{
		morale_value = 11 ;; paladin 12
		required_structures = base_barracks
		required_properties = faction_royalist, good
	}

	[MoverComponent]
	{
		speed_max = 4

		[TrackInfo Template=K2TracksQuadFrontRight]

		[TrackInfo Template=K2TracksQuadBackLeft]

		[TrackInfo Template=K2TracksQuadBackRight]

		[TrackInfo Template=K2TracksQuadFrontLeft]
	}

	[PerformerComponent]
	{
		[Ability Template=K2MeleeLocal]
		{
			animation1 = melee1
			animation2 = melee2

			[AbilityDefinition Template=K2MeleeAttack]
			{
				name = "#paladin_AbilityDefinition_name"

				[Effect Template=MainDamageEffect]
				damage_type_IDS = melee
				amount = 32 ;; paladin 40 magic

				[WhenDo template=FXC_PlaySFX]
				audio_ids = metal_swing3
			}
		}
	}

	[PropertiesComponent]
	{
		[Property]
		property_IDS = front

		[Property]
		property_IDS = flank

		[Property]
		property_IDS = armored

		[Property]
		property_IDS = melee

		[Property]
		property_IDS = role_cavalry
	}
}
