
/******************************************  INFANTRY CAPTAIN PORTRAIT  ******************************/

[Thing Template=Portrait]
{
	ids = captain_infantry_talk
	name = "#ghalen_mordecai_talk_name"

	[View]
	{
		resource_prefix = /Units/Nationalist/GhalenMordecai/GhalenMordecaiTalk

		[AspectNormal]
		{
			[Animation Template=ObjectAnimationIdle]
			IDS = 1

			[Animation Template=ObjectAnimationIdle]
			IDS = 2
			
			[Animation Template=ObjectAnimationIdle]
			IDS = 3
		}
	}
}

/******************************************  INFANTRY CAPTAIN PORTRAIT  ******************************/

[Thing Template=Portrait]
{
	ids = captain_infantry_portrait
	name = "#ghalen_mordecai_portrait_name"

	[View]
	{
		resource_prefix = /Units/Nationalist/GhalenMordecai/GhalenMordecaiPortrait

		[AspectNormal]
		{
			skin = /Units/Human/_BB_Captain_Infantry/bb_captain_infantry_portrait.dds

			[Animation Template=ObjectAnimationIdle]
