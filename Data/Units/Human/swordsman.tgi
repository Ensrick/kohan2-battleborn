
/******************************************  SWORDSMAND VFX  **********************************/

[VFX template=VFXExtrusion]
{
	ids = blur_melee0
	name = "#swordsman_blur_slash0_name"

	duration = 0.2
	
	[Extrusion]
	{
		ids = blur_melee0
		start_delay = 0.35
		segment_lifetime = 0
		segment_fadetime = 0.1
		
		[ExtrusionPoint]
		extrusion_root = ep0
		node_color = 0.70, 0.70, 0.70
		node_alpha = 100%

		[ExtrusionPoint]
		extrusion_root = ep1
		node_color = 0.78, 0.78, 0.78
		node_alpha = 80%

		[ExtrusionPoint]
		extrusion_root = ep2
		node_color = 0.78, 0.78, 0.78
		node_alpha = 0%
	
		[Connectivity]
		point_a = ep0
		point_b = ep1	

		[Connectivity]
		point_a = ep1
		point_b = ep2	
	}
}

[VFX template=VFXExtrusion]
{
	ids = blur_melee1
	name = "#swordsman_blur_slash1_name"

	duration = 0.2
	
	[Extrusion]
	{
		ids = blur_melee1
		start_delay = 0.45
		segment_lifetime = 0
		segment_fadetime = 0.1
		
		[ExtrusionPoint]
		extrusion_root = ep0
		node_color = 0.70, 0.70, 0.70
		node_alpha = 100%

		[ExtrusionPoint]
		extrusion_root = ep1
		node_color = 0.78, 0.78, 0.78
		node_alpha = 80%

		[ExtrusionPoint]
		extrusion_root = ep2
		node_color = 0.78, 0.78, 0.78
		node_alpha = 0%
	
		[Connectivity]
		point_a = ep0
		point_b = ep1

		[Connectivity]
		point_a = ep1
		point_b = ep2
	}
}

/******************************************  SWORDSMAN UNIT  **********************************/

[Unit template=K2HumanUnit]
{
	IDS = swordsman
	name = "#swordsman_name"
	
	[View]
	{
		resource_prefix = Swordsman/Swordsman

		[AspectNormal]
		skin = %sbase.dds
	}
			
	[BodyComponent]
	health = 240
	defense = 4
	
	[CharacterComponent]
	{
		[Animation Template=MoveAnimation]
		IDS = walk
		walk_distance = 1.7
				
		[Animation Template=MoveAnimation]
		IDS = jog
		walk_distance = 2.5
		
		[Animation Template=IdleAnimation]
		IDS = idle
		
		[Animation Template=MeleeIdleAnimation]
		IDS = idlemelee
		
		[Animation Template=FidgetAnimation]
		IDS = fidget1

		[Animation Template=FidgetAnimation]
		IDS = fidget2
				
		[Animation Template=DieAnimation]
		{
			IDS = die1
			
			[WhenStart template=FXC_PlaySFX]
			audio_ids = swordsman_death
		}
						
		[Animation Template=MeleeAttackAnimation]
		IDS = melee1
		key_ratio = 0.4
						
		[Animation Template=MeleeAttackAnimation]
		IDS = melee2
		key_ratio = 0.55
	}

	[EconomyComponent]
	{
		[Cost]
		gold = 8 ;; 16
		
		[Upkeep]
		iron = 0.5 ;; 1
	}
	
	[ElementComponent]
	morale_value = 11
	required_structures = human_center_town
	denizen_type = denizen_type_melee
	group_priority = 2
	
	[MoverComponent]
	{
		speed_max = 2.5

		[TrackInfo Template=K2TracksBipedRight]
		
		[TrackInfo Template=K2TracksBipedLeft]
	}
	
	[PerformerComponent]
	{
		
		[Ability Template=K2MeleeLocal]
		{
			animation1 = melee1
			animation2 = melee2
			
			[AbilityDefinition Template=K2MeleeAttack]
			{
				name = "#swordsman_AbilityDefinition_name"
							
				[Effect Template=MainDamageEffect]
				damage_type_IDS = melee
				amount = 20
				
				[WhenDo template=FXC_PlaySFX]
				audio_ids = metal_swing3				
			}
		}
	}
	
	[PropertiesComponent]
	{
		[Property]
		property_IDS = race_human

		[Property]
		property_IDS = armored

		[Property]
		property_IDS = shields

		[Property]
		property_IDS = front
		
		[Property]
		property_IDS = flank
		
		[Property]
		property_IDS = melee
		
		[Property]
		property_IDS = role_infantry
	}
}

[Thing template=K2HumanCompany]
{
	IDS = company_swordsman
	name = "#swordsman_company_swordsman_name"

	[View]
	{
		resource_prefix = Swordsman/Swordsman	
		banner_icon = /Organizations/BannerIcons/InfantryIcon.tga
 
		[WhenSelected Template=FXC_PlaySFX]
		audio_ids = swordsman_select

		[WhenCommanded Template=FXC_PlaySFX]
		audio_ids = swordsman_move

		[WhenCommandedAggressive Template=FXC_PlaySFX]
		audio_ids = swordsman_attack
	}

	[PropertiesComponent]
	{
		[Property]
		property_IDS = company_melee
	}

	[OrganizationComponent]
	{
		layout_IDS = company_standard
		entrenchment_time = 60
		
		[Slot]	;; front
		element_IDS = swordsman
		
		[Slot]	;; flank
		element_IDS = swordsman
		
		[Slot]	;; support
		element_IDS = null
		
		[Slot]	;; support
		element_IDS = null
		
		[Slot]	;; captain
		element_IDS = bb_captain_infantry
	}	
}

[Thing template=K2HumanMilitia]
{
	IDS = militia_swordsman
	name = "#swordsman_militia_swordsman_name"
	
	[View]
	resource_prefix = Swordsman/Swordsman
	banner_icon = /Organizations/BannerIcons/InfantryIcon.tga
	
	[OrganizationComponent]
	{
		layout_IDS = company_militia
		entrenchment_time = 300
		
		[Slot]	;; front
		element_IDS = swordsman
		
		[Slot]	;; support
		element_IDS = null
	}	
}
