
[Unit template=K2GauriUnit]
{
	IDS = founder
	name = "#founder_name"
	description = "#founder_description"
 	
	[View]
	resource_prefix = Founder/Founder	
		
	[BodyComponent]
	health = 120
	defense = 2
	
	[BuilderComponent]
	{
		[BuildActor]
		actor_ids = gauri_center_village
	}

	[CharacterComponent]
	{
		[Animation Template=MoveAnimation]
		IDS = walk
		walk_distance = 1.7
				
		[Animation Template=MoveAnimation]
		IDS = jog
		walk_distance = 2
		
		[Animation Template=IdleAnimation]
		IDS = idle
		
		[Animation Template=MeleeIdleAnimation]
		IDS = idlemelee
		
		[Animation Template=FidgetAnimation]
		IDS = fidget1
				
		[Animation Template=FidgetAnimation]
		IDS = fidget2
				
		[Animation Template=DieAnimation]
		{
			IDS = die1

			[WhenStart template=FXC_PlaySFX]
			audio_ids = founder_death
		}
				
		[Animation Template=DieAnimation]
		{
			IDS = die2

			[WhenStart template=FXC_PlaySFX]
			audio_ids = founder_death
		}
				
		[Animation Template=MeleeAttackAnimation]
		IDS = melee1
		key_ratio = 0.5
						
		[Animation Template=BuildAnimation]
		IDS = build1
		key_ratio = 0.5

		[Animation Template=BuildAnimation]
		IDS = build2
		key_ratio = 0.5
	}

	[EconomyComponent]
	{
		[Cost]
		gold = 2 ;; 5

		[Upkeep]
		stone = 0.5 ;; 1
	}
	
	[ElementComponent]
	morale_value = 7
	required_structures = gauri_center_village
	
	[MoverComponent]
	{
		speed_max = 3.0
		
		[TrackInfo Template=K2TracksBipedRight]
		
		[TrackInfo Template=K2TracksBipedLeft]
	}
		
	[PerformerComponent]
	{	
		[Ability Template=K2MeleeLocal]
		{
			animation1 = melee1
			
			[AbilityDefinition Template=K2MeleeAttack]
			{
				name = "#founder_AbilityDefinition_name"
							
				[Effect Template=MainDamageEffect]
				damage_type_IDS = melee
				amount = 10
				
				[WhenDo template=FXC_PlaySFX]
				audio_ids = metal_swing3
			}
		}
		
		[Ability Template=K2ConstructLocalSettlement]
		{
			animation1 = build1
			animation2 = build2

			[AbilityDefinition Template=K2ConstructActionSettlement]
			{
				[Effect Template=HealEffect]
				amount = 20
				
				[WhenDo template=FXC_PlaySFX]
				audio_ids = worker_build
			}
		}
	}
	
	[PropertiesComponent]
	{
		[Property]
		property_IDS = race_gauri

		[Property]
		property_IDS = front

		[Property]
		property_IDS = bb_settler_flank

		[Property]
		property_IDS = role_settler
	}
}

[Thing Template=K2GauriCompany]
{
	IDS = company_founder
	name = "#founder_company_founder_name"
	
	[View]
	{
		resource_prefix = Founder/Founder
		banner_icon = /Organizations/BannerIcons/SettlerIcon.tga
 
		[WhenSelected Template=FXC_PlaySFX]
		audio_ids = founder_select

		[WhenCommanded Template=FXC_PlaySFX]
		audio_ids = founder_move

		[WhenCommandedAggressive Template=FXC_PlaySFX]
		audio_ids = founder_attack
	}

	[PropertiesComponent]
	{
		[Property]
		property_IDS = role_settler
	}

	[OrganizationComponent]
	{
		layout_IDS = company_settler
		entrenchment_time = 60
		
		[Slot]	;; front
		element_IDS = founder

		[Slot]	;; bb_settler_flank
		element_IDS = founder
		
		[Slot]	;; support
		element_IDS = baluch
		
		[Slot]	;; captain
		element_IDS = leader
	}	
}
