
[Unit template=K2ShadowUnit]
{
	IDS = nightbringer
	name = "#Nightbringer_name"
	description = "#Nightbringer_description"
 	
	[View]
	{
		resource_prefix = Nightbringer/Nightbringer

		[AspectNormal]
		skin = %sbase.dds
	}
		
	[BodyComponent]
	health = 180
	defense = 1
	
	[BuilderComponent template=BuilderComponent]
	{
		[BuildActor]
		actor_ids = shadow_center_village
		
		[BuildActor]
		actor_ids = shadow_outpost

		[BuildActor]
		actor_ids = bb_shadow_woodmill_outpost
	
		[BuildActor]
		actor_ids = shadow_mine_gold
		
		[BuildActor]
		actor_ids = shadow_mine_stone
		
		[BuildActor]
		actor_ids = shadow_mine_wood
		
		[BuildActor]
		actor_ids = shadow_mine_iron
		
		[BuildActor]
		actor_ids = shadow_mine_mana	
	}

	[CharacterComponent]
	{
		[Animation Template=MoveAnimation]
		IDS = walk
		walk_distance = 1.5
				
		[Animation Template=MoveAnimation]
		IDS = jog
		walk_distance = 2.5
		
		[Animation Template=IdleAnimation]
		IDS = idle
		
		[Animation Template=MeleeIdleAnimation]
		IDS = idlemelee
		
		[Animation Template=FidgetAnimation]
		IDS = fidget1

		[Animation Template=FidgetAnimation]
		IDS = fidget2
				
		[Animation Template=DieAnimation]
		{
			IDS = die1

			[WhenStart template=FXC_PlaySFX]
			audio_ids = nightbringer_death
		}
		
		[Animation Template=DieAnimation]
		{
			IDS = die2

			[WhenStart template=FXC_PlaySFX]
			audio_ids = nightbringer_death
		}
				
		[Animation Template=MeleeAttackAnimation]
		IDS = melee1
		key_ratio = 0.44
		
		[Animation Template=BuildAnimation]
		IDS = build1
		key_ratio = 0.6

		[Animation Template=BuildAnimation]
		IDS = build2
		key_ratio = 0.6

		[Animation Template=CastAnimation]
		IDS = cast
   		key_ratio = 0.48

		[Animation Template=IdleAnimation]
		IDS = idlecast	
	}

	[EconomyComponent]
	{
		[Cost]
		gold = 5
			
		[Upkeep]
		stone = 1
	}
	
	[ElementComponent]
	{
		morale_value = 15
		required_structures = shadow_center_village
		denizen_type = denizen_type_worker
	
		[SupportProperty]
		property_IDS = rapid_entrench
	}
	
	[MoverComponent]
	{
		speed_max = 3
		
		[TrackInfo Template=K2TracksBipedRight]
		
		[TrackInfo Template=K2TracksBipedLeft]
	}
	
	[PerformerComponent]
	{	
		[Ability Template=K2MeleeLocal]
		{
			animation1 = melee1
			
			[AbilityDefinition Template=K2MeleeAttack]
			{
				name = "#Nightbringer_AbilityDefinition_name"
							
				[Effect Template=MainDamageEffect]
				damage_type_IDS = melee
				amount = 10
				
				[WhenDo template=FXC_PlaySFX]
				audio_ids = nonmetal_swing2
			}
		}
		
		[Ability Template=K2RepairLocal]
		{			
			animation1 = build1
			animation2 = build2
			
			[AbilityDefinition Template=K2RepairAction]
			{
				[Effect Template=HealEffect]
				amount = 12

				[WhenDo template=FXC_PlaySFX]
				audio_ids = worker_build_shadow
			}
		}
		
		[Ability Template=K2ConstructLocalSettlement]
		{
			animation1 = build1
			animation2 = build2
			
			[AbilityDefinition Template=K2ConstructActionSettlement]
			{
				[Effect Template=HealEffect]
				amount = 8

				[WhenDo template=FXC_PlaySFX]
				audio_ids = worker_build_shadow
			}
		}
		
		[Ability Template=K2ConstructLocal]
		{
			animation1 = build1
			animation2 = build2
			required_properties = role_engineer

			[AbilityDefinition Template=K2ConstructAction]
			{
				[Effect Template=HealEffect]
				amount = 8
				
				[WhenDo template=FXC_PlaySFX]
				audio_ids = worker_build_shadow
			}
		}
		
		[Ability Template=K2RepairAllLocal]
		{		
			animation1 = build1
			animation2 = build2
			
			[AbilityDefinition Template=K2RepairAllAction]
			{
				[Effect Template=HealEffect]
				amount = 10
				
				[Effect Template=HealEffect]
				targets = walls
				amount = 20				

				[WhenDo template=FXC_PlaySFX]
				audio_ids = worker_build_shadow
			}
		}
	}
	
	[PropertiesComponent]
	{
		[Property]
		property_IDS = front

		[Property]
		property_IDS = role_settler
		
		[Property]
		property_IDS = role_engineer
	}
}

[Thing template=K2ShadowCompany]
{
	IDS = horde_nightbringer
	name = "#Nightbringer_horde_nightbringer_name"
	
	[View]
	{
		resource_prefix = Nightbringer/Nightbringer	
		banner_icon = /Organizations/BannerIcons/SettlerIcon.tga
 
		[WhenSelected Template=FXC_PlaySFX]
		audio_ids = nightbringer_select

		[WhenCommanded Template=FXC_PlaySFX]
		audio_ids = nightbringer_move

		[WhenCommandedAggressive Template=FXC_PlaySFX]
		audio_ids = nightbringer_attack
	}

	[PropertiesComponent]
	{
		[Property]
		property_IDS = role_settler
		
		[Property]
		property_IDS = role_engineer
	}

	[OrganizationComponent]
	{
		layout_IDS = horde_settler
		entrenchment_time = 60
		
		[Slot]	;; front
		element_IDS = nightbringer
		
		[Slot]	;; captain
		element_IDS = shade
	}	
}

[Thing Template=K2ShadowWorkers]
{
	IDS = workers_shadow
	name = "#Nightbringer_workers_shadow_name"
	
	[View]
	resource_prefix = Nightbringer/Nightbringer
	banner_icon = /Organizations/BannerIcons/SettlerIcon.tga


	
	[OrganizationComponent]
	{
		layout_IDS = company_worker
		entrenchment_time = 300
		
		[Slot]	;; front
		element_IDS = nightbringer
	}	
}
