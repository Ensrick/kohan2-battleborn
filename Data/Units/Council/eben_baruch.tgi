
/******************************************  EBEN BARUCH PORTRAIT  **********************************/

[Thing Template=Portrait]
{
	ids = Eben_Baruch_portrait
	name = "#eben_baruch_portrait_name"

	[View]
	{
		resource_prefix = EbenBaruch/EbenBaruchPortrait

		[AspectNormal]
		{
			skin = %sbase.dds

			[Animation Template=ObjectAnimationIdle]
			IDS = idle

			[Animation Template=ObjectAnimationFidget]
			IDS = fidget1
			
			[Animation Template=ObjectAnimationFidget]
			IDS = fidget2

			[Animation Template=ObjectAnimationFidget]
			IDS = fidget3
		}
	}
}

/******************************************  EBEN BARUCH UNIT  **********************************/

[Thing Template=K2CouncilHero]
{
	IDS = eben_baruch
	name = "#eben_baruch_Thing_name"
	
	[View]
	{
		resource_prefix = /Units/Human/Ranger/Ranger
		portrait_ids = eben_baruch_portrait
		icon = EbenBaruch/EbenBaruchIcon.tga

		[AspectNormal]
		skin = EbenBaruch/EbenBaruchBase.dds
	
		[WhenCreated Template=FXC_Equipment]
		action = UNHIDE
		location = LHAND
		equipment_type_ids = bow

		[WhenCreated Template=FXC_Equipment]
		action = HIDE
		location = LHAND
		equipment_type_ids = sword

		[WhenSelected Template=FXC_PlaySFX]
		audio_ids = human_co_m_select

		[WhenCommanded Template=FXC_PlaySFX]
		audio_ids =  human_co_m_move

		[WhenCommandedAggressive Template=FXC_PlaySFX]
		audio_ids =  human_co_m_attack
	}
	
	[BodyComponent]
	health = 800
	defense = 2
	
	
	[CharacterComponent]
	{
		[Animation Template=MoveAnimation]
		IDS = walk
		walk_distance = 1.5
				
		[Animation Template=MoveAnimation]
		IDS = jog
		walk_distance = 2.5
		
		[Animation Template=IdleAnimation]
		IDS = idle
		
		[Animation Template=MeleeIdleAnimation]
		{
			IDS = idlemelee

			[WhenStart Template=FXC_Equipment]
			action = UNHIDE
			location = LHAND
			equipment_type_ids = sword

			[WhenStart Template=FXC_Equipment]
			action = HIDE
			location = LHAND
			equipment_type_ids = bow

			[WhenEnd Template=FXC_Equipment]
			action = HIDE
			location = LHAND
			equipment_type_ids = sword

			[WhenEnd Template=FXC_Equipment]
			action = UNHIDE
			location = LHAND
			equipment_type_ids = bow
		}
		
		[Animation Template=RangedIdleAnimation]
		IDS = idlerange
				
		[Animation Template=FidgetAnimation]
		IDS = fidget1

		[Animation Template=FidgetAnimation]
		IDS = fidget2
				
		[Animation Template=DieAnimation]
		{
			IDS = die1
			
			[WhenStart template=FXC_PlaySFX]
			audio_ids = ranger_death
		}
						
		[Animation Template=MeleeAttackAnimation]
		{
			IDS = melee1
			key_ratio = 0.6

			[WhenStart Template=FXC_Equipment]
			action = UNHIDE
			location = LHAND
			equipment_type_ids = sword

			[WhenStart Template=FXC_Equipment]
			action = HIDE
			location = LHAND
			equipment_type_ids = bow

			[WhenEnd Template=FXC_Equipment]
			action = HIDE
			location = LHAND
			equipment_type_ids = sword

			[WhenEnd Template=FXC_Equipment]
			action = UNHIDE
			location = LHAND
			equipment_type_ids = bow
		}				
						
		[Animation Template=RangedAttackAnimation]
		{
			IDS = range
			key_ratio = 0.55
			
			[WhenStart Template=FXC_Equipment]
			action = UNHIDE
			location = RHAND
			equipment_type_ids = arrow
			
			[WhenDo Template=FXC_Equipment]
			action = HIDE
			location = RHAND
			equipment_type_ids = Arrow

			[WhenStart template=FXC_CreateVFX]
			VFX_IDS = ranger_bow_effect
			location = bow_ae

			[WhenStart template=FXC_CreateVFX]
			VFX_IDS = ranger_arrow_effect
			location = RHAND

			[WhenEnd Template=FXC_Equipment]
			action = HIDE
			location = RHAND
			equipment_type_ids = Arrow
		}
		
		[Animation Template=CastAnimation]
		IDS = cast
		key_ratio = 0.6

		[Animation Template=CastIdleAnimation]
		IDS = idlecast	
	}

	[ElementComponent]
	{
		morale_value = 12
		primary_minimum_health = 0.5
		
		[SupportProperty]
		property_IDS = trailblazing
	}
		
	[MoverComponent]
	{
		speed_max = 5
		
		[TrackInfo Template=K2TracksBipedRight]
		
		[TrackInfo Template=K2TracksBipedLeft]
	}
	
	[PerformerComponent]
	{
		[Ability Template=K2MeleeLocal]
		{
			[AbilityDefinition Template=K2meleeAttack]
			{
				name = "#eben_baruch_AbilityDefinition_name"
				icon = /properties/AbilityIcons/AbilityMagicIcon.png
				
				[Effect Template=MainDamageEffect]
				damage_type_IDS = magic
				amount = 30
				
				[WhenDo template=FXC_PlaySFX]
				audio_ids = ranger_slash
			}
		}
		
		[Ability Template=K2RangedLocal]
		{
			spawn_position = -0.3, 0.05, 1.45

			[AbilityDefinition Template=K2RangedAttack]
			{
				projectile_IDS = ranger_arrow
				name = "#eben_baruch_AbilityDefinition_name_2"
				icon = /properties/AbilityIcons/AbilityMagicIcon.png
			
				[Effect Template=MainDamageEffect]
				damage_type_IDS = magic
				amount = 40
				
				[WhenDo template=FXC_PlaySFX]
				audio_ids = ranger_bow
			}
		}

		[Ability template=K2SpellEnchantmentLocal]
		ability_IDS = earthskin
		required_experience_min = 0
		required_experience_max = 1

		[Ability template=K2SpellEnchantmentLocal]
		ability_IDS = earthskin2
		required_experience_min = 2
		required_experience_max = 3

		[Ability template=K2SpellEnchantmentLocal]
		ability_IDS = earthskin3
		required_experience_min = 4
		required_experience_max = 4
	}

	[PropertiesComponent]
	{
		[Property]
		property_IDS = captain

		[Property]
		property_IDS = race_kohan
	}
}
