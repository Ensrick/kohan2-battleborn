
;; Rune Hammer - Council cavalry front/flank (design tier 4, Gauri Hammer ram-rider model)
;; TEXTURE DEBT: rune skin + own icon (ships with default Hammer art; see Rune Lord's
;; BB_Runelord art note in _BB_Captain_Rune_Lord.tgi)

[Unit template=K2CouncilUnit]
{
	IDS = bb_front_council_hammer
	name = "#bb_front_council_hammer_name"

	[View]
	resource_prefix = /Units/Gauri/Hammer/Hammer

	[BodyComponent]
	health = 360 ;; hammer 320
	defense = 6

	[CharacterComponent]
	{
		[Animation Template=MoveAnimation]
		IDS = walk
		walk_distance = 1.75

		[Animation Template=MoveAnimation]
		IDS = jog
		walk_distance = 3

		[Animation Template=IdleAnimation]
		IDS = idle

		[Animation Template=MeleeIdleAnimation]
		IDS = idlemelee

		[Animation Template=FidgetAnimation]
		IDS = fidget1

		[Animation Template=FidgetAnimation]
		IDS = fidget2

		[Animation Template=DieAnimation]
		{
			IDS = die1

			[WhenStart template=FXC_PlaySFX]
			audio_ids = hammer_death
		}

		[Animation Template=DieAnimation]
		{
			IDS = die2

			[WhenStart template=FXC_PlaySFX]
			audio_ids = hammer_death
		}

		[Animation Template=MeleeAttackAnimation]
		IDS = melee1
		key_ratio = 0.6

		[Animation Template=MeleeAttackAnimation]
		IDS = melee2
		key_ratio = 0.6
	}

	[EconomyComponent]
	{
		[Cost]
		gold = 22

		[Upkeep]
		iron = 1
	}

	[ElementComponent]
	morale_value = 13 ;; hammer 13
	required_structures = base_blacksmith
	required_properties = faction_council, good
	denizen_type = denizen_type_melee

	[MoverComponent]
	{
		speed_max = 3.5

		[TrackInfo Template=K2TracksQuadSmallLargeHoofFrontRight]

		[TrackInfo Template=K2TracksQuadSmallLargeHoofBackLeft]

		[TrackInfo Template=K2TracksQuadSmallLargeHoofBackRight]

		[TrackInfo Template=K2TracksQuadSmallLargeHoofFrontLeft]
	}

	[PerformerComponent]
	{
		[Ability Template=K2MeleeLocal]
		{
			animation1 = melee1
			animation2 = melee2

			[AbilityDefinition Template=K2MeleeAttack]
			{
				name = "#hammer_AbilityDefinition_name"

				[Effect Template=MainDamageEffect]
				damage_type_IDS = melee
				amount = 28 ;; hammer 24

				[WhenDo template=FXC_PlaySFX]
				audio_ids = metal_swing3
			}
		}
	}

	[PropertiesComponent]
	{
		[Property]
		property_IDS = race_gauri

		[Property]
		property_IDS = front

		[Property]
		property_IDS = flank

		[Property]
		property_IDS = melee

		[Property]
		property_IDS = role_cavalry

		[Property]
		property_IDS = agile
	}
}
