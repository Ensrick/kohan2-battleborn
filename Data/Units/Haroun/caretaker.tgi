
[Thing Template=K2HarounUnit]
{
	IDS = caretaker
	name = "#caretaker_Thing_name"
	description = "#caretaker_Thing_description"
		
	[View]
	resource_prefix = Caretaker/Caretaker
		
	[BodyComponent]
	health = 160
	defense = 2
	
	[BuilderComponent template=BuilderComponent]
	{
		[BuildActor]
		actor_ids = haroun_outpost

		[BuildActor]
		actor_ids = bb_haroun_woodmill_outpost
	
		[BuildActor]
		actor_ids = haroun_mine_gold
		
		[BuildActor]
		actor_ids = haroun_mine_stone
		
		[BuildActor]
		actor_ids = haroun_mine_wood
		
		[BuildActor]
		actor_ids = haroun_mine_iron
		
		[BuildActor]
		actor_ids = haroun_mine_mana	
	}

	[CharacterComponent]
	{
		[Animation Template=MoveAnimation]
		IDS = walk
		walk_distance = 1.5
				
		[Animation Template=MoveAnimation]
		IDS = jog
		walk_distance = 2.5
		
		[Animation Template=IdleAnimation]
		IDS = idle
		
		[Animation Template=MeleeIdleAnimation]
		IDS = idlemelee
		
		[Animation Template=FidgetAnimation]
		IDS = fidget1
				
		[Animation Template=FidgetAnimation]
		IDS = fidget2
				
		[Animation Template=DieAnimation]
		{
			IDS = die1

			[WhenStart template=FXC_PlaySFX]
			audio_ids = caretaker_death
		}
				
		[Animation Template=DieAnimation]
		{
			IDS = die2

			[WhenStart template=FXC_PlaySFX]
			audio_ids = caretaker_death
		}
				
		[Animation Template=MeleeAttackAnimation]
		IDS = melee1
		key_ratio = 0.5
						
		[Animation Template=MeleeAttackAnimation]
		IDS = melee2
		key_ratio = 0.5
		
		[Animation Template=BuildAnimation]
		IDS = build1
		key_ratio = 0.5

		[Animation Template=BuildAnimation]
		IDS = build2
		key_ratio = 0.5
	}

	[EconomyComponent]
	{
		[Cost]
		gold = 10
		
		[Upkeep]
		stone = 1
	}
	
	[ElementComponent]
	{
		morale_value = 8
		required_structures = haroun_quarry
		group_priority = 1
		
		[SupportProperty]
		property_IDS = rapid_entrench
	}
	
	[MoverComponent]
	{
		speed_max = 3.5
		
		[TrackInfo Template=K2TracksBipedRight]
		
		[TrackInfo Template=K2TracksBipedLeft]
	}
	
	[PerformerComponent]
	{
		
		[Ability Template=K2MeleeLocal]
		{
			animation1 = melee1
			animation2 = melee2
			
			[AbilityDefinition Template=K2MeleeAttack]
			{
				name = "#caretaker_AbilityDefinition_name"
							
				[Effect Template=MainDamageEffect]
				damage_type_IDS = melee
				amount = 16
				
				[WhenDo template=FXC_PlaySFX]
				audio_ids = metal_swing1
			}
		}
		
		[Ability Template=K2RepairLocal]
		{			
			animation1 = build1
			animation2 = build2
			
			[AbilityDefinition Template=K2RepairAction]
			{
				[Effect Template=HealEffect]
				amount = 10

				[WhenDo template=FXC_PlaySFX]
				audio_ids = worker_build
			}
		}
		
		[Ability Template=K2ConstructLocal]
		{
			animation1 = build1
			animation2 = build2

			[AbilityDefinition Template=K2ConstructAction]
			{
				[Effect Template=HealEffect]
				amount = 1

				[WhenDo template=FXC_PlaySFX]
				audio_ids = worker_build
			}
		}
	}
	
	[PropertiesComponent]
	{
		[Property]
		property_IDS = race_haroun

		[Property]
		property_IDS = front

		[Property]
		property_IDS = melee

		[Property]
		property_IDS = role_engineer

		[Property]
		property_IDS = rapid_entrench
	}
}

[Thing Template=K2HarounCompany]
{
	IDS = company_caretaker
	name = "#caretaker_company_caretaker_name"
	
	[View]
	{
		resource_prefix = Caretaker/Caretaker
		banner_icon = /Organizations/BannerIcons/EngineerIcon.tga

		[WhenSelected Template=FXC_PlaySFX]
		audio_ids = caretaker_select

		[WhenCommanded Template=FXC_PlaySFX]
		audio_ids = caretaker_move

		[WhenCommandedAggressive Template=FXC_PlaySFX]
		audio_ids = caretaker_attack
	}
 		
	[PropertiesComponent]
	{
		[Property]
		property_IDS = role_engineer
	}

	[OrganizationComponent]
	{
		layout_IDS = company_engineer
		entrenchment_time = 60
		
		[Slot]	;; front
		element_IDS = caretaker
		
		[Slot]	;; flank
		element_IDS = caretaker
		
		[Slot]	;; captain
		element_IDS = guide
	}	
}
