;; DEFAULT COLOR
;; - expected by the code
;; - listed last so gets handed out last 
;; - the color should match AVar "ReplacementColorDefault"
[KingdomColor template=Color]
{
	IDS = default
	name = "#kingdom_colors_default_name"
	color = 1,1,1	
}

