
[Thing Template=K2HumanBuilding]
{
	IDS = bb_human_sawmill_outpost
	name = "#human_sawmill_name"
	name_list_ids = namelist_bb_human_sawmill

	[View]
	{
		resource_prefix = /Structures/Human/HumanSawmill/HumanSawmill
		icon = /UI/Game/StructureButtons/SawmillIcon.png

		[TextureSearchPath]
		path = /Structures/Human/HumanWoodmill
	}

	[BodyComponent]
	health = 750
	captureable = true

	[ConstructionComponent]
	{
		can_raze = true
	}

	[DenizenComponent]
	{
		guard_range = 24

		[Organization]
		organization_ids = workers_human
		behavior = WORKER

		[Organization]
		organization_ids = militia_bowman
		behavior = MILITIA_OFFENSIVE

		[Inventory]
		actor_ids = worker
		count = 4

		[Inventory]
		actor_ids = bowman
		count = 8
	}

	[DetectionComponent]
	detection_range = 26

	[EconomyComponent]
	{
		[Cost]
		gold = 285 ;; from 3 * 95

		[Production]
		wood = 8 ;; from 2/3 * 12
	}

	[SupplyComponent]
	supply_range = 13
}
