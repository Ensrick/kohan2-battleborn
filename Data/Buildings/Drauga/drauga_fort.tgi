
[Thing Template=K2DraugaBuilding]
{
	IDS = drauga_fort
	name = "#drauga_fort_name"
	name_list_ids = namelist_drauga_outpost

	[View]
	{
		resource_prefix = DraugaFort/DraugaFort
		icon = /UI/Game/StructureButtons/OutpostIcon.png

		[AspectNormal]
		skin = DraugaOutpost/DraugaOutpostBase.dds

		[WhenSelected Template=FXC_PlaySFX]
		audio_ids = select_drauga_outpost
	}

	[BodyComponent]
	health = 3600 ;; 1800
	captureable = true

	[DenizenComponent]
	{
		guard_range = 24

		[Organization]
		organization_ids = workers_laborer
		behavior = WORKER

		[Organization]
		organization_ids = militia_raider
		behavior = MILITIA_DEFENSIVE

		[Organization]
		organization_ids = militia_impaler
		behavior = MILITIA_OFFENSIVE

		[Organization]
		organization_ids = militia_berserker
		behavior = MILITIA_DEFENSIVE

		[Inventory]
		actor_ids = laborer
		count = 4

		[Inventory]
		actor_ids = raider
		count = 24 ;; 8

		[Inventory]
		actor_ids = impaler
		count = 24 ;; 8

		[Inventory]
		actor_ids = berserker
		count = 18
	}

	[DetectionComponent]
	detection_range = 30

	[EconomyComponent]
	{
		[Cost]
		gold = 200 ;; 80

		[Upkeep]
		stone = 6

		[Production]
		unit_limit_provided = 3
	}

	[SupplyComponent]
	supply_range = 30
}
