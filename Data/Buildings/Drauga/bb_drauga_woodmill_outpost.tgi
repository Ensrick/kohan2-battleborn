
[Thing Template=K2DraugaBuilding]
{
	IDS = bb_drauga_woodmill_outpost
	name = "#drauga_woodmill_name"
	name_list_ids = namelist_bb_drauga_woodmill

	[View]
	{
		resource_prefix = /Structures/Drauga/DraugaWoodmill/DraugaWoodmill
		icon = /UI/Game/StructureButtons/WoodmillIcon.png
	}

	[BodyComponent]
	health = 500
	captureable = true

	[ConstructionComponent]
	{
		[Upgrade]
		ids = bb_drauga_sawmill_outpost

		[Upgrade]
		ids = bb_drauga_woodmarket_outpost

		can_raze = true
	}

	[DenizenComponent]
	{
		guard_range = 24

		[Organization]
		organization_ids = workers_laborer
		behavior = WORKER

		[Organization]
		organization_ids = militia_impaler
		behavior = MILITIA_OFFENSIVE

		[Inventory]
		actor_ids = laborer
		count = 4

		[Inventory]
		actor_ids = impaler
		count = 8
	}

	[DetectionComponent]
	detection_range = 26

	[EconomyComponent]
	{
		[Cost]
		gold = 225 ;; from 3 * 75

		[Production]
		wood = 4 ;; from 2/3 * 6
	}

	[SupplyComponent]
	supply_range = 13
}
