
[Thing Template=K2UndeadBuilding]
{
	IDS = bb_undead_woodmill_outpost
	name = "#undead_woodmill_name"
	name_list_ids = namelist_undead_outpost

	[View]
	{
		resource_prefix = /Structures/Undead/UndeadWoodmill/undeadwoodmill
		icon = /UI/Game/StructureButtons/WoodmillIcon.png

		[TextureSearchPath]
		path = /Shared/SharedTextures
	}

	[BodyComponent]
	health = 400
	captureable = true

	[ConstructionComponent]
	{
		[Upgrade]
		ids = bb_undead_sawmill_outpost

		[Upgrade]
		ids = bb_undead_woodmarket_outpost

		can_raze = true
	}

	[DenizenComponent]
	{
		guard_range = 24

		[Organization]
		organization_ids = workers_undead
		behavior = WORKER

		[Organization]
		organization_ids = militia_bonearcher
		behavior = MILITIA_OFFENSIVE

		[Inventory]
		actor_ids = boneweaver
		count = 4

		[Inventory]
		actor_ids = bonearcher
		count = 8
	}

	[DetectionComponent]
	detection_range = 26

	[EconomyComponent]
	{
		[Cost]
		gold = 180 ;; from 3 * 60

		[Production]
		wood = 4 ;; from 2/3 * 6
	}

	[SupplyComponent]
	supply_range = 13
}
