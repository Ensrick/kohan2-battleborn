		[Organization]
		organization_ids = militia_bonearcher
		behavior = MILITIA_OFFENSIVE

		[Inventory]
		actor_ids = boneweaver
		count = 4

		[Inventory]
		actor_ids = bonearcher
		count = 8
	}

	[DetectionComponent]
	detection_range = 26

	[EconomyComponent]
	{
		[Cost]
		gold = 240 ;; from 3 * 80

		[Production]
		wood = 7 ;; from 2/3 * 11, rounded down
	}

	[SupplyComponent]
	supply_range = 13
}
