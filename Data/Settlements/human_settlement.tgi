
/* 	WALL SETS		*/

[WallSet Template=WallSet]
{
	ids = human_wallset_01
	name = "#human_settlement_human_wallset_01_name"

	wall_segment_ids = human_wall_01
	wall_corner_ids = human_tower_01
	gate_ids = human_gate_01
}

[WallSet Template=WallSet]
{
	ids = human_wallset_02
	name = "#human_settlement_human_wallset_02_name"

	wall_segment_ids = human_wall_02
	wall_corner_ids = human_tower_02
	gate_ids = human_gate_02
}

[WallSet Template=WallSet]
{
	ids = human_wallset_03
	name = "#human_settlement_human_wallset_03_name"

	wall_segment_ids = human_wall_03
	wall_corner_ids = human_tower_03
	gate_ids = human_gate_03
}

/* 	WALL PLACEHOLDERS		*/

[Thing Template=VFXProjectedTexture]
{
	ids = human_wall_placeholder_vfx
	name = "#human_settlement_human_wall_placeholder_vfx_name"

	texture = /Effects/Decals/Human/HumanWallVillageDecal.dds
	attached_scale = 0
	texture_size = 6

	decal_fade_time = 5, 5
}

[Thing Template=K2WallPlaceholder]
{
	IDS = human_wall_placeholder
	name = "#human_settlement_human_wall_placeholder_name"
	
	[View]
	{
		[WhenCreated Template=FXC_CreateVFX]
		vfx_ids = human_wall_placeholder_vfx
	}
}

[Thing Template=VFXProjectedTexture]
{
	ids = human_corner_placeholder_vfx
	name = "#human_settlement_human_corner_placeholder_vfx_name"

	texture = /Effects/Decals/Human/HumanCornerVillageDecal.dds
	attached_scale = 0
	texture_size = 6

	decal_fade_time = 5, 5
}

[Thing Template=K2WallPlaceholder]
{
	IDS = human_corner_placeholder
	name = "#human_settlement_human_corner_placeholder_name"

	[View]
	{
		[WhenCreated Template=FXC_CreateVFX]
		vfx_ids = human_corner_placeholder_vfx
	}
}

[Thing Template=VFXProjectedTexture]
{
	ids = human_gate_placeholder_vfx
	name = "#human_settlement_human_gate_placeholder_vfx_name"

	texture = /Effects/Decals/Human/HumanGateVillageDecal.dds
	attached_scale = 0
	texture_size = 6

	decal_fade_time = 5, 5
}

[Thing Template=K2WallPlaceholder]
{
	IDS = human_gate_placeholder
	name = "#human_settlement_human_gate_placeholder_name"
	
	[View]
	{
		[WhenCreated Template=FXC_CreateVFX]
		vfx_ids = human_gate_placeholder_vfx
	}
}

/* 	SETTLEMENT		*/

[Thing Template=K2Settlement]
{
	ids = human_settlement
	name = "#human_settlement_Thing_name"

	[PropertiesComponent]
	{
		[Property]
		property_IDS = settlement
		
		[Property]
		property_IDS = settlement_human
		
		[Property]
		property_IDS = settlement_notshadow

		[Property]
		property_IDS = good

		[Property]
		property_IDS = evil
	}

	[SettlementComponent]
	{
		default_layout_ids = company_standard

		[AvailableStructures]
		{
			[Structure]
			structure_ids = human_quarry
		
			[Structure]
			structure_ids = human_woodmill
			
			[Structure]
			structure_ids = human_blacksmith
			
			[Structure]
			structure_ids = human_market

			[Structure]
			structure_ids = human_barracks
			
			[Structure]
			structure_ids = human_shrine
			
			[Structure]
			structure_ids = human_library
		}

		[Levels]
		{
			[Level]
			max_structures = 7
			settlement_center_ids = human_center_village
			wallset_ids = human_wallset_01

			[Level]
			max_structures = 7
			settlement_center_ids = human_center_town
			wallset_ids = human_wallset_01
			
			[Level]
			max_structures = 7
			settlement_center_ids = human_center_city
			wallset_ids = human_wallset_02

			[Level]
			max_structures = 7
			settlement_center_ids = human_center_citadel
			wallset_ids = human_wallset_03
		}

		[Placeholders]
		wall_segment_placeholder_ids = human_wall_placeholder
		wall_corner_placeholder_ids = human_corner_placeholder
		gate_placeholder_ids = human_gate_placeholder

		[Shape]
		wall_diameter = 40
		num_wall_sides = 4
		num_wall_gates = 4

		[StructureLayouts]
		{
			[Layout]
			layout_ids = human_layout_01
			
			[Layout]
			layout_ids = human_layout_02
			
			[Layout]
			layout_ids = human_layout_03
			
			[Layout]
			layout_ids = human_layout_04
		}
	}
}
