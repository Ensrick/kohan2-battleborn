[OrganizationLayout template=K2OrganizationLayout]
{
	IDS = company_militia
	name = "#company_militia_name"
	
	[Slot template=LayoutSlot]
	property_IDS = front
	locked = true
	number = 4
	name = "#company_militia_Slot_name"

	[Slot template=LayoutSlot]
	property_IDS = support
	required = false
	number = 1
	name = "#company_militia_Slot_name_2"

	[Formation]
	{
		formation_IDS = company_combat
		
		[Position template=FormationPosition]
		property_IDS = front
		offset = -3.75,+3

		[Position template=FormationPosition]
		property_IDS = front
		offset = -1.25,+3
		
		[Position template=FormationPosition]
		property_IDS = front
		offset = +1.25,+3

		[Position template=FormationPosition]
		property_IDS = front
		offset = +3.75,+3

		[Position template=FormationPosition]
		property_IDS = support
		offset = 0,-0
	}
}

