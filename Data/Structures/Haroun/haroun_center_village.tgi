		behavior = MILITIA_OFFENSIVE

		[Organization]
		organization_ids = militia_mistrunner
		behavior = MILITIA_DEFENSIVE

		[Inventory]
		actor_ids = rainbringer
		count = 16 ;; 8

		[Inventory]
		actor_ids = mistrunner
		count = 18 ;; 6
	}
		
	[DetectionComponent]	
	detection_range = 40

	[EconomyComponent]
	{
		[Cost]
		gold = 625 ;; 125

		[Production]
		gold = 12
		wood = 1
		unit_limit_provided = 7 ;; 2
	}

	[SupplyComponent]
	supply_range = 40
	
	[Stance template=Stance]
	{
		ids = construction
		aspect_ids = null
		property_ids = haroun_village_autoheal
		
		health = 1.0
		actor_state = construction
	}	
